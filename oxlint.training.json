{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "jest"],
  "categories": { "correctness": "error" },
  "rules": {
    "no-debugger": "error",
    "no-constant-condition": "error",
    "no-unused-vars": "error",
    "jest/no-focused-tests": "error",
    "jest/no-disabled-tests": "error",
    "no-restricted-imports": ["error", { "patterns": ["@chess-coach/starchess-arena", "@chess-coach/starchess-arena/*", "@chess-coach/starchess-training", "@chess-coach/starchess-training/*"] }]
  },
  "overrides": [
    {
      "files": ["apps/arena/engine/planning.ts", "apps/arena/engine/wire-v2.ts", "apps/arena/engine/economic-wire.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": ["@chess-coach/starchess-core"],
          "patterns": ["node:*", "./session", "./replay", "./admission", "./fixtures", "./economic-replay*", "./economic-project*", "./worker*", "../*", "@chess-coach/starchess-arena", "@chess-coach/starchess-arena/*", "@chess-coach/starchess-training", "@chess-coach/starchess-training/*"]
        }]
      }
    }
  ]
}
