@startuml resolve-pipeline
' SPEC: _spec/apps/starchess/core/turn/resolve-pipeline.puml
' purpose: Pipeline — classical C phases; pure domain; no UI, no queue mutate.
!include ../../../../themes/proveo.puml

skinparam packageStyle rectangle
skinparam defaultTextAlignment left

title StarChess · Resolve pipeline (plan)

package "Facade in" {
  component "submit-turn\nrank C call" as SUB <<app>>
}

package "Pipeline phases" {
  component "resolve/resolve-turn.ts" as RT <<app>>
  component "Attack phase\nvisible targets → death → occupy" as ATK <<app>>
  component "Move phase\ncollisions · same-square race · mines" as MOV <<app>>
  component "Path-reveal phase\nfog approach shots" as PRV <<app>>
}

package "Board queries (read during resolve)" {
  component "board/mines.ts\ncaps · path contact · rays" as MN <<db>>
  component "board/vision.ts\npathRevealSteps" as VIS <<db>>
  component "board/placement.ts" as PL <<db>>
}

SUB ARROW_MAIN RT : resolveTurn(white, black)
RT ARROW_MAIN ATK
ATK ARROW_MAIN MOV
MOV ARROW_MAIN PRV
ATK ARROW_OPTIONAL PL
MOV ARROW_OPTIONAL MN : contact / trigger
MOV ARROW_OPTIONAL PL
PRV ARROW_OPTIONAL VIS : reveal steps
PRV ARROW_OPTIONAL PL

note bottom
  **Pattern:** Pipeline (ordered domain phases).
  **Allowed:** submit-turn → resolve-turn only.
  **Forbidden:** timeline / input / overlays calling resolve-turn.
  **Forbidden:** pipeline mutating Q: (read intent already stamped by facade).
  Activity detail: ""_spec/packages/starchess-core/resolve.puml"".
end note
@enduml
