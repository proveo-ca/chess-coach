@startuml opponent-strategy
' SPEC: _spec/apps/starchess/core/adjutant/opponent-strategy.puml
' purpose: Strategy — full-turn plan search; commits only through addScAction.
!include ../../../../themes/proveo.puml

skinparam packageStyle rectangle
skinparam defaultTextAlignment left

title StarChess · Opponent strategy (plan)

package "App trigger" {
  component "BaseScreen / MatchStore\nautoQueueOpponent" as TRIG <<host>>
}

package "Strategy" {
  component "ai/adjutant.ts\nplan search · scoring" as AI <<app>>
}

package "Reads" {
  component "board-queries\nvision · moves · mines · adjacent" as BQ <<db>>
}

package "Command (same as human)" {
  component "addScAction\nqueue-action + validation" as Q <<async>>
}

package "Document" {
  database "ScFenSnapshot Q:" as SNAP <<db>>
}

TRIG ARROW_MAIN AI : snap in (opposite side)
AI ARROW_OPTIONAL BQ : evaluate candidates
AI ARROW_MAIN Q : commit chosen plan
Q ARROW_MAIN SNAP : gated write
TRIG ARROW_OPTIONAL SNAP : APPLY_SNAPSHOT / store merge\n(one clock — no bypass reduce rules)

note bottom
  **Pattern:** Strategy → Command.
  **Allowed:** adjutant → addScAction (same gates as human).
  **Forbidden:** adjutant → resolve-turn or raw Q: string edits.
  **Forbidden:** a second legality stack in the app for AI moves.
end note
@enduml
