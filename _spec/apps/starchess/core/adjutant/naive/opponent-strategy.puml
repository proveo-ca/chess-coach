' purpose: Naive script layering and shared deployment composition with native C admission.
' covers: packages/starchess-core/src/ai/adjutant.ts
' covers: packages/starchess-core/src/ai/context/**
' covers: packages/starchess-core/src/ai/strategies/**
' covers: packages/starchess-core/src/ai/plans/**
' covers: packages/starchess-core/src/ai/strategic/orchestrator.ts
' covers: packages/starchess-core/src/__tests__/strategic/deployLegality.test.ts
' covers: packages/starchess-core/src/__tests__/strategic/witness.test.ts
' see also: ../cc-focus.puml (the omniscience contract, decided)
' see also: ../weight-ladder.puml (every naive weight and its tier)
' see also: _spec/packages/starchess-core/deploy-reach.puml (undefended)
' see also: ../strategic/strategic-economy.puml (shared Mecha gate, fog-gated twin)
' related: _spec/packages/starchess-core/sc-moves.puml
' related: _spec/packages/starchess-core/scfen-queue.puml
' related: ../strategic/strategic-architecture.puml
' related: ../strategic/promotion-defense.puml
' authority: accepted v3 in _spec/_plans/ml-adjutant-r3-native-classical-shape-fix.md
' FK: note bottom of AI 10.2; N_CHARON 12.5; N_CHARON_PAIR 10.5; N_OMNI 10.2; N_OMNI_GATE 12.0; N_UNDEFENDED 12.3.
' FK: N_LAYER 11.2; N_BISHOP_CAPS 12.5; N_BISHOP_TAKE 12.0; N_STALE 11.9; N_NEWBORN 11.1; N_COMMIT 12.5.
@startuml opponent-strategy-naive
!include ../../../../../themes/proveo.puml

skinparam packageStyle rectangle
skinparam defaultTextAlignment left

title StarChess · Adjutant difficulty: ADJUTANT (SCRIPT NAIVE) — opponent strategy (plan)

package "App trigger" {
  component "BaseScreen / MatchStore\nautoQueueOpponent" as TRIG <<host>>
}

package "Strategy" {
  component "ai/adjutant.ts\norchestrator only" as AI <<app>>

  package "ai/context" {
    component "buildAdjutantCtx\nSCFEN → input variables" as CTX <<app>>
    component "vision · kingIntel · tactical\nmaterial · mines · pawns · geometry" as CTXP <<app>>
    component "posture\nexpand / seek / hunt → weights" as POST <<app>>
  }

  package "ai/strategies" {
    component "checks" as S1 <<app>>
    component "captures" as S2 <<app>>
    component "threats" as S3 <<app>>
    component "survival" as S4 <<app>>
    component "mapControl\n(+ promotion)" as S5 <<app>>
    component "economy\n(deploy mix)" as S6 <<app>>
  }

  package "ai/plans" {
    component "stacks\nB+C + C+F (charonForwardStacks)" as PL <<app>>
    component "simulate\nclearsCheck guard" as SIM <<app>>
  }
}

package "Reads" {
  component "board-queries\nvision · moves · mines · adjacent" as BQ <<db>>
  component "board/deploy-reach.ts\ndeployCovers — is it really undefended?" as DR <<db>>
  component "board/mine-contact.ts\nhostileMineOn — never step on a mine" as MC <<db>>
}

package "Command (same as human)" {
  component "addScAction\nqueue-action + validation" as Q <<async>>
}

package "Document" {
  database "ScFenSnapshot Q:" as SNAP <<db>>
}

TRIG ARROW_MAIN AI : snap in (opposite side)
AI ARROW_MAIN CTX : build once per turn
CTX ARROW_OPTIONAL CTXP : derive intel
CTX ARROW_OPTIONAL POST : resolve posture → weights
CTXP ARROW_OPTIONAL BQ : evaluate board
AI ARROW_MAIN S5 : generate + score\n(ctx read-only)
S5 -[hidden]- S1
AI ARROW_MAIN PL : compose B+C packages
AI ARROW_MAIN SIM : guard every plan
AI ARROW_MAIN Q : commit chosen plan
Q ARROW_MAIN SNAP : gated write
TRIG ARROW_OPTIONAL SNAP : APPLY_SNAPSHOT / store merge\n(one clock — no bypass reduce rules)

note bottom of AI
  Commands validate both human and script
  plans instead of an independent AI rule set.
  Strategies read context and posture weights,
  while simulation and ranking remain in plans.
end note
note as N_CHARON
  Charon uses immediate B attacks when
  enemy gas income cannot fund a tactical jump.
  Otherwise F predicts the top three mirrored
  warp targets, with diagonal verification
  and native strike validation retained.
end note
S2 .. N_CHARON
note as N_CHARON_PAIR
  F Charon compositions exclude moves that
  relocate the Mecha or screen its firing ray.
  The Strategic twin uses the same composition
  modes, rather than a separate legality stack.
end note
PL .. N_CHARON_PAIR

note as N_OMNI
  Naive CC bonuses use the real enemy square,
  even when the current viewer cannot see it.
  Strategic scoring owns fog-honest estimates,
  so the weaker script keeps its deliberate
  omniscience contract.
end note
note as N_OMNI_GATE
  Only attackCC and chaseCC test enemy
  CC visibility before adding their weights.
  Hunt already requires the CC in view,
  but those local gates preserve the intended
  sight dependency for each scoring term.
end note
AI .. N_OMNI_GATE

note as N_UNDEFENDED
  Post-move deployment defence includes
  the enemy's gas income and mineral bank.
  A Marine reachable by Command Center
  replacement cannot receive the undefended
  capture bonus merely because it looks free.
end note
note as N_LAYER
  Deployment defence moved below both script
  layers into the shared board query module.
  Naive context leaves winning unspecified,
  instead of importing Strategic context
  or probing a foreign layer's type.
end note
DR .. N_LAYER

AI .. N_OMNI
S2 .. N_UNDEFENDED
S2 ARROW_OPTIONAL DR : deployCovers (POST-move, enemy)
S4 ARROW_OPTIONAL MC : never jump onto a mine
S5 ARROW_OPTIONAL MC : never drop / step onto a mine

note as N_BISHOP_CAPS
  Mecha capacity remains four units overall
  and two per square colour, with a1 dark.
  Crush replacement discounts the existing ally,
  so surviving material does not include
  both predecessor and replacement.
end note

note as N_BISHOP_TAKE
  The per-colour exception counts a visible
  enemy queen or Tank crush or classical take.
  Minor victims and Charon do not satisfy
  this replacement-repayment predicate,
  and the total cap remains absolute.
end note

S6 .. N_BISHOP_CAPS
S6 .. N_BISHOP_TAKE
note as N_STALE
  B deployment excludes old move partners
  originating or landing on its birth square.
  This filter applies even when replacement
  types share geometry, because old scoring
  does not establish newborn provenance.
end note
PL .. N_STALE
note as N_NEWBORN
  Newborn captures are generated after the
  planning map replaces the old occupant.
  Unrelated moves and old-actor C before F
  remain supported, rather than broadening
  the stale B-origin exclusion.
end note
PL .. N_NEWBORN
note as N_COMMIT
  Native admission validates each plan
  after stale composition has been filtered.
  Newborn geometry and seed 7's legal plan
  are controls, not proof of historical policy
  selection or polluted user data.
end note
Q .. N_COMMIT
@enduml
