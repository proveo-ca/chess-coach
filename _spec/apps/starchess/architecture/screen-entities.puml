@startuml screen-entities
' SPEC: _spec/apps/starchess/architecture/screen-entities.puml
' purpose: Current-state class composition — SPA routes / demos → board hosts (post P3).
!include ../../../themes/proveo.puml

skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam classAttributeIconSize 0
hide empty members

title StarChess · Screen / demo entities → board hosts\n(post P3 MatchBoardHost)

package "SPA routes" {

  class SingleScreen <<app>>
  class ReviewScreen <<app>>
  class TutorialScreen <<app>>

}

package "live hosts" {

  class LiveMatchShell <<host>>
  class BaseScreen <<app>> {
    LiveChrome assembler
    visionMode = 'player'
  }

  class VermeerLiveScreen <<app>>
  class KingHuntLiveScreen <<app>>
  class FogLiveScenarioScreen <<app>>
  class GasDeployScenarioScreen <<app>>

}

package "review hosts" {

  class ReviewDemoScreen <<app>> {
    DualNavChrome assembler
  }

  class TutorialReviewHost <<app>> {
    TypewriterChrome assembler
  }

  class CombatChainDemo <<app>>
  class KingHuntDemo <<app>>
  class FogEdgeDemo <<app>>

}

package "board structure (P3)" {

  class MatchBoardHost <<host>> {
    compound: BoardColumn · BoardHost · Rail
  }

  class LiveBoardBinding <<app>> {
    sole LiveStarChessBoard mount
  }

  class LiveStarChessBoard <<app>>
  class AnimationStage <<app>>
  class StarChessBoard <<app>>

}

package "missing" {
  class LiveMultiScreen <<error>> {
    live/multi — ABSENT
  }
}

SingleScreen *-- LiveMatchShell
ReviewScreen *-- LiveMatchShell
TutorialScreen *-- LiveMatchShell
SingleScreen *-- BaseScreen
ReviewScreen *-- ReviewDemoScreen
TutorialScreen *-- FogLiveScenarioScreen
TutorialScreen *-- GasDeployScenarioScreen
TutorialScreen *-- TutorialReviewHost
TutorialScreen *-- KingHuntLiveScreen

VermeerLiveScreen *-- BaseScreen
KingHuntLiveScreen *-- BaseScreen
FogLiveScenarioScreen *-- BaseScreen
GasDeployScenarioScreen *-- BaseScreen

CombatChainDemo *-- ReviewDemoScreen
KingHuntDemo *-- ReviewDemoScreen
FogEdgeDemo *-- ReviewDemoScreen

BaseScreen *-- MatchBoardHost
ReviewDemoScreen *-- MatchBoardHost
TutorialReviewHost *-- MatchBoardHost
MatchBoardHost *-- LiveBoardBinding
LiveBoardBinding *-- LiveStarChessBoard
LiveStarChessBoard *-- AnimationStage
AnimationStage *-- StarChessBoard

note as ModeMatrix
  **Mode matrix (unchanged behavior)**
  | live/* | BaseScreen → MatchBoardHost → LiveBoardBinding | player fog |
  | review/* | ReviewDemo / TutorialReviewHost → MatchBoardHost | prop-driven / observer |
  | live/multi | ABSENT |
end note

@enduml
