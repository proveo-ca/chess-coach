@startuml demos
' SPEC: _spec/apps/ui/starchess/demos.puml
' purpose: Canonical demos, shipped vs pending, verify commands.
!include ../../../themes/proveo.puml

skinparam packageStyle rectangle
skinparam defaultTextAlignment left

title StarChess · Canonical Demos, Shipped vs Pending

package "Canonical demos" {
  component "Combat Chain\nstory: screens-nerd-star-chess-demo--combat-chain\nW & B per turn; attack → death → occupy" as D1 <<app>>
  component "King Hunt\nstory: screens-nerd-starchess-demo--king-hunt\nimplicit legal checks + HP; tank on g6" as D2 <<app>>
  component "King Hunt (live)\nstory: screens-nerd-starchess-demo--king-hunt-live\nstanding Nc5 check; ResourceBar / TurnBar / End;\nbrain breaks off king contact (no HP trade)" as D3 <<app>>
  component "Fog-edge Bishop / Rook tank\nstory: starchess-fog-of-war-and-move-animations--bishop\n(+ King/Pawn/Knight/Queen/Rook tank|siege)\nmove into fog → capture/occupy blocker" as D4 <<app>>
}

package "Shipped (do not re-ticket)" {
  component "Types — ScAction, ScTurnQueue, gas,\nScFenSnapshot.queue\n""src/types/starchess.ts""" as SH1 <<app>>
  component "SCFEN parse/format — G: Q: U: M: S: H:\n""src/starchess/scfen.ts""" as SH2 <<app>>
  component "Queue actions — addScAction / addScMove /\nendScTurn\n""scActions.ts"" + ""endScTurn.ts""" as SH3 <<app>>
  component "Fog-aware classify + move collision\n""resolveTurn.ts"" + ""vision.ts"" via ""endScTurn""" as SH4 <<app>>
  component "Intent C= vs progressive path resolve\n""pathRevealSteps"" / ""pathRevealFrom""\nfog approach = phase-3 event: fires after moves;\nfizzle: attacker dead / origin re-occupied or sieged,\nor ""to"" lost the in-the-way victim\n""pathRevealAttacks"" = fired only" as SH5 <<app>>
  component "King-shot ray / legal check\n""collectLegalKingChecks"" +\n""beginScTurn"" / ""applyPendingKingShots""\nat turn open (before intent);\nkings are legal checkers too" as SH6 <<app>>
  component "Implicit check → turn-open HP\n(""beginScTurn""); mid-resolve king HP only\nfog path-discovery; no king-aimed ""C=""" as SH7 <<app>>
  component "Spider Mines M:\n""mines.ts"" + ""resolveTurn""" as SH8 <<app>>
  component "Fog-edge DualNav\n""demos/fogEdge*.ts"" + ""FogEdgeDemo""\n(+ fogMoveSamples · FogOfWar stories)\nDualNav review demos (NerdCombat, PathCollide,\nPathCollideAllyMine, AttackMine, KingHunt): both\nplayers' intent overlays pre-resolve\n(""intentOverlays.ts"", no viewer);\nKing Hunt: **check → intent → resolve**;\nobserver dual-vision borders\n(""visionMode=observer"" — full board +\n""getSideVision"" w/b strokes, no fog veil);\nFog-of-war move stories use player fog veil" as SH9 <<app>>
  component "Sieged rook immobile S:\n""scValidate"" + ""endScTurn"" toggle" as SH10 <<app>>
  component "King duel — adjacent kings fight\nface-to-face: mutual 1 HP/turn, parting shot,\ndeploy doubling, 0/0 = draw, phase O absorbing\n""board.ts"" + ""resolveTurn"" + ""scOutcome.ts""\ntests: ""__tests__/kingDuel.test.ts""" as SH11 <<app>>
  component "Intent overlay rings **both** kings\nwhen they are in contact\n""intentOverlays.ts""" as SH12 <<app>>
  component "Adjutant lockstep — an adjacent enemy king\nis a real threat; the adjutant breaks off\ncontact rather than trading HP\n""demos/adjutant.ts""" as SH13 <<app>>
}

package "Pending" {
  component "History serializer — optional\n""C=a1a8>xa5"" for finished plies" as PD1 <<app>>
  component "Draw / win banner for StarChess —\n""GameOverBanner"" is still suppressed in\n""StarChessBoardView.tsx"", so a draw has no banner" as PD2 <<app>>
  component "Unused field ""StarChessState.winner""\n(""types.ts"") — outcome is derived by ""scOutcome""" as PD3 <<app>>
  component "No classical-UI path into king adjacency —\nchess.js forbids it; contact arises via specials,\nauthored SCFEN, mutual approach, or AI" as PD4 <<app>>
}

note bottom
  **Verify:**
  ""cd apps/ui && npm run lint""
  ""cd apps/ui && npm run test:int -- tests/starchess""
  (""tests/starchess"" is the doc's filter; the suite lives under
  ""src/starchess/__tests__/"" — ""npm run test:int -- src/starchess"" runs it.)
  **King duel rules:** resolve.puml. The Pending entries above are known
  gaps, **not** shipped behaviour — a StarChess draw currently ends the
  game silently (phase ""O"", no banner).
end note
@enduml
