@startuml index
' SPEC: _spec/apps/ui/starchess/index.puml
' OUTDATED: Phase 5–6 cutover — live ownership moved; keep as historical map.
' purpose: Historical map of the StarChess spec set (pre-cutover module names).
!include ../../../themes/proveo.puml

skinparam packageStyle rectangle
skinparam defaultTextAlignment left

title OUTDATED — StarChess · Spec Map (_spec/apps/ui/starchess)

package "_spec/apps/ui/starchess" {
  component "scfen-wire.puml\nSCFEN string + field roles" as WIRE <<db>>
  component "scfen-queue.puml\nQueue ABNF + shape + order" as QUEUE <<async>>
  component "resolve.puml\n3 phases: attack → move → fog approach" as RESOLVE <<app>>
  component "turn-queue-sequence.puml\nSimultaneous turn queue" as SEQ <<async>>
  component "starchess-mode.puml\nProduct / UX + economy" as MODE <<app>>
  component "demos.puml\nCanonical demos + shipped/pending" as DEMOS <<app>>
  component "sc-moves.puml\nSC-native classical movegen + provider seam" as MOVES <<app>>
}

package "historical module names\n(was apps/ui/src/starchess)" {
  component "scfen.ts\nSCFEN parse / format" as TSCFEN <<app>>
  component "scActions.ts\naddScAction / addScMove" as ACT <<app>>
  component "endScTurn.ts\nresolve planning snap" as END <<app>>
  component "resolveTurn.ts\nclassical attack + move + fog approach" as RT <<app>>
  component "board.ts\nlegal king-checks + piece geometry" as BRD <<app>>
  component "scMoves.ts\nSC classical legality" as SCM <<app>>
  component "scOutcome.ts\nterminal outcome from kingLives" as OUT <<app>>
  component "vision.ts\ncumulative fog" as VIS <<db>>
  component "mines.ts\nspider mines" as MIN <<app>>
}

WIRE ARROW_OPTIONAL TSCFEN : documents
QUEUE ARROW_OPTIONAL ACT : documents
RESOLVE ARROW_OPTIONAL END : documents
RESOLVE ARROW_OPTIONAL RT : documents
RESOLVE ARROW_OPTIONAL BRD : documents
RESOLVE ARROW_OPTIONAL OUT : documents
RESOLVE ARROW_OPTIONAL VIS : documents
RESOLVE ARROW_OPTIONAL MIN : documents
MODE ARROW_OPTIONAL END : documents
MODE ARROW_OPTIONAL ACT : documents
DEMOS ARROW_OPTIONAL WIRE : covers
DEMOS ARROW_OPTIONAL RESOLVE : covers
DEMOS ARROW_OPTIONAL MODE : covers
MOVES ARROW_OPTIONAL SCM : documents
MOVES ARROW_OPTIONAL BRD : documents

note bottom
  **OUTDATED after Phase 5–6.** ""apps/ui/src/starchess"" is **deleted**.
  **Live ownership:** rules → ""packages/starchess-core"";
  standalone UI/PWA → ""apps/starchess"" (served at ""/starchess/"");
  Coach keeps ""apps/ui/src/features/nerd"" + ""StarChessRedirect"".
  **Deployment (live):** ""_spec/apps/starchess/deployment.puml"".
  ----
  Historical: contents carried over from ""STARCHESS_FEN.md"" /
  ""STARCHESS_MODE.md"". Module boxes above use pre-cutover names;
  backlinks from core/app sources still point here until specs are
  rewritten under ""_spec/packages/starchess-core"" / ""_spec/apps/starchess"".
end note
@enduml
