@startuml ui-responsiveness-layout
' SPEC: _spec/apps/ui/responsiveness/layout.puml
!includeurl https://raw.githubusercontent.com/proveo-ca/identity/refs/heads/main/proveo.iuml

skinparam defaultTextAlignment left
skinparam shadowing false
skinparam backgroundColor #FEFEFE
skinparam handwritten false

title UI Responsiveness · Root grid priority\n(Screen / .app-container)

rectangle "**viewport**\n(no page vertical scroll · min width ≥ board+sideboard)" as VP {

  rectangle "**TOP — priority 2**\nScreen.Header / SidebarInset\navatar · FEN · titles" as TOP #E8F0FE
  rectangle "**MIDDLE — priority 1 (essentials)**\nScreen.BoardArea\nChessboard + Sidebar / MobileSidebar" as MID #D4EDDA
  rectangle "**BOTTOM — priority 3**\nScreen.Footer\nCoachPanel · move list\n→ floats when forced off-screen" as BOT #F8D7DA

}

TOP -[hidden]-> MID
MID -[hidden]-> BOT

note right of MID
  ChessBoard (+ sideboard) ONLY —
  no captures / bars / FEN.
  Never shrink below --board-size.
  Mobile board screens:
  leftover → top + bottom 1fr;
  top flex-end · bottom flex-start.
  List (no board-column):
  middle stays 1fr for scroll.
end note

note right of BOT
  Short height:
  dismissible floating messages
  max-height = 50% CoachAvatar
  appear instantly
  auto-dismiss on move
  (CoachPanel · shipped)
end note

note bottom of VP
  Avatar: tall mobile = hero floats over MobileBanner;
  short / dynamic = compact in bar (≤ 50% overlap)
  may sit below Chessboard top edge (Coach mobile).
end note

@enduml
