}
package "Native baseline" {
  component "apps/arena/src/cli.rs\nMatchSpec / SuiteSpec / record inputs\nrun stdout / suite fresh private outputs" as CLI <<host>>
  component "apps/arena/src/schedule.rs\narena-schedule-v1 / <=64 cases\nrepeat -> fixture -> pairing" as SCHEDULE <<app>>
  component "apps/arena/src/run.rs\n<=45 planning windows / both seats\npass-v1 / first-v1 / seeded-v1" as RUN <<app>>
  component "training_native::candidates / policy\nRust profile-B composition + selectors\nno learned model or R4 feature encoder" as BASELINE <<app>>
  component "apps/arena/src/engine_v2.rs\nfixed worker / cwd apps/arena\nabsolute match + decision deadlines" as CLIENT <<host>>
  component "engine/worker-v2.ts + wire-v2.ts\narena-engine-v2 / bounded UTF-8 NDJSON\nstrictly increasing u32 request IDs" as WORKER <<host>>
  component "engine/planning.ts\nplan.open / next / close\nauthorized views + pure native helpers" as PLANNER <<app>>
  component "engine/fixtures.ts\ntiny-v1 / standard-v1 / all-actors-v1\nnative-validated fixed SCFEN" as FIXTURES <<app>>
  component "engine/session.ts\nprivate engine / retained bank\nsession.start / open / commit / close" as SESSION <<app>>
  component "apps/arena/src/record.rs\narena-run-v1 / host-only truth\narena-policy-seeds-v1\nNON_ADMITTED / learned=false\nmodelArtifact=null / fullRunner=true" as RECORD <<app>>
  component "apps/arena/src/replay.rs\nregenerate views / seeds / decisions\nprivate-field VerifiedRun" as REPLAY <<app>>
