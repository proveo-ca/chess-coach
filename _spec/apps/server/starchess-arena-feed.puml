@startuml starchess-arena-feed
' SPEC: _spec/apps/server/starchess-arena-feed.puml
' purpose: NODE SERVICE (Bun) — stockfish feed for the arena; the adjutant runs outside the browser.
' status: PLANNED — anchors to apps/server/src/feed/** + routes on implementation.
!include ../../themes/proveo.puml

skinparam packageStyle rectangle
skinparam defaultTextAlignment left

title StarChess · Node service — stockfish feed for the script arena

package "packages/starchess-arena (pure)" {
  component "runMatch\nheadless runner" as ARENA <<app>>
}

package "apps/server (Bun)" {
  component "app.ts / http.ts router\ncors + validation" as ROUTER <<app>>
  component "StarChessFeed\nimplements EngineFeed" as FEED <<app>>
  component "StarChessEnginePool\nN procs · serial" as POOL <<app>>
  component "record store\nJSONL / bun:sqlite" as STORE <<db>>
}

package "callers" {
  component "web app / cli\nreplay · scoreboard · runs" as CALL <<app>>
}

package "packages/starchess-core (shared)" {
  component "replay/fen.ts\nSCFEN→FEN projector" as PROJ <<app>>
}

package "orchestration (as today)" {
  component "StockfishEngine\ngetEvaluation(fen, depth|movetime)" as SF <<app>>
  component "UciDriver\nBun.spawn · readUntil timeout" as UCI <<app>>
}

cloud "native stockfish\nbinary" as FISH <<cloud>>

CALL ARROW_MAIN ROUTER : POST /starchess/arena/runs · GET /games, /games/:id
ROUTER ARROW_MAIN ARENA : invoke runMatch (pool-bounded)
ROUTER ARROW_MAIN FEED : batch candidate projections
FEED ARROW_MAIN PROJ : ScFenSnapshot → FEN (lossy, classical-only)
FEED ARROW_MAIN POOL : position fen … ; go movetime N
POOL ARROW_MAIN SF
SF ARROW_MAIN UCI
UCI ARROW_CLOUD FISH : spawn + uci handshake
FISH ARROW_CLOUD UCI : score cp / score mate
FEED ARROW_OPTIONAL ROUTER : evals {cp, mate} or timedOut
ROUTER ARROW_MAIN STORE : persist ArenaGameRecord
ARENA ARROW_OPTIONAL STORE : read records (replay scoreboard)

note bottom
  **Why the feed is the hard part:** stockfish is a native child process
  (""Bun.spawn"" + UCI); the arena core must stay DOM/worker-free, so the
  boundary is an interface: ""EngineFeed.evaluate(items, {movetimeMs})"".
  The app's browser worker ""UciDriver"" is NOT reused here — the bun
  ""UciDriver"" (splice-on-timeout) already exists for Chess Coach; the feed
  is a thin StarChess adapter over it.
  **movetime:** a parameterized ""StockfishEngine.getEvaluation(fen,
  {depth?|movetimeMs?})"" — today's method hardcodes ""go depth 15"".
  **Queue hygiene:** splice-on-timeout does not clear ""UciDriver""'s line
  queue — a timed-out query's late ""bestmove"" would be misattributed to the
  next candidate. The feed drains the queue between queries.
  **Legality guard:** the core projector flags StarChess-legal-but-classically-
  illegal positions (pawns on rank 1/8 via spawn/pawnDouble) as ineligible;
  the feed skips them instead of burning the timeout.
  **Budgets:** per-query ""movetime"" + absolute ""readUntil"" timeout; on
  overrun the feed returns the evals it has with ""timedOut:true"" and the
  strategic script falls back to its deterministic ranking.
  **CORP:** arena GETs set ""Cross-Origin-Resource-Policy: cross-origin"" or
  the COEP-isolated web app can't read them (ACAO alone insufficient).
  **Legality is never delegated:** stockfish only adjusts candidate scores;
  the core's ""addScAction"" gate stays authoritative.
  **Status:** PLANNED — Phase-2 of the arena plan.
end note
@enduml