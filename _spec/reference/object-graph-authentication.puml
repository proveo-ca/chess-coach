@startuml reference_object_graph_authentication
' purpose: document implemented raw commit/tree authentication, bounded inventory and no-fetch refusal
' covers: packages/runtime/tests/reference-bundles.test.ts
' covers: tooling/reference-entrypoints.json
' covers: packages/runtime/tests/fixtures/reference-sources.json
' status: SOURCE_RECONSTRUCTED / VERIFIED_TEST_SUBSETS / SOURCE_REVIEWS_ACCEPTED_SCOPED / trainingReady:false
' evidence: authenticated-git-objects-1 passes 25 tests / 194 assertions; one C14 test filtered; sourceChanged:false
' review: persisted TypeScript security and final adversarial packet-5 source-only verdicts accepted
