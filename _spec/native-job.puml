node "Standard OS/runtime resource envelope\nC2: 4 CPU / 8 GiB / 512 tasks / no extra swap\n2 GiB tmpfs within memory; admission pending" as JOB <<host>> {
  component "Both seats + game producer" as GAME <<app>>
