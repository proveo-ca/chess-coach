' purpose: StarChess script-arena spec map (packages/starchess-arena).
' covers: packages/starchess-arena/src/index.ts
' covers: packages/starchess-arena/src/challenge/**
' covers: packages/starchess-arena/src/challengeContract/**
' covers: scripts/challenge-contract-evidence.ts
' covers: packages/starchess-arena/hermetic/**
' see also: arena.puml (the runner itself)
' related: _spec/_plans/PLAN-ml-adjutant.md
' related: _spec/_plans/ml-adjutant-challenge.md
' related: _spec/_plans/ml-adjutant-weights.md
' legacy rationale: What the arena measures is a spec question, not just a runner question.
' legacy rationale: Scripts live under _spec/apps/starchess/core/adjutant/; omitted per-side inputs change results without changing scripts.
' legacy history: The previous map called out ccIntel forwarding; arena.puml owns that legacy runner concern, not the isolated challenge.
' source pointers: optional corroboration; spec-side covers headers own drift coverage.
' rendering: status edit passed plantuml -checkonly.
@startuml index
!include ../../themes/proveo.puml

skinparam packageStyle rectangle
skinparam defaultTextAlignment left

title StarChess Arena · Spec Map (_spec/packages/starchess-arena)

package "_spec/packages/starchess-arena" {
  component "arena.puml\nheadless match runner" as ARENA <<app>>
  component "ml-adjutant-challenge-harness.puml\nverified non-learned historical baseline" as PHASE1 <<app>>
  component "ml-adjutant-policy-contracts.puml\nhermetic verification passed\nnot learned; post-image review unrecorded" as PHASE2 <<app>>
}

package "packages/starchess-arena/src" {
  component "run/runMatch.ts" as RUN <<app>>
  component "players/{naive,strategic,kvs,ccIntel}.ts" as PL <<app>>
  component "feed/types.ts\nEngineFeed contract" as FEED <<host>>
  component "record/record.ts" as REC <<app>>
  component "compare/compare.ts" as CMP <<app>>
  component "cli/main.ts" as CLI <<app>>
  component "challenge/\nisolated strict challenge host" as CHALLENGE <<host>>
  component "challengeContract/\ncodecs / named features / coverage" as CONTRACT <<app>>
}

component "scripts/challenge-contract-evidence.ts\ncontract and migration diagnostics" as DIAGNOSTIC <<host>>
component "packages/starchess-arena/hermetic\nsource image run passed\npost-image review unrecorded" as HERMETIC <<host>>

package "packages/starchess-core/src (shared)" {
  component "replay/{fen,record}.ts · rules/economy.ts" as CORE <<app>>
}

package "apps/server (Bun)" {
  component "src/arena/*\nStarChessFeed · pool" as FEEDIMPL <<app>>
}

package "apps/starchess" {
  component "replay-import.puml\n?game= / ?scfens= replay" as REPLAY <<app>>
}

ARENA ARROW_MAIN RUN
PHASE1 ARROW_MAIN CHALLENGE
PHASE2 ARROW_MAIN CONTRACT
PHASE2 ARROW_MAIN CHALLENGE : source inventory / pin migration
PHASE2 ARROW_MAIN DIAGNOSTIC
PHASE2 ARROW_MAIN HERMETIC
ARENA ARROW_MAIN PL
ARENA ARROW_MAIN REC
ARENA ARROW_OPTIONAL CMP
ARENA ARROW_MAIN CLI : consumes
PL ARROW_OPTIONAL FEED : implements
REC ARROW_OPTIONAL REPLAY : replayed by
CORE ARROW_MAIN RUN : income · projector · record
FEEDIMPL ARROW_MAIN FEED : implements
CLI ARROW_OPTIONAL FEEDIMPL : --engine runs

note bottom of PHASE2
  v1 features: weights NONE
  Broader v2 FIRST training: PLANNED
  H=1 first; three-window search later
end note
@enduml
