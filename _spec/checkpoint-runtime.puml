!include https://raw.githubusercontent.com/proveo-ca/identity/main/proveo.puml
title SOURCE_AND_REFERENCE_PREPARATION_VERIFIED_HOST_QUALIFICATION_PENDING - C11 campaign

actor "Prepared campaign caller" as CALLER
participant "packages/runtime/src/training-campaign.ts\nTrainingCampaign" as CAMPAIGN
participant "initialRecord(master, timing)\npreprepared CPU Flex record callback" as INIT
participant "packages/runtime/src/training-coordinator.ts\nTrainingCoordinator" as COORD
participant "packages/runtime/src/fixed-attempt.ts\nONE FixedAttemptFactory.create" as FACTORY
participant "packages/runtime/src/match-session.ts\nMatchSession" as MATCH
database "packages/runtime/src/training-store.ts\nprivate SQLite" as STORE

CALLER -> CAMPAIGN : construct with one coordinator, initialRecord, one createOwned
CALLER -> CAMPAIGN : run once; no cap override, resume, or retry
note over CALLER,CAMPAIGN
  observeR4: two composition attempts.
  TrainingCampaign: 5,000 verified attempts.
end note
loop exact serial masters 101..105
  CAMPAIGN -> INIT : initialRecord(master, timing); original initialization10s
  INIT --> CAMPAIGN : selected config/native record; hash and bounds checked
  CAMPAIGN -> COORD : initializeMaster(master, record); within same10s
  COORD -> STORE : bind master seed/model, provenance, persistent streams
  COORD -> COORD : retain initial config/record in first fixed master packet
  COORD --> CAMPAIGN : exact initial state; consistent experiment bindings

  loop exact ordinals 0..999
    CAMPAIGN -> COORD : runAttempt(master, id, original10/297/300s timing, createOwned)
    COORD -> STORE : compute frozen curriculum-A descriptor; commit STARTED/cursors
    STORE --> COORD : owned descriptor/model/RNG/frozen baseline
    COORD -> COORD : retain STARTED in fifty fixed100-slot packets; no failure rollover
    COORD -> FACTORY : createOwned only after durable STARTED
    FACTORY --> COORD : owned transport/learners/verifier/corpus/strategy/releaseInputs

    break dependency acquisition, constructor, or pre-session deadline fails
      COORD -> COORD : terminate acquired dependencies; mark release attempted BEFORE callback
      COORD -> COORD : invoke releaseInputs at most once if dependencies returned
      COORD -> STORE : stopAll; preserve STARTED/known-prefix diagnostics
      COORD --> CAMPAIGN : fail; admit no further attempt or master
      CAMPAIGN -> COORD : close exactly once; retain failure
    end

    COORD -> MATCH : construct and run owned whole-match session
    MATCH -> MATCH : verify ACK prefixes, stop classification, C12 proposal, close/reap
    break session/integrity/lifecycle failure
      COORD -> COORD : retain failed-prefix and failed-session model inputs
      COORD -> STORE : stopAll; no completion, retry, or resume
      COORD --> CAMPAIGN : fail; admit no further attempt or master
      CAMPAIGN -> COORD : close exactly once; retain failure
    end
    MATCH --> COORD : independently verified completion and retained evidence
    COORD -> COORD : mark release attempted BEFORE releaseInputs; check original deadline
    break release or publication failure
      COORD -> STORE : stopAll; preserve known state; never invoke release again
      COORD --> CAMPAIGN : fail; no next attempt or master
      CAMPAIGN -> COORD : close exactly once; retain failure
    end

    alt at least one verified sampled choice
      COORD -> STORE : atomically commit verified native model/baseline/counters/RNG/journal
      opt checkpoint bucket due
        STORE -> STORE : actual-epoch completed checkpoint + fulfilled bucket together
      end
    else zero-choice verified completion
      COORD -> STORE : commit diagnostics/control/streams only; no PG/L2/baseline/checkpoint
    end
    STORE -> STORE : never checkpoint pending gradients
    STORE --> COORD : checked completion; terminal master requires nonzeroPGUpdates>=1
    COORD --> CAMPAIGN : checked state; verify monotone counters/journal/history/bindings
  end
  CAMPAIGN -> CAMPAIGN : require started=verifiedCompleted=1000 and nonzeroPGUpdates>=1
end

CAMPAIGN -> COORD : finalize; original final-phase work297s
COORD -> STORE : finalModels; require all five valid, no pending attempt or abort
STORE --> COORD : selected config/native records only; never export private state to scoring
COORD --> CAMPAIGN : existing bounded artifacts/experiment; primary101
break finalization or artifact validation fails
  CAMPAIGN -> COORD : close exactly once; preserve failure and original final-phase cutoff
  CAMPAIGN --> CALLER : reject; no COMPLETE result or retry
end
CAMPAIGN -> COORD : close exactly once; original final-phase cleanup300s
CAMPAIGN --> CALLER : return only after checked final artifacts and close

note over COORD,MATCH
  Mark the release callback before invocation
  so a throwing cleanup cannot run twice.
  Preserve failed session inputs because
  successful lifecycle verification never
  occurred.
end note

note over COORD,STORE
  Schemas, JSON, and method names cannot prove
  that an episode qualifies for learning.
  Actual storage fit and durability remain
  unqualified by the transaction design.
end note

note over CAMPAIGN,COORD
  Reentry revokes further admissions without
  claiming that an active callback has been
  stopped. Separate phase clocks retain finite
  bounds, not a strict whole campaign
  termination guarantee.
end note
@enduml
