@startuml gate0-checker
!include https://raw.githubusercontent.com/proveo-ca/identity/main/proveo.puml
title Gate0 checker / proposed binding contract / structural review only / Gate0 OPEN
actor Executor as OP
participant "mise.toml\nf9:gate0" as MISE <<host>>
participant "tooling/native-ingress/f9-gate0.mjs\nmain(argv, {output, read})" as CHECK <<app>>
database "Two explicit regular input leaves\nprofile + ledger snapshot" as INPUT <<db>>
participant "checkProfile(Buffer, Buffer, options)\nlocal strict parser + binding checks" as VALIDATE <<app>>
participant "f9-gate0-report-v1\nnoninteractive JSON output" as REPORT <<app>>

OP -> MISE : task invocation; raw_args=true; no dependencies
MISE -> CHECK : Bun --no-env-file --no-install
alt exclusive --plan
  CHECK --> OP : lexical preview / exit0; no helper reads or effects
else no arguments
  CHECK -> REPORT : PROFILE_REQUIRED + frozen required-ID inventory
  REPORT --> OP : BLOCKED / exit2; safe fixed fields only
else --profile ABS --ledger ABS [--finalize]
  CHECK -> CHECK : reject ambiguous/duplicate/unknown arguments
  CHECK -> INPUT : readGate0Input(): exact leaves only; <=1MiB each
  INPUT --> CHECK : O_RDONLY | O_NOFOLLOW | O_NONBLOCK; regular descriptor
  CHECK -> CHECK : initial-size+1 partial reads; stable BigInt metadata; finally attempt close
  CHECK -> CHECK : fixed close refusal; preserve any earlier read/metadata refusal
  note over CHECK, INPUT
    Stable descriptors limit pathname substitution,
    but ancestor aliases remain explicitly allowed.
    These checks bind the bytes read by the checker,
    not protected backing or runtime provenance.
  end note
  CHECK -> VALIDATE : checkProfile(profileBytes, ledgerBytes, {finalize})
  VALIDATE -> VALIDATE : strict UTF-8/JSON; duplicate/forbidden keys and unsafe numbers refuse
  VALIDATE -> VALIDATE : exact integral decimal/exponent tokens; rounded fractions/underflow refuse
  VALIDATE -> VALIDATE : required records/links + exact schema; typed references and declared DAGs
  VALIDATE -> VALIDATE : BFS from required/supporting-row record roots; isolated cycles refuse
  VALIDATE -> VALIDATE : preserve original zero-based declaration indices for later findings
  VALIDATE -> VALIDATE : unique producer/output ownership; all declared inputs consumed
  VALIDATE -> VALIDATE : checked invoice total <=1_048_576; declared physical-role coverage
  VALIDATE -> VALIDATE : canonical profile excluding decisionBindings; separate raw-byte hashes
  VALIDATE -> VALIDATE : unfenced ATX level2: 0..3 leading spaces; separator space/tab or empty ##
  VALIDATE -> VALIDATE : one section8 content prefix; ANY next recognized level2 ends it
  VALIDATE -> VALIDATE : in-place bounded marker collection within that section only
  VALIDATE -> VALIDATE : one marker/binding per required record; excerpts exclude heading
  VALIDATE -> VALIDATE : exact original-byte line excerpts + record/profile/ledger digests
  VALIDATE -> REPORT : mechanical READY_FOR_REVIEW or BLOCKED BEFORE finalize refusal
  opt finalization requested (--finalize)
    VALIDATE -> REPORT : finalization BLOCKED; ACCEPTANCE_PROTOCOL_UNAPPROVED; exit2
  end
  note right of REPORT
    The checker binds exact proposed records to the
    supplied ledger snapshot, not a trusted decision.
    Independent review must establish their truth,
    scope and acceptance before any gate can close.
  end note
  REPORT --> OP : scope OFFLINE_STRUCTURAL_CONSISTENCY_ONLY
  REPORT --> OP : acceptanceProtocol UNAPPROVED; ledgerTrust UNAUTHENTICATED_SNAPSHOT
  REPORT --> OP : closed bounded blockers + nonempty reviewObligations
  REPORT --> OP : Gate0 OPEN; f9Qualified=false; trainingReady=false
  REPORT --> OP : exit0 only for non-finalizing mechanical READY_FOR_REVIEW; otherwise2
end
note over CHECK, VALIDATE
  No refs, sibling scans, subprocesses or network
  No writes, approvals, runtime claims or dispatch
end note
@enduml
