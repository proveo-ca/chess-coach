@startuml game_core
' purpose: canonical primitive ownership and the game-core compatibility boundary
' covers: packages/starchess-core/src/engine/**
' covers: packages/starchess-core/src/model/square.ts
' covers: packages/game-core/src/**
' covers: packages/game-core/tests/compatibility-exports.test.ts
' details: _spec/game-core.md
' consolidation goal: _spec/engine-consolidation.puml
' status: approved target; final source alignment and fresh verification pending
title Canonical primitives · approved shared ownership
component "packages/game-core/src\ncompatibility forwards" as COMPAT <<app>>
component "starchess-core/src/engine/index.ts\npure native facade" as ENGINE <<app>>
component "starchess-core/src/engine/types.ts\nmodel/square.ts" as TYPES <<app>>
component "starchess-core/src/engine/board.ts\nboard placement + attack geometry" as BOARD <<app>>
component "starchess-core/src/engine/economy.ts\nspecial costs + turn clocks" as ECONOMY <<app>>
component "starchess-core/src/engine/outcome.ts" as OUTCOME <<app>>
component "starchess-core/src/engine/moves.ts\nmines.ts / mine-contact.ts" as MOVES <<app>>
component "starchess-core/src/engine/vision.ts\ncumulative fog + path reveals" as VISION <<app>>
component "packages/game-core/tests\nretained primitive regressions" as TESTS <<app>>
COMPAT ..> ENGINE : export forwards only
ENGINE --> BOARD
ENGINE --> ECONOMY
ENGINE --> OUTCOME
ENGINE --> MOVES
ENGINE --> VISION
BOARD --> TYPES
ECONOMY --> TYPES
ECONOMY --> BOARD : deployed material
OUTCOME --> TYPES
MOVES --> BOARD
VISION --> BOARD
TESTS ..> BOARD
TESTS ..> ECONOMY
TESTS ..> OUTCOME
TESTS ..> MOVES
TESTS ..> VISION
note bottom of TESTS
  Old module paths preserve export identity
  instead of keeping a second set of physical
  rules. Product and native admission use distinct
  contracts, but both resolve through the same
  mutation kernel.
end note
@enduml
