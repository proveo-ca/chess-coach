{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": []
  },
  "include": [
    "packages/contracts/src",
    "packages/game-core/src",
    "packages/policy/src",
    "packages/runtime/src",
    "tooling/**/*.ts"
  ]
}
