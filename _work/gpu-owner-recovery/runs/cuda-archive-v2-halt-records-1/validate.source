
import { readFile, readdir } from 'node:fs/promises';
import { createHash } from 'node:crypto';
const base='_work/gpu-owner-recovery/',run=base+'runs/cuda-archive-audit-2/',hash=bytes=>createHash('sha256').update(bytes).digest('hex'),load=async path=>JSON.parse(await readFile(path,'utf8'));
const assert=(condition,code)=>{if(!condition)throw Error(code);};
const canonical=value=>JSON.stringify(value,(_key,item)=>item&&typeof item==='object'&&!Array.isArray(item)?Object.fromEntries(Object.entries(item).sort(([a],[b])=>a.localeCompare(b))):item);
const raw=await readFile(base+'cuda-archive-reviewed-v2.json'),review=JSON.parse(raw),approvedBytes=await readFile(run+'approved-request.json'),approved=JSON.parse(approvedBytes);
assert(hash(raw)==='dacf7e484328711b65f72d48ee6cba4808164fd6ce9ddb7bf3366868486f173c'&&hash(approvedBytes)==='a968cc2761869c8634a3cc929f2b1d21a7804f7128bd1fb6b045f76598fbd9f1'&&review.requestSha256===hash(approvedBytes),'PRE_EXECUTION_REVIEW_REQUEST_PINS');
for(const [path,expected]of Object.entries({...review.files,...review.predecessorProofs}))assert(hash(await readFile(path))===expected,'ACCEPTED_SOURCE_OR_PROOF_CHANGED:'+path);
const request=await load(base+'cuda-llvm-request.json');
assert(canonical(request)===canonical({...approved,status:'HALTED_AFTER_PRIVATE_BUN_ARCHIVE_AUDIT_INVOCATION_FAILURE_DECISION_REQUIRED',authorityGranted:false,authorization:{...approved.authorization,grantStatus:'HALTED_AFTER_FIRST_FAILURE'},phase:'HALTED_AFTER_PRIVATE_BUN_ARCHIVE_AUDIT_INVOCATION_FAILURE',archiveAuditFailure:{receipt:run+'receipt.json',classification:base+'cuda-archive-audit-2-classification.json',stageClassificationPending:false,failureStage:'02-audit',failureCategory:'PRIVATE_BUN_ABORT_INSIDE_MINIMAL_AUDIT_ROOT',rootCause:'UNDETERMINED',privateBunStartupEstablished:true,xzLaunchStatus:'UNESTABLISHED',decompressionStatus:'UNESTABLISHED',structuralInventoryPublished:false,automaticRetryPerformed:false},renewedExecutorDecisionRequired:true}),'HALT_TRANSITION_ONLY_NO_SCOPE_CHANGE');
const closure=await load(base+'closure.json');
assert(closure.newOperationalOrAcquisitionAuthorityGranted===false&&closure.newLocalDevelopmentNamespaceAndNoRunAuthorityGranted===false&&closure.newOperationalAuthorityGranted===false&&closure.trainingReady===false&&closure.latestDevelopmentFailure===base+'cuda-archive-audit-2-classification.json'&&closure.activeRenewalFailure===closure.latestDevelopmentFailure,'CURRENT_AUTHORITY_HALTED_AND_FAILURE_POINTERS');
for(const label of ['cuda-archive-v2-snapshot-parent-2','cuda-archive-v2-static-parent-2','cuda-archive-v2-types-parent-2','cuda-archive-v2-runner-parent-2','cuda-archive-v2-acquire-regression-2','cuda-archive-v2-isolation-regression-2']){
 const receipt=await load(base+'runs/'+label+'/receipt.json'),manifest=await readFile(base+'runs/'+label+'/sources.json');assert(receipt.status==='PASS'&&receipt.sourceChanged===false&&hash(manifest)===receipt.sourceManifestSha256,'HISTORICAL_V2_SOURCE_GATE_PASS');
 for(const item of JSON.parse(manifest))assert(hash(await readFile(item.path===base+'cuda-llvm-request.json'?run+'approved-request.json':item.path))===item.sha256,'SOURCE_GATE_SNAPSHOT_CHANGED:'+item.path);
 for(const stream of [receipt.stdout,receipt.stderr]){const bytes=await readFile(stream.path);assert(bytes.length===stream.bytes&&hash(bytes)===stream.sha256,'SOURCE_GATE_STREAM_CHANGED');}
}
const failed=await load(run+'receipt.json');assert(failed.status==='FAIL'&&failed.exitCode===1&&failed.failure===null&&failed.sourceChanged===false&&failed.oneOutsideDeadlineMs===30000&&failed.pinnedReviewSha256===hash(raw)&&failed.pinnedRequestSha256===hash(approvedBytes),'FAILED_AUDIT_RECEIPT_PRESERVED');
for(const stream of failed.streams){const bytes=await readFile(stream.path);assert(bytes.length===stream.bytes&&hash(bytes)===stream.sha256,'FAILED_AUDIT_RAW_STREAM_CHANGED');}
const frames=(await readFile(run+'command.stdout','utf8')).trimEnd().split('\n').map(line=>JSON.parse(line));
assert(frames.at(-1).failedStage==='02-audit'&&canonical(frames.at(-1).completedStages)===canonical(['00-trust','01-config']),'FAILURE_STAGE');
const stderr=await readFile(run+'command.stderr','utf8');assert(stderr.includes('panic(main thread): abort() called')&&stderr.includes("import { auditTar } from '/audit/cuda-tar.ts'"),'PRIVATE_BUN_ABORT_DIAGNOSTIC');
const classification=await load(base+'cuda-archive-audit-2-classification.json'),observation=await load(run+'output-state-after-failure.json');
assert(classification.privateBunExecutionEstablished===true&&classification.rootCause==='UNDETERMINED'&&classification.xzLaunchStatus==='UNESTABLISHED'&&classification.decompressionStatus==='UNESTABLISHED'&&classification.structuralInventoryPublished===false&&classification.sequenceHaltedAtFirstActualFailure===true,'NO_UNSUPPORTED_RUNTIME_OR_DECODER_CLAIMS');
assert(classification.crashReportUrlVisited===false&&classification.externalCrashReportSubmitted===false&&classification.automaticRetryPerformed===false&&observation.scratchEntries.length===0,'NO_REPORT_RETRY_OR_OUTPUT');
assert((await readdir(base+'scratch/cuda-archive-audit-2')).length===0&&!(await readdir(run)).some(name=>name==='inventory.json'||name==='inventory.pending.json'),'NO_STRUCTURAL_INVENTORY');
const packet=await load(run+'source-snapshot.json');assert(packet.captureTiming==='BEFORE_ACTUAL_PASSIVE_AUDIT_INVOCATION'&&packet.files.length===26,'ACTUAL_SOURCE_CAPTURE_TIMING');
for(const item of packet.files){const bytes=await readFile(item.snapshot);assert(bytes.length===item.bytes&&hash(bytes)===item.sha256&&review.files[item.path]===item.sha256,'EXECUTED_SOURCE_PACKET_CHANGED');}
const qualification=await load(failed.readOnlyRootPlan);assert(qualification.status==='PASS'&&qualification.sourceChanged===false&&hash(await readFile(failed.readOnlyRootPlan))===failed.readOnlyRootPlanSha256,'PRESERVED_READ_ONLY_QUALIFICATION');
for(const stream of qualification.streams){const bytes=await readFile(stream.path);assert(bytes.length===stream.bytes&&hash(bytes)===stream.sha256,'READ_ONLY_QUALIFICATION_STREAM_CHANGED');}
console.log(JSON.stringify({status:'PASS',scope:'HALT_RECORD_AND_EXECUTED_SOURCE_EVIDENCE_ONLY_NOT_OPERATIONAL_RETRY',historicalSourceGates:{snapshot:[46,1065],archive:[163,842],runner:[16,326],types:'PASS'},current26SourcesAnd97ProofsUnchanged:true,executed26SourceFilesCapturedBeforeInvocation:true,readOnlyPlanPassPreserved:true,failedAuditStreamsPreserved:true,trustAndDiscoveryPassed:true,privateBunExecutionAndAbortEstablished:true,xzLaunch:'UNESTABLISHED',decompression:'UNESTABLISHED',rootCause:'UNDETERMINED',inventoryPublished:false,authorityGranted:false,freshDecisionRequired:true,externalReportSubmitted:false,automaticRetryPerformed:false,trainingReady:false},null,2));
