+      "configuration": { "selectedUuid": "GPU-12345678-1234-1234-1234-123456789abc", "startupMinFreeBytes": "9223372036854775808", "runningStopBelowFreeBytes": "500", "samplePeriodNs": "100", "maxSampleAgeNs": "200" },
+      "originalS0Ns": "0",
