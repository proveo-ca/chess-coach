+        { "method": "observe", "nowNs": "1", "sample": { "uuid": "GPU-12345678-1234-1234-1234-123456789abc", "freeBytes": "499", "totalBytes": "2000", "observedBoottimeNs": "1" }, "expected": { "kind": "abort-owned", "reason": "HEADROOM", "cleanupDeadlineNs": "300000000000" } },
