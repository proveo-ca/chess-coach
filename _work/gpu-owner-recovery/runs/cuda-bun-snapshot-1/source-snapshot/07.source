// SPEC: _spec/recovery.md
import { expect, test } from "bun:test";
import { mkdirSync, mkdtempSync, readFileSync, statSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { runBounded, sourceFilePaths, verificationArgv } from "./verify";

const scratch = fileURLToPath(new URL("./scratch/runner-", import.meta.url));
mkdirSync(fileURLToPath(new URL("./scratch", import.meta.url)), { recursive: true, mode: 0o700 });
const directory = () => mkdtempSync(scratch);

test("Bun test commands select exact repository files rather than discovering fixture clones", () => {
  for (const stage of ["runner", "policy", "bridge", "reference-guards", "cuda-isolation", "cuda-acquire", "cuda-archive", "cuda-bun-snapshot"]) {
    const selectors = verificationArgv(stage).filter(value => value.endsWith(".test.ts"));
    expect(selectors.length).toBeGreaterThan(0);
    for (const selector of selectors) expect(selector.startsWith("./")).toBe(true);
    if (stage === "cuda-isolation") expect(selectors).toEqual(["./_work/gpu-owner-recovery/cuda-isolation.test.ts"]);
    if (stage === "cuda-acquire") expect(selectors).toEqual(["./_work/gpu-owner-recovery/cuda-continuation.test.ts", "./_work/gpu-owner-recovery/cuda-acquire.test.ts"]);
    if (stage === "cuda-archive") expect(selectors).toEqual(["./_work/gpu-owner-recovery/cuda-tar.test.ts", "./_work/gpu-owner-recovery/cuda-elf.test.ts", "./_work/gpu-owner-recovery/cuda-archive.test.ts"]);
    if (stage === "cuda-bun-snapshot") expect(selectors).toEqual(["./_work/gpu-owner-recovery/cuda-bun-snapshot.test.ts"]);
  }
});

test("private Bun capture manifests retain the exact source, configuration and authenticated pre-renewal packet", async () => {
  for (const stage of ["cuda-bun-snapshot", "cuda-archive", "runner", "typecheck-tools"]) {
    const paths = await sourceFilePaths(stage);
    for (const path of ["cuda-bun-snapshot.ts", "cuda-bun-snapshot.test.ts", "cuda-bun-snapshot-mise.toml",
      "cuda-archive-reviewed.json", "cuda-archive-plan-1-classification.json", "runs/cuda-bun-snapshot-1/request-before-renewal.json",
      "runs/cuda-archive-plan-1/receipt.json", "runs/cuda-archive-plan-1/command.stdout", "runs/cuda-archive-plan-1/command.stderr",
      "runs/cuda-archive-plan-1/authenticated-request-retained-after-plan.json", "runs/cuda-archive-plan-1/source-snapshot.json",
      "runs/cuda-archive-plan-1/source-snapshot/00.source", "runs/cuda-archive-plan-1/source-snapshot/22.source",
      "runs/cuda-archive-plan-1/ancestor-metadata.json"]) expect(paths).toContain(`_work/gpu-owner-recovery/${path}`);
  }
});

