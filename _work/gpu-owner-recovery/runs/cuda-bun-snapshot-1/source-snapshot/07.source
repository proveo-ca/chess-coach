test("every source manifest includes the executed supervisor and pinned reference metadata", async () => {
  for (const stage of ["runner", "typecheck-tools", "typecheck-source", "typecheck-tests", "policy", "bridge", "reference-guards", "review-ts", "review-rust", "cuda-isolation", "cuda-acquire", "cuda-archive", "cuda-bun-snapshot"]) {
