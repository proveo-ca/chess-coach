test("repository runner retains bounded successful output and exact exit", async () => {
  const root = directory();
  const result = await runBounded([process.execPath, "-e", "console.log('synthetic-recovery'); console.error('bounded-error-stream')"], root, 5_000);
  expect(result.status).toBe("PASS");
  expect(result.exitCode).toBe(0);
  expect(readFileSync(`${root}/command.stdout`, "utf8")).toBe("synthetic-recovery\n");
  expect(readFileSync(`${root}/command.stderr`, "utf8")).toBe("bounded-error-stream\n");
});

test("repository runner preserves nonzero exits without success substitution", async () => {
  const result = await runBounded([process.execPath, "-e", "process.exit(7)"], directory(), 5_000);
  expect(result.status).toBe("FAIL");
  expect(result.exitCode).toBe(7);
});

test("repository runner kills its bounded stalled synthetic child", async () => {
  const result = await runBounded([process.execPath, "-e", "setInterval(()=>{},1000)"], directory(), 30);
  expect(result.status).toBe("FAIL");
  expect(result.failure).toBe("COMMAND_DEADLINE");
});

test("repository runner retains group custody after a command exits with inherited pipes open", async () => {
  const root = directory(), started = performance.now();
  const source = `Bun.spawn([process.execPath, '--no-env-file', '--no-install', '-e', 'setInterval(() => {}, 1000)'], { stdin: 'ignore', stdout: 'inherit', stderr: 'inherit' }); process.exit(0);`;
  const result = await runBounded([process.execPath, "--no-env-file", "--no-install", "-e", source], root, 200);
  expect(result.status).toBe("FAIL");
  expect(result.failure).toBe("COMMAND_DEADLINE");
  expect(performance.now() - started).toBeLessThan(1_500);
});

test("repository runner rejects supervisor loss after a successful command exit", async () => {
  const started = performance.now();
  const source = `const descendant = 'setTimeout(() => process.kill(' + process.ppid + ', "SIGKILL"), 200); setTimeout(() => process.exit(0), 1500);'; Bun.spawn([process.execPath, '--no-env-file', '--no-install', '-e', descendant], { stdin: 'ignore', stdout: 'inherit', stderr: 'inherit' }); process.exit(0);`;
  const result = await runBounded([process.execPath, "--no-env-file", "--no-install", "-e", source], directory(), 5_000);
  expect(result.status).toBe("FAIL");
  expect(result.failure).toBe("COMMAND_SUPERVISOR_EXIT");
  expect(performance.now() - started).toBeLessThan(1_200);
});

test("repository command supervisor terminates its anchored group on runner disconnect", async () => {
  const root = directory(), environment = { LANG: "C", LC_ALL: "C", TZ: "UTC", HOME: root, TMPDIR: root };
  const child = Bun.spawn([process.execPath, "--no-env-file", "--no-install", fileURLToPath(new URL("./command-supervisor.ts", import.meta.url))], {
    cwd: root, env: environment, stdin: "ignore", stdout: "pipe", stderr: "pipe", detached: true, ipc() {},
  });
  let reaped = false;
  const exit = child.exited.then(code => { reaped = true; return code; });
  const timer = setTimeout(() => { if (!reaped) process.kill(-child.pid, "SIGKILL"); }, 2_000);
  const reader = child.stdout.getReader();
  try {
    const source = `const descendant = Bun.spawn([process.execPath, '--no-env-file', '--no-install', '-e', 'setInterval(() => {}, 1000)'], { stdin: 'ignore', stdout: 'inherit', stderr: 'inherit' }); console.log(JSON.stringify({ commandPid: process.pid, descendantPid: descendant.pid })); setInterval(() => {}, 1000);`;
    child.send({ argv: [process.execPath, "--no-env-file", "--no-install", "-e", source], cwd: root, environment });
    const ready = await reader.read();
    expect(ready.done).toBe(false);
    const pids = JSON.parse(new TextDecoder().decode(ready.value)) as { commandPid: number; descendantPid: number };
    const started = performance.now();
    child.disconnect();
    expect(await exit).not.toBe(0);
    while (!(await reader.read()).done) {}
    await new Response(child.stderr).arrayBuffer();
    expect(performance.now() - started).toBeLessThan(1_200);
    for (const pid of [pids.commandPid, pids.descendantPid]) {
      let state = "absent";
      try { const stat = readFileSync(`/proc/${pid}/stat`, "utf8"); state = stat.slice(stat.lastIndexOf(")") + 2, stat.lastIndexOf(")") + 3); }
      catch (error) { if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error; }
      expect(["absent", "Z"]).toContain(state);
    }
  } finally {
    clearTimeout(timer);
    if (!reaped) process.kill(-child.pid, "SIGKILL");
    await exit;
    reader.releaseLock();
  }
});

for (const stream of ["stdout", "stderr"] as const) {
  test(`repository runner rejects ${stream} overflow and preserves only the bounded prefix`, async () => {
    const root = directory();
    const result = await runBounded([process.execPath, "-e", `process.${stream}.write('x'.repeat(9*1024*1024))`], root, 5_000);
    expect(result.status).toBe("FAIL");
    expect(result.failure).toBe("COMMAND_OUTPUT_BOUND");
    expect(statSync(`${root}/command.${stream}`).size).toBe(4 * 1024 * 1024);
    expect(result[stream === "stdout" ? "stdoutBytes" : "stderrBytes"]).toBeGreaterThan(4 * 1024 * 1024);
  });
}

test("repository runner refuses paths outside the repository work root", async () => {
  await expect(runBounded([process.execPath, "-e", "throw Error('must not launch')"], "/nonexistent-external-recovery", 100)).rejects.toThrow("RECOVERY_RUN_CONTEXT");
});
