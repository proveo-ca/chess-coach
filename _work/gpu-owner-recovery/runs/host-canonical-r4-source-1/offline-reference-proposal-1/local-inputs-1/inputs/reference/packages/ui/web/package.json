{
  "name": "@chess-coach/ui-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./provider": "./src/UiProvider.tsx",
    "./primitives/*": "./src/primitives/*.tsx",
    "./atoms/*": "./src/atoms/*.tsx",
    "./types/*": "./src/types/*.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint -c oxlint.config.ts && node scripts/check-boundary.mjs",
    "test": "vitest run",
    "storybook": "storybook dev -p 6008 --ci",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@typescript/native-preview": "^7.0.0-dev.20260428.1",
    "jsdom": "^28.1.0",
    "oxlint": "^1.62.0",
    "solid-js": "^1.9.12",
    "storybook": "^10.5.4",
    "storybook-solidjs-vite": "^10.6.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "solid-js": "^1.9.12"
  }
}
