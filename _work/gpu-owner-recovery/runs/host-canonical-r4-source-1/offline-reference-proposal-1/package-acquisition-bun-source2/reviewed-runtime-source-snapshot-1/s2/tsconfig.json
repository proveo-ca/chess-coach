  "include": ["capture.ts", "capture.test.ts", "capture-full.test.ts", "root-context.ts", "root-context.test.ts", "cache-parent.ts", "cache-parent.test.ts", "cache-parent-adapter.ts", "cache-parent-adapter.test.ts", "verify.ts"]
}
