    "/usr/local/bin/bun",
    "--no-env-file",
    "--no-install",
    "-e",
    "\nimport { auditTar } from '/audit/cuda-tar.ts';\nimport { constants } from 'node:fs';\nimport { open } from 'node:fs/promises';\nimport { createHash } from 'node:crypto';\nconst child = Bun.spawn(['/usr/bin/xz','--decompress','--stdout','--threads=1','--memlimit-decompress=256MiB','--','/inputs/llvm.tar.xz'],\n  {cwd:'/',env:{\"PATH\":\"/usr/local/bin:/usr/bin:/bin\",\"LANG\":\"C.UTF-8\",\"LC_ALL\":\"C.UTF-8\",\"TZ\":\"UTC\"},stdin:'ignore',stdout:'pipe',stderr:'pipe',detached:false});\ntry {\n  const inventory = await (async function runXZAudit(child, audit, report = () => {}) {\n  let failed = !1, first, stdoutEOF = !1, stderrEOF = !1, stderrLength = 0;\n  const retained = [], stop = (error) => {\n    if (!failed) {\n      failed = !0;\n      first = error;\n    }\n    try {\n      child.kill();\n    } catch {}\n  }, stderr = (async () => {\n    try {\n      for await (const chunk of child.stderr) {\n        if (!(chunk instanceof Uint8Array))\n          throw Error(\"XZ_STDERR_INVALID\");\n        const keep = Math.min(chunk.byteLength, Math.max(0, 65536 - stderrLength));\n        if (keep)\n          retained.push(chunk.slice(0, keep));\n        stderrLength = Math.min(65537, stderrLength + chunk.byteLength);\n        if (stderrLength > 65536)\n          stop(Error(\"XZ_STDERR_LIMIT\"));\n      }\n      stderrEOF = !0;\n    } catch (error) {\n      stop(error);\n    }\n  })(), exit = child.exited.then((code) => {\n    if (code !== 0)\n      stop(Error(\"XZ_EXIT_NONZERO\"));\n  }, () => {\n    stop(Error(\"XZ_REAP_FAILED\"));\n  });\n  let inventory;\n  try {\n    inventory = await audit(async function* () {\n      for await (const bytes of child.stdout) {\n        if (!(bytes instanceof Uint8Array))\n          throw Error(\"XZ_STDOUT_INVALID\");\n        yield bytes;\n      }\n      stdoutEOF = !0;\n    }());\n    if (!stdoutEOF)\n      stop(Error(\"XZ_STDOUT_NOT_EOF\"));\n  } catch (error) {\n    stop(error);\n  }\n  await Promise.all([stderr, exit]);\n  if (!stderrEOF && !failed)\n    stop(Error(\"XZ_STDERR_NOT_EOF\"));\n  if (failed) {\n    const bytes = new Uint8Array(Math.min(stderrLength, 65536));\n    let offset = 0;\n    for (const chunk of retained) {\n      bytes.set(chunk, offset);\n      offset += chunk.byteLength;\n    }\n    try {\n      report(bytes);\n    } catch {}\n    throw first;\n  }\n  return inventory;\n})({stdout:child.stdout,stderr:child.stderr,exited:child.exited,kill:()=>child.kill('SIGKILL')},auditTar,bytes=>process.stderr.write(bytes));\n  const encoded = JSON.stringify(inventory), inventorySha256 = createHash('sha256').update(encoded).digest('hex');\n  const bytes = new TextEncoder().encode(JSON.stringify({version:'chess-coach.cuda-archive-child-output.v1',inventorySha256,inventory}));\n  if (bytes.byteLength > 33554432) throw Error('INVENTORY_BYTE_LIMIT');\n  const handle = await open('/output/inventory.json',constants.O_WRONLY|constants.O_CREAT|constants.O_EXCL|constants.O_NOFOLLOW,0o600);\n  try { await handle.writeFile(bytes); await handle.sync(); } finally { await handle.close(); }\n} catch (error) { console.error('ARCHIVE_CHILD_FAILED:'+(function archiveFailureCode(error) {\n  const message = error instanceof Error ? error.message : typeof error === \"string\" ? error : \"\";\n  if (message.startsWith(\"Invalid ELF: \"))\n    return \"NATIVE_ELF_METADATA_REJECTED\";\n  return /^[A-Z][A-Z0-9_]{0,127}$/.test(message) ? message : \"ARCHIVE_AUDIT_FAILED\";\n})(error)); process.exitCode=1; }\n"
  ],
