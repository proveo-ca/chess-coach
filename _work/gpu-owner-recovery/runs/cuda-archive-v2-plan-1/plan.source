
import { readFile } from 'node:fs/promises';
import { createHash } from 'node:crypto';
const base='_work/gpu-owner-recovery/',expectedReviewSha='dacf7e484328711b65f72d48ee6cba4808164fd6ce9ddb7bf3366868486f173c',expectedRequestSha='a968cc2761869c8634a3cc929f2b1d21a7804f7128bd1fb6b045f76598fbd9f1',hash=bytes=>createHash('sha256').update(bytes).digest('hex');
const raw=await readFile(base+'cuda-archive-reviewed-v2.json');if(hash(raw)!==expectedReviewSha)throw Error('PINNED_ARCHIVE_V2_REVIEW_REQUIRED');const record=JSON.parse(raw);
if(record.version!=='chess-coach.cuda-archive-audit-source-review.v2'||['staticUnitTestsPassed','staticTypesPassed','adversarialSourceAccepted','securitySourceAccepted','devopsSourceAccepted'].some(key=>record[key]!==true)||Object.keys(record.files).length!==26||Object.keys(record.predecessorProofs).length!==97||record.requestSha256!==expectedRequestSha||hash(await readFile(base+'cuda-llvm-request.json'))!==expectedRequestSha)throw Error('EXACT_ARCHIVE_V2_OUTSIDE_GATE');
for(const [path,expected]of Object.entries({...record.files,...record.predecessorProofs}))if(hash(await readFile(path))!==expected)throw Error('PINNED_ARCHIVE_V2_INPUT_CHANGED:'+path);
const {readArchiveContinuationInputs,validateArchiveContinuation,prepareArchiveAuditPlan,validateArchivePlanSnapshot,archiveAuditArgv}=await import('./_work/gpu-owner-recovery/cuda-archive.ts');
const input=await readArchiveContinuationInputs(),capture=validateArchiveContinuation(input),plan=await prepareArchiveAuditPlan();validateArchivePlanSnapshot(plan,capture);const argv=archiveAuditArgv(plan);
if(plan.files.find(mount=>mount.guest==='/audit/cuda-tar.ts').file.sha256!==record.files[base+'cuda-tar.ts'])throw Error('PLANNED_TAR_SOURCE_CHANGED');
console.log(JSON.stringify({status:'PASS',scope:'READ_ONLY_AUTHENTICATED_PRIVATE_BUN_NATIVE_CLOSURE_AND_EXACT_INPUT_BYTES_NOT_AUDIT_EXECUTION',pinnedReviewSha256:expectedReviewSha,pinnedRequestSha256:expectedRequestSha,rootPlan:plan,argv,privateSnapshotMatchesCommittedIdentity:true,quarantineLaunched:false,privateSnapshotExecuted:false,decompressionPerformed:false,extractionPerformed:false,llvmCodeExecuted:false,buildIsolationQualified:false,custodyQualified:false,cudaCompilationEstablished:false,trainingReady:false},null,2));
