const expectedReviewSha='dacf7e484328711b65f72d48ee6cba4808164fd6ce9ddb7bf3366868486f173c',expectedRequestSha='a968cc2761869c8634a3cc929f2b1d21a7804f7128bd1fb6b045f76598fbd9f1',hash=bytes=>createHash('sha256').update(bytes).digest('hex');
async function gate(){
 const raw=await readFile(work+'/cuda-archive-reviewed-v2.json');if(hash(raw)!==expectedReviewSha)throw Error('PINNED_ARCHIVE_V2_REVIEW_REQUIRED');const record=JSON.parse(raw);
 if(record.version!=='chess-coach.cuda-archive-audit-source-review.v2'||['staticUnitTestsPassed','staticTypesPassed','adversarialSourceAccepted','securitySourceAccepted','devopsSourceAccepted'].some(key=>record[key]!==true)||Object.keys(record.files).length!==26||Object.keys(record.predecessorProofs).length!==97||record.requestSha256!==expectedRequestSha||hash(await readFile(work+'/cuda-llvm-request.json'))!==expectedRequestSha)throw Error('EXACT_ARCHIVE_V2_OUTSIDE_GATE');
 for(const [path,expected]of Object.entries({...record.files,...record.predecessorProofs}))if(hash(await readFile(root+'/'+path))!==expected)throw Error('PINNED_ARCHIVE_V2_INPUT_CHANGED:'+path);
 const planRaw=await readFile(work+'/runs/cuda-archive-v2-plan-1/receipt.json');if(hash(planRaw)!==expectedPlanSha)throw Error('READ_ONLY_ROOT_QUALIFICATION_CHANGED');const plan=JSON.parse(planRaw);
 if(plan.status!=='PASS'||plan.exitCode!==0||plan.failure!==null||plan.sourceChanged!==false||plan.pinnedReviewSha256!==expectedReviewSha||plan.pinnedRequestSha256!==expectedRequestSha)throw Error('PASS_PRIVATE_ROOT_QUALIFICATION_REQUIRED');
 for(const stream of plan.streams){const bytes=await readFile(root+'/'+stream.path);if(bytes.length!==stream.bytes||hash(bytes)!==stream.sha256)throw Error('ROOT_QUALIFICATION_STREAM_CHANGED');}
}
try{
 await gate();
 const {readArchiveContinuationInputs,validateArchiveContinuation,runArchiveAuditMiseStages}=await import(work+'/cuda-archive.ts');
 validateArchiveContinuation(await readArchiveContinuationInputs());
 const result=await runArchiveAuditMiseStages({verifyOutsideGate:gate,readTaskConfiguration:()=>readFile(work+'/cuda-archive-mise.toml'),run:async stage=>{
  await writeFile(directory+'/'+stage.name+'.argv.json',JSON.stringify(stage.argv,null,2)+'\n',{flag:'wx',mode:0o600});console.log(JSON.stringify({stage:stage.name,argv:stage.argv}));
  if(stage.name==='02-audit'){
   const child=Bun.spawn(stage.argv,{cwd:work,env:environment,stdin:'ignore',stdout:'inherit',stderr:'inherit',detached:false}),exitCode=await child.exited;
   await writeFile(directory+'/'+stage.name+'.json',JSON.stringify({stage:stage.name,argv:stage.argv,exitCode},null,2)+'\n',{flag:'wx',mode:0o600});return{exitCode,stdout:new Uint8Array(),failure:null};
  }
  const command=Bun.spawnSync(stage.argv,{cwd:work,env:environment,stdin:'ignore',stdout:'pipe',stderr:'pipe',maxBuffer:65536});
  await writeFile(directory+'/'+stage.name+'.stdout',command.stdout,{flag:'wx',mode:0o600});await writeFile(directory+'/'+stage.name+'.stderr',command.stderr,{flag:'wx',mode:0o600});
  const failure=command.error?String(command.error):null,status={stage:stage.name,argv:stage.argv,exitCode:command.exitCode,signalCode:command.signalCode??null,failure};
  await writeFile(directory+'/'+stage.name+'.json',JSON.stringify(status,null,2)+'\n',{flag:'wx',mode:0o600});console.log(JSON.stringify(status));
  if(command.exitCode!==0||failure!==null)await Bun.write(Bun.stderr,command.stderr);
  return{exitCode:command.exitCode,stdout:command.stdout,failure};
 }});
 console.log(JSON.stringify(result));process.exitCode=result.exitCode;
}catch(error){console.error(String(error));process.exitCode=1;}
