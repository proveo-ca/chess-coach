    `${captureRoot}source-snapshot/15.source`, `${captureRoot}source-snapshot/16.source`, `${captureRoot}receipt.json`, snapshotPaths.capture,
    `${captureRoot}verification.json`, snapshotPaths.operation, `${captureRoot}command.stdout`, `${captureRoot}command.stderr`]) {
    const bad = copy(input), original = bad.evidence.predecessorProofs[path]!;
    (bad.evidence.predecessorProofs as Record<string, Uint8Array>)[path] = path.endsWith(".json") ? bytes({ ...json(original), status: "FAIL" }) : text("changed");
    expect(() => validateArchiveContinuation(seal(bad))).toThrow();
  }
  for (const mutate of [(r: any) => { r.finalIdentity.mode = 0o100755; }, (r: any) => { r.finalIdentity.uid = 0; },
    (r: any) => { r.finalIdentity.links = 1; }, (r: any) => { r.sha256 = "0".repeat(64); }, (r: any) => { r.destination = "/usr/local/bin/bun"; }]) {
    const bad = copy(input), capture = json(bad.evidence.predecessorProofs[snapshotPaths.capture]!); mutate(capture);
