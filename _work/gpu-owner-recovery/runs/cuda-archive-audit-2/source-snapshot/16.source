// SPEC: _spec/recovery.md
import { expect, test } from "bun:test";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { repository } from "./provision";
import { artifactIdentities, reviewedFiles as acquisitionFiles, predecessorPaths as inertPaths, sha256 } from "./cuda-continuation";
import { completedSnapshotPins, completedSnapshotProofPaths, snapshotIdentity, snapshotPaths } from "./cuda-bun-snapshot";
import { archiveAuditArgv, archiveAuditCLI, archiveAuditEnvironment, archiveAuditStagePlan, archiveAuditTaskConfiguration, archiveChildEnvironment,
  archiveFailureCode, archiveTestOnly, auditLimits, bindingPath, bindingVersion, FIXED_TRUSTED_CHILD_PROGRAM, predecessorPaths, reviewedFiles, runArchiveAuditMiseStages,
  validateArchiveContinuation, validateArchiveMiseDiscovery, validateArchivePlanSnapshot, validateArchiveTaskConfiguration } from "./cuda-archive";
import type { ArchiveContinuationInputs, AuditedFile, TrustedArchiveIO, XZProcess } from "./cuda-archive";

const base = "_work/gpu-owner-recovery/", acquisition = `${base}runs/cuda-llvm-acquire-1/`, prefix = "tracel-llvm-23.1.0-4";
const captureRoot = `${base}runs/cuda-bun-snapshot-1/`, privateBun = resolve(repository, snapshotIdentity.destination);
const bytes = (value: unknown) => new TextEncoder().encode(JSON.stringify(value)), text = (value: string) => new TextEncoder().encode(value);
const json = (value: Uint8Array) => JSON.parse(new TextDecoder().decode(value));
const copy = <T>(value: T): T => structuredClone(value);
const configuration = text('# SPEC: _spec/recovery.md\n[tasks."cuda:audit-llvm-archive"]\ndir = "../.."\nrun = "/usr/local/bin/bun --no-env-file --no-install _work/gpu-owner-recovery/cuda-archive.ts audit"\n');
function seal(input: ArchiveContinuationInputs): ArchiveContinuationInputs {
  return { ...input, binding: { version: bindingVersion, staticUnitTestsPassed: true, staticTypesPassed: true, adversarialSourceAccepted: true,
    securitySourceAccepted: true, devopsSourceAccepted: true, requestSha256: sha256(input.requestBytes),
    files: Object.fromEntries(reviewedFiles.map(path => [path, sha256(input.evidence.files[path]!)])),
    predecessorProofs: Object.fromEntries(predecessorPaths.map(path => [path, sha256(input.evidence.predecessorProofs[path]!)])) } };
}
export async function archiveContinuationFixture(): Promise<ArchiveContinuationInputs> {
  const predecessorProofs = Object.fromEntries(await Promise.all(predecessorPaths.map(async path => [path, new Uint8Array(await readFile(resolve(repository, path)))])));
  const files = Object.fromEntries(reviewedFiles.map(path => [path, text(`fixture source:${path}`)]));
  for (const path of [`${base}cuda-isolation.ts`, `${base}cuda-isolation.test.ts`, `${base}cuda-mise.toml`, `${base}provision.ts`, `${base}mise.toml`])
    files[path] = predecessorProofs[`${acquisition}source-snapshot/${String(acquisitionFiles.indexOf(path as typeof acquisitionFiles[number])).padStart(2, "0")}.source`]!;
  files[archiveAuditTaskConfiguration] = configuration;
  const approved = json(predecessorProofs[`${captureRoot}approved-request.json`]!);
  const requestBytes = bytes({ ...approved, status: "APPROVED_SEQUENCE_IN_PROGRESS_AFTER_PRIVATE_BUN_CAPTURE", phase: "PRIVATE_BUN_CAPTURED_ARCHIVE_V2_SOURCE_GATES_PENDING",
    nativeBunSnapshot: { ...approved.nativeBunSnapshot, grantStatus: "CONSUMED_SUCCESS" }, nativeBunSnapshotResult: { status: "PASS", outsideReceipt: `${captureRoot}receipt.json`,
      captureReceipt: snapshotPaths.capture, verification: `${captureRoot}verification.json`, approvedRequestCapture: `${captureRoot}approved-request.json`,
      sourceReview: snapshotPaths.binding, sourceSnapshot: `${captureRoot}source-snapshot.json`, privateSnapshotExecuted: false } });
  return seal({ requestBytes, binding: null, evidence: { files, predecessorProofs } });
}
const file = (source: string, sha = "a".repeat(64), size = 100, elf = true): AuditedFile => ({ source, sha256: sha,
  identity: { device: "1", inode: source, bytes: size, mode: 0o100755, uid: process.getuid!(), links: 1, mtime: "1", ctime: "1" },
  ...(elf ? { elf: { interpreter: null, needed: [], soname: null } } : {}) });
function planIO(input?: ArchiveContinuationInputs) {
  const natives = new Map<string, AuditedFile>();
  for (const name of ["/usr/bin/bwrap", "/usr/bin/xz"]) natives.set(name, file(name));
  const bun = file(privateBun, snapshotIdentity.sha256, snapshotIdentity.byteLength);
  const committed = input ? json(input.evidence.predecessorProofs[snapshotPaths.capture]!).finalIdentity : { ...bun.identity, mode: 0o100500, links: 2 };
  natives.set("/usr/local/bin/bun", { ...bun, identity: { device: committed.device, inode: committed.inode, bytes: committed.bytes, mode: committed.mode,
    uid: committed.uid, links: committed.links, mtime: committed.mtime, ctime: committed.ctime } });
  const loader = file("/usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2"), lib = file("/usr/lib/x86_64-linux-gnu/libc.so.6");
  for (const root of ["/usr/lib/x86_64-linux-gnu", "/lib/x86_64-linux-gnu"]) { natives.set(`${root}/libc.so.6`, lib); natives.set(`${root}/ld-linux-x86-64.so.2`, loader); }
  natives.set("/lib64/ld-linux-x86-64.so.2", loader);
  for (const name of ["/usr/local/bin/bun", "/usr/bin/xz"]) natives.set(name, { ...natives.get(name)!, elf: { interpreter: "/lib64/ld-linux-x86-64.so.2", needed: ["libc.so.6"], soname: null } });
  const payloads = new Map<string, AuditedFile>();
  for (const identity of Object.values(artifactIdentities)) { const path = resolve(repository, identity.destination); payloads.set(path, file(path, identity.sha256, identity.byteLength, false)); }
  const tar = resolve(repository, `${base}cuda-tar.ts`); payloads.set(tar, file(tar, sha256(input?.evidence.files[`${base}cuda-tar.ts`] ?? text("tar source")), 100, false));
  return { natives, payloads, io: { native: async (logical: string) => natives.get(logical) ?? null, payload: async (path: string) => payloads.get(path)! } };
}
const inventory = () => ({ version: 1, prefix, entries: [{ path: `${prefix}/bin/clang`, type: "file", mode: 0o755, size: 3, sha256: sha256(text("abc")) }],
  totals: { decompressedBytes: 2048, headerCount: 3, extensionBytes: 0, fileBytes: 3, count: 1 } });
const output = (value: unknown = inventory()) => bytes({ version: "chess-coach.cuda-archive-child-output.v1", inventorySha256: sha256(bytes(value)), inventory: value });
function processFixture(chunks = [text("tar")], stderr = [new Uint8Array()], exit = 0) {
  const events: string[] = [];
  const stream = async function* (values: Uint8Array[], label: string) { for (const chunk of values) { events.push(label); yield chunk; } events.push(`${label}:EOF`); };
  const child: XZProcess = { stdout: stream(chunks, "stdout"), stderr: stream(stderr, "stderr"), exited: Promise.resolve(exit).then(code => { events.push("reaped"); return code; }), kill: () => { events.push("kill"); } };
  return { child, events };
}
const consume = async (chunks: AsyncIterable<Uint8Array>) => { for await (const _chunk of chunks) {} return inventory(); };

test("immutable completed capture accepts only the exact post-capture v2 continuation and complete source binding", async () => {
  const input = await archiveContinuationFixture(); expect(() => validateArchiveContinuation(input)).not.toThrow();
  expect(bindingPath).toBe(`${base}cuda-archive-reviewed-v2.json`); expect(bindingVersion).toBe("chess-coach.cuda-archive-audit-source-review.v2");
  expect(reviewedFiles).toHaveLength(26); expect(new Set(reviewedFiles).size).toBe(26); expect(reviewedFiles).toContain(`${base}fixtures/cuda-tar-cases.json`);
  expect(predecessorPaths).toEqual(completedSnapshotProofPaths); expect(predecessorPaths).toHaveLength(97); expect(new Set(predecessorPaths).size).toBe(97);
  const oldProofs = [...inertPaths, `${acquisition}approved-request.json`, `${base}cuda-acquire-reviewed.json`, `${acquisition}source-review.json`, `${acquisition}receipt.json`, `${acquisition}source-snapshot.json`,
    ...["archive", "checksums"].flatMap(leaf => ["receipt.json", "artifact.json", "command.stdout", "command.stderr", ".operation"].map(name => `${acquisition}${leaf}/${name}`)),
    ...acquisitionFiles.map((_, i) => `${acquisition}source-snapshot/${String(i).padStart(2, "0")}.source`)];
  expect(oldProofs).toHaveLength(36); for (const path of oldProofs) expect(predecessorPaths).toContain(path);
  expect(sha256(input.evidence.predecessorProofs[`${captureRoot}approved-request.json`]!)).toBe(completedSnapshotPins.approvedRequest);
  expect(sha256(input.evidence.predecessorProofs[`${captureRoot}source-review.json`]!)).toBe(completedSnapshotPins.review);
  for (const [key, value] of [["status", "HALTED"], ["phase", "AUDIT_CONSUMED"], ["authorityGranted", false], ["renewedExecutorDecisionRequired", true],
    ["trainingAuthorized", true], ["extra", false]] as const) {
    const request = json(input.requestBytes); request[key] = value;
    expect(() => validateArchiveContinuation(seal({ ...input, requestBytes: bytes(request) }))).toThrow();
  }
  for (const change of [(r: any) => { r.authorization.scope = "REVIEWED_INERT_ISOLATION_PROBE_ONLY"; }, (r: any) => { r.authorization.grantStatus = "APPROVED_NOT_EXECUTED"; },
    (r: any) => { r.artifacts[0].sha256 = "a".repeat(64); }, (r: any) => { r.requestedExecutionLimits.automaticRetryAllowed = true; },
    (r: any) => { r.acquisitionResult.extractionPerformed = true; }, (r: any) => { delete r.archiveAuditTaskConfiguration; },
    (r: any) => { r.nativeBunSnapshot.grantStatus = "APPROVED_NOT_EXECUTED"; }, (r: any) => { r.nativeBunSnapshotResult.privateSnapshotExecuted = true; },
    (r: any) => { r.nativeBunSnapshotRenewal.completedDownloadsMayRepeat = true; }, (r: any) => { r.nativeBunSnapshotResult.extra = false; }]) {
    const request = json(input.requestBytes); change(request); expect(() => validateArchiveContinuation(seal({ ...input, requestBytes: bytes(request) }))).toThrow();
  }
  for (const key of ["staticUnitTestsPassed", "staticTypesPassed", "securitySourceAccepted", "adversarialSourceAccepted", "devopsSourceAccepted", "requestSha256"]) {
    const bad = copy(input); (bad.binding as any)[key] = false; expect(() => validateArchiveContinuation(bad)).toThrow();
  }
  const missing = copy(input); delete (missing.evidence.files as Record<string, Uint8Array>)[`${base}cuda-elf.ts`]; expect(() => validateArchiveContinuation(missing)).toThrow();
  const changedFixture = copy(input);
  (changedFixture.evidence.files as Record<string, Uint8Array>)[`${base}fixtures/cuda-tar-cases.json`] = text("changed fixture");
  expect(() => validateArchiveContinuation(changedFixture)).toThrow("ARCHIVE_BINDING_HASH_MISMATCH");
});
test("proof, frozen-source, raw-stream, ledger and saved-byte corruption cannot inherit historical PASS", async () => {
  const input = await archiveContinuationFixture();
  for (const path of [`${acquisition}approved-request.json`, `${acquisition}source-review.json`, `${acquisition}source-snapshot/06.source`, `${acquisition}archive/command.stdout`,
    `${acquisition}checksums/command.stderr`, `${acquisition}archive/.operation`, `${acquisition}source-snapshot.json`, `${acquisition}receipt.json`, `${acquisition}archive/artifact.json`, `${acquisition}checksums/receipt.json`]) {
    const bad = copy(input), original = bad.evidence.predecessorProofs[path]!;
    (bad.evidence.predecessorProofs as Record<string, Uint8Array>)[path] = path.endsWith(".json") ? bytes({ ...json(original), status: "FAIL" }) : text("changed");
    expect(() => validateArchiveContinuation(seal(bad))).toThrow();
  }
  for (const path of [`${base}provision.ts`, `${base}mise.toml`, `${base}cuda-mise.toml`]) {
    const bad = copy(input); (bad.evidence.files as Record<string, Uint8Array>)[path] = text("changed"); expect(() => validateArchiveContinuation(seal(bad))).toThrow();
  }
  const extra = copy(input); (extra.evidence.predecessorProofs as Record<string, Uint8Array>)["latest/receipt.json"] = text("{}"); expect(() => validateArchiveContinuation(extra)).toThrow();
});
