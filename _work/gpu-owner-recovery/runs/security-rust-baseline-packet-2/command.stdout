--- /dev/null
+++ b/crates/gpu-owner/Cargo.toml
@@ -0,0 +1,20 @@
+# SPEC: _spec/gpu-owner.puml
+[package]
+name = "chess-coach-gpu-owner"
+version = "0.1.0"
+edition.workspace = true
+rust-version.workspace = true
+publish.workspace = true
+
+[[bin]]
+name = "host-gpu-owner"
+path = "src/main.rs"
+
+[dependencies]
+rustix = { version = "=1.1.6", features = ["fs", "event", "process", "time"] }
+serde.workspace = true
+serde_json = { workspace = true, features = ["raw_value"] }
+sha2.workspace = true
+
+[dev-dependencies]
+tempfile = "=3.27.0"
diff --git a/crates/gpu-owner/src/docker.rs b/crates/gpu-owner/src/docker.rs
new file mode 100644
index 000000000..6cb12337c
--- /dev/null
+++ b/crates/gpu-owner/src/docker.rs
@@ -0,0 +1,416 @@
+// SPEC: _spec/gpu-owner.md
+use crate::{
+    OwnerError, Result,
+    input::{Injection, OwnerInput},
+    json,
+};
+use serde_json::Value;
+
+pub const OWNERSHIP_LABEL: &str = "chess-coach.gpu-owner.ownership";
+
+pub fn prefix(input: &OwnerInput) -> Vec<String> {
+    vec![
+        "--config".into(),
+        input.docker.anonymous_config_directory.clone(),
+        "--host".into(),
+        format!("unix://{}", input.docker.endpoint_unix_socket),
+    ]
+}
+pub fn cpuset(cpus: &[u32]) -> String {
+    cpus.iter()
+        .map(u32::to_string)
+        .collect::<Vec<_>>()
+        .join(",")
+}
+
+pub fn create(input: &OwnerInput) -> Vec<String> {
+    let mut args = prefix(input);
+    args.extend(
+        [
+            "create",
+            "--pull=never",
+            "--interactive",
+            "--network=none",
+            "--read-only",
+            "--user=1000:1000",
+            "--cpu-period=100000",
+            "--cpu-quota=400000",
+        ]
+        .map(String::from),
+    );
+    args.push(format!(
+        "--cpuset-cpus={}",
+        cpuset(&input.job.gpu_profile.cpus)
+    ));
+    args.extend(
+        [
+            "--memory=8589934592",
+            "--memory-swap=8589934592",
+            "--pids-limit=512",
+            "--cap-drop=ALL",
+            "--security-opt=no-new-privileges",
+            "--restart=no",
+            "--ipc=private",
+            "--cgroupns=private",
+            "--log-driver=none",
+            "--ulimit=nofile=256:256",
+            "--ulimit=fsize=67108864:67108864",
+            "--tmpfs=/tmp:rw,nosuid,nodev,noexec,size=2147483648,nr_inodes=16384",
+            "--runtime=nvidia",
+        ]
+        .map(String::from),
+    );
+    args.push(format!("--name={}", input.ownership.container_name));
+    args.push(format!(
+        "--label={OWNERSHIP_LABEL}={}",
+        input.ownership.ownership_token
+    ));
+    args.push(format!(
+        "--cgroup-parent={}",
+        input.docker.cgroup_parent_argument
+    ));
+    args.push(format!(
+        "--gpus=driver=nvidia,device={}",
+        input.cooperative.selected_uuid
+    ));
+    args.push(format!(
+        "--env=NVIDIA_VISIBLE_DEVICES={}",
+        input.cooperative.selected_uuid
+    ));
+    args.push("--env=NVIDIA_DRIVER_CAPABILITIES=compute".into());
+    args.push(format!(
+        "--mount=type=bind,source={},target=/state,bind-propagation=rprivate",
+        input.job.state_host_source
+    ));
+    args.extend([
+        "--entrypoint=/sbin/chess-init".into(),
+        input.job.image_id.clone(),
+        "-g".into(),
+        "--".into(),
+        "/usr/local/bin/bun".into(),
+        "--no-env-file".into(),
+        "--no-install".into(),
+        "/app/packages/runtime/src/gpu-job.ts".into(),
+        input.ownership.session_id.clone(),
+    ]);
+    args
+}
+pub fn inspect(input: &OwnerInput, id: &str) -> Vec<String> {
+    let mut args = prefix(input);
+    args.extend([
+        "inspect".into(),
+        "--type=container".into(),
+        "--format={{json .}}".into(),
+        id.into(),
+    ]);
+    args
+}
+pub fn start(input: &OwnerInput, id: &str) -> Vec<String> {
+    let mut args = prefix(input);
+    args.extend([
+        "start".into(),
+        "--attach".into(),
+        "--interactive".into(),
+        id.into(),
+    ]);
+    args
+}
+pub fn remove(input: &OwnerInput, id: &str, force: bool) -> Vec<String> {
+    let mut args = prefix(input);
+    args.push("rm".into());
+    if force {
+        args.push("--force".into());
+    }
+    args.push(id.into());
+    args
+}
+pub fn id(bytes: &[u8]) -> Result<String> {
+    if bytes.len() != 65 || bytes[64] != b'\n' {
+        return Err(OwnerError("CONTAINER_ID"));
+    }
+    let id = std::str::from_utf8(&bytes[..64]).map_err(|_| OwnerError("CONTAINER_ID"))?;
+    if !json::digest(id) {
+        return Err(OwnerError("CONTAINER_ID"));
+    }
+    Ok(id.into())
+}
+
+#[derive(Clone, Debug)]
+pub struct OwnedContainer {
+    pub id: String,
+    pub pid: u32,
+    pub running: bool,
+}
+
+fn field<'a>(v: &'a Value, key: &str) -> Result<&'a Value> {
+    v.get(key).ok_or(OwnerError("INSPECT_FIELD"))
+}
+fn equal(v: &Value, key: &str, expected: Value) -> Result<()> {
+    if field(v, key)? != &expected {
+        return Err(OwnerError("INSPECT_C2"));
+    }
+    Ok(())
+}
+fn empty(v: &Value, key: &str) -> Result<()> {
+    if let Some(value) = v.get(key)
+        && !value.is_null()
+        && value.as_array().is_none_or(|a| !a.is_empty())
+    {
+        return Err(OwnerError("INSPECT_EXTRA"));
+    }
+    Ok(())
+}
+
+fn closed(v: &Value, keys: &[&str]) -> Result<()> {
+    let fields = v.as_object().ok_or(OwnerError("INSPECT_OBJECT"))?;
+    if fields.keys().any(|key| !keys.contains(&key.as_str())) {
+        return Err(OwnerError("INSPECT_EXTRA_OPTION"));
+    }
+    Ok(())
+}
+
+pub fn ownership(
+    bytes: &[u8],
+    input: &OwnerInput,
+    expected_id: Option<&str>,
+) -> Result<(OwnedContainer, Value)> {
+    let v: Value = json::decode(bytes, 1024 * 1024)?;
+    let id = field(&v, "Id")?.as_str().ok_or(OwnerError("INSPECT_ID"))?;
+    if !json::digest(id)
+        || expected_id.is_some_and(|expected| expected != id)
+        || field(&v, "Image")?.as_str() != Some(&input.job.image_id)
+        || v.pointer(&format!("/Config/Labels/{OWNERSHIP_LABEL}"))
+            .and_then(Value::as_str)
+            != Some(&input.ownership.ownership_token)
+    {
+        return Err(OwnerError("NOT_OWNED"));
+    }
+    if let Some(name) = v.get("Name")
+        && name.as_str() != Some(&format!("/{}", input.ownership.container_name))
+    {
+        return Err(OwnerError("INSPECT_NAME"));
+    }
+    let state = field(&v, "State")?;
+    let pid = field(state, "Pid")?
+        .as_u64()
+        .and_then(|p| u32::try_from(p).ok())
+        .ok_or(OwnerError("INSPECT_PID"))?;
+    let running = field(state, "Running")?
+        .as_bool()
+        .ok_or(OwnerError("INSPECT_RUNNING"))?;
+    if running && pid == 0 {
+        return Err(OwnerError("INSPECT_PID"));
+    }
+    Ok((
+        OwnedContainer {
+            id: id.into(),
+            pid,
+            running,
+        },
+        v,
+    ))
+}
+
+pub fn validate_c2(v: &Value, input: &OwnerInput, injection: &Injection) -> Result<()> {
+    let h = field(v, "HostConfig")?;
+    let c = field(v, "Config")?;
+    for key in [
+        "CpuShares",
+        "NanoCpus",
+        "CpuRealtimePeriod",
+        "CpuRealtimeRuntime",
+        "MemoryReservation",
+        "OomScoreAdj",
+    ] {
+        if h.get(key).is_some_and(|v| v.as_i64() != Some(0)) {
+            return Err(OwnerError("INSPECT_EXTRA_OPTION"));
+        }
+    }
+    for key in ["OomKillDisable", "Init"] {
+        if h.get(key)
+            .is_some_and(|v| !v.is_null() && v != &Value::Bool(false))
+        {
+            return Err(OwnerError("INSPECT_EXTRA_OPTION"));
+        }
+    }
+    for key in ["Sysctls", "StorageOpt"] {
+        if h.get(key)
+            .is_some_and(|v| !v.is_null() && v != &serde_json::json!({}))
+        {
+            return Err(OwnerError("INSPECT_EXTRA_OPTION"));
+        }
+    }
+    for (key, value) in [
+        ("CpuPeriod", 100000i64),
+        ("CpuQuota", 400000),
+        ("Memory", 8589934592),
+        ("MemorySwap", 8589934592),
+        ("PidsLimit", 512),
+    ] {
+        equal(h, key, value.into())?;
+    }
+    for (key, value) in [
+        ("NetworkMode", "none"),
+        ("IpcMode", "private"),
+        ("CgroupnsMode", "private"),
+        ("Runtime", "nvidia"),
+    ] {
+        equal(h, key, value.into())?;
+    }
+    equal(
+        h,
+        "CgroupParent",
+        input.docker.cgroup_parent_argument.clone().into(),
+    )?;
+    let inspected_cpus = field(h, "CpusetCpus")?
+        .as_str()
+        .ok_or(OwnerError("INSPECT_CPUSET"))?;
+    if crate::observe::parse_cpuset(inspected_cpus)? != input.job.gpu_profile.cpus {
+        return Err(OwnerError("INSPECT_CPUSET"));
+    }
+    for key in ["Privileged", "PublishAllPorts", "AutoRemove"] {
+        equal(h, key, false.into())?;
+    }
+    equal(h, "ReadonlyRootfs", true.into())?;
+    equal(h, "CapDrop", serde_json::json!(["ALL"]))?;
+    equal(h, "SecurityOpt", serde_json::json!(["no-new-privileges"]))?;
+    equal(field(h, "RestartPolicy")?, "Name", "no".into())?;
+    equal(field(h, "RestartPolicy")?, "MaximumRetryCount", 0.into())?;
+    equal(field(h, "LogConfig")?, "Type", "none".into())?;
+    equal(field(h, "LogConfig")?, "Config", serde_json::json!({}))?;
+    for key in [
+        "Devices",
+        "DeviceCgroupRules",
+        "CapAdd",
+        "GroupAdd",
+        "VolumesFrom",
+        "Links",
+        "ExtraHosts",
+        "Dns",
+        "DnsOptions",
+        "DnsSearch",
+    ] {
+        empty(h, key)?;
+    }
+    for key in [
+        "PidMode",
+        "UTSMode",
+        "UsernsMode",
+        "ContainerIDFile",
+        "VolumeDriver",
+    ] {
+        if let Some(value) = h.get(key)
+            && value.as_str() != Some("")
+        {
+            return Err(OwnerError("INSPECT_NAMESPACE"));
+        }
+    }
+    if h.get("PortBindings")
+        .is_some_and(|p| !p.is_null() && p != &serde_json::json!({}))
+    {
+        return Err(OwnerError("INSPECT_PORTS"));
+    }
+    equal(
+        h,
+        "DeviceRequests",
+        serde_json::json!([{ "Driver":"nvidia","Count":0,"DeviceIDs":[input.cooperative.selected_uuid],"Capabilities":[["gpu"]],"Options":{} }]),
+    )?;
+    equal(
+        h,
+        "Tmpfs",
+        serde_json::json!({"/tmp":"rw,nosuid,nodev,noexec,size=2147483648,nr_inodes=16384"}),
+    )?;
+    let ulimits = field(h, "Ulimits")?
+        .as_array()
+        .ok_or(OwnerError("INSPECT_ULIMITS"))?;
+    if ulimits.len() != 2
+        || !ulimits.contains(&serde_json::json!({"Name":"nofile","Soft":256,"Hard":256}))
+        || !ulimits.contains(&serde_json::json!({"Name":"fsize","Soft":67108864,"Hard":67108864}))
+    {
+        return Err(OwnerError("INSPECT_ULIMITS"));
+    }
+    equal(c, "User", "1000:1000".into())?;
+    equal(c, "OpenStdin", true.into())?;
+    equal(c, "Tty", false.into())?;
+    equal(c, "Entrypoint", serde_json::json!(["/sbin/chess-init"]))?;
+    equal(
+        c,
+        "Cmd",
+        serde_json::json!([
+            "-g",
+            "--",
+            "/usr/local/bin/bun",
+            "--no-env-file",
+            "--no-install",
+            "/app/packages/runtime/src/gpu-job.ts",
+            input.ownership.session_id
+        ]),
+    )?;
+    let env = field(c, "Env")?
+        .as_array()
+        .ok_or(OwnerError("INSPECT_ENV"))?;
+    let visible = format!("NVIDIA_VISIBLE_DEVICES={}", input.cooperative.selected_uuid);
+    if env.len() != 2
+        || !env.contains(&Value::String(visible))
+        || !env.contains(&Value::String("NVIDIA_DRIVER_CAPABILITIES=compute".into()))
+    {
+        return Err(OwnerError("INSPECT_ENV"));
+    }
+    if c.get("Volumes")
+        .is_some_and(|v| !v.is_null() && v != &serde_json::json!({}))
+    {
+        return Err(OwnerError("INSPECT_VOLUMES"));
+    }
+    empty(h, "Binds")?;
+    let requested = field(h, "Mounts")?
+        .as_array()
+        .ok_or(OwnerError("INSPECT_MOUNTS"))?;
+    if requested.len() != 1 {
+        return Err(OwnerError("INSPECT_MOUNTS"));
+    }
+    let m = &requested[0];
+    closed(m, &["Type", "Source", "Target", "ReadOnly", "BindOptions"])?;
+    equal(m, "Type", "bind".into())?;
+    equal(m, "Source", input.job.state_host_source.clone().into())?;
+    equal(m, "Target", "/state".into())?;
+    if m.get("ReadOnly").is_some_and(|v| v != &Value::Bool(false)) {
+        return Err(OwnerError("INSPECT_STATE"));
+    }
+    let bind = field(m, "BindOptions")?;
+    closed(bind, &["Propagation"])?;
+    equal(bind, "Propagation", "rprivate".into())?;
+    let mounts = field(v, "Mounts")?
+        .as_array()
+        .ok_or(OwnerError("INSPECT_MOUNTS"))?;
+    let mut state = false;
+    let mut seen = std::collections::HashSet::new();
+    for m in mounts {
+        let destination = field(m, "Destination")?
+            .as_str()
+            .ok_or(OwnerError("INSPECT_MOUNT"))?;
+        if !seen.insert(destination) {
+            return Err(OwnerError("INSPECT_MOUNT"));
+        }
+        if destination == "/state" {
+            equal(m, "Type", "bind".into())?;
+            equal(m, "Source", input.job.state_host_source.clone().into())?;
+            equal(m, "RW", true.into())?;
+            equal(m, "Propagation", "rprivate".into())?;
+            state = true;
+        } else {
+            let approved = injection
+                .inspect_mounts
+                .iter()
+                .find(|m| m.destination == destination)
+                .ok_or(OwnerError("INSPECT_EXTRA_MOUNT"))?;
+            equal(m, "Type", approved.kind.clone().into())?;
+            equal(m, "Source", approved.source.clone().into())?;
+            equal(m, "RW", approved.writable.into())?;
+            equal(m, "Propagation", approved.propagation.clone().into())?;
+        }
+    }
+    if !state || mounts.len() != injection.inspect_mounts.len() + 1 {
+        return Err(OwnerError("INSPECT_MOUNTS"));
+    }
+    Ok(())
+}
diff --git a/crates/gpu-owner/src/evidence.rs b/crates/gpu-owner/src/evidence.rs
new file mode 100644
index 000000000..09c00ccd4
--- /dev/null
+++ b/crates/gpu-owner/src/evidence.rs
@@ -0,0 +1,132 @@
+// SPEC: _spec/gpu-owner.md
+use crate::{OwnerError, Result, linux};
+use rustix::fs::{Mode, OFlags};
+use serde::Serialize;
+use std::{fs::File, io::Write, path::Path};
+
+pub const FILE_BYTES: u64 = 64 * 1024 * 1024;
+pub const ATTEMPT_BYTES: u64 = 512 * 1024 * 1024;
+pub const PACKET_BYTES: u64 = 4 * 1024 * 1024 * 1024;
+pub const ENTRIES: u64 = 16_384;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum Phase {
+    Working,
+    Cleanup,
+}
+
+pub struct Evidence {
+    root: File,
+    path: String,
+    identity: linux::Identity,
+    pub bytes: u64,
+    pub entries: u64,
+    pub failed: bool,
+}
+impl Evidence {
+    pub fn create(path: &str) -> Result<Self> {
+        crate::input::absolute(path)?;
+        let path = Path::new(path);
+        let parent = path
+            .parent()
+            .and_then(Path::to_str)
+            .ok_or(OwnerError("EVIDENCE_PARENT"))?;
+        let parent = linux::open_directory(parent)?;
+        let leaf = path.file_name().ok_or(OwnerError("EVIDENCE_NAME"))?;
+        rustix::fs::mkdirat(&parent, leaf, Mode::from_bits_truncate(0o700))
+            .map_err(|_| OwnerError("EVIDENCE_EXCLUSIVE"))?;
+        let root = File::from(
+            rustix::fs::openat(
+                &parent,
+                leaf,
+                OFlags::RDONLY | OFlags::DIRECTORY | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+                Mode::empty(),
+            )
+            .map_err(|_| OwnerError("EVIDENCE_OPEN"))?,
+        );
+        let identity = linux::Identity::of(&root)?;
+        Ok(Self {
+            root,
+            path: path.to_str().ok_or(OwnerError("EVIDENCE_PATH"))?.into(),
+            identity,
+            bytes: 0,
+            entries: 1,
+            failed: false,
+        })
+    }
+    pub fn write(&mut self, name: &str, bytes: &[u8], phase: Phase) -> Result<()> {
+        if self.failed {
+            return if phase == Phase::Cleanup {
+                Ok(())
+            } else {
+                Err(OwnerError("EVIDENCE_FAILED"))
+            };
+        }
+        let result = self.write_inner(name, bytes);
+        if result.is_err() {
+            self.failed = true;
+        }
+        result
+    }
+    fn write_inner(&mut self, name: &str, bytes: &[u8]) -> Result<()> {
+        if linux::Identity::of(&self.root)? != self.identity
+            || linux::Identity::of(
+                &linux::open_directory(&self.path).map_err(|_| OwnerError("EVIDENCE_PATH"))?,
+            )? != self.identity
+        {
+            return Err(OwnerError("EVIDENCE_REPLACED"));
+        }
+        if name.is_empty()
+            || name.len() > 128
+            || !name
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"._-".contains(&b))
+        {
+            return Err(OwnerError("EVIDENCE_NAME"));
+        }
+        let length = bytes.len() as u64;
+        if length > FILE_BYTES
+            || self
+                .bytes
+                .checked_add(length)
+                .is_none_or(|n| n > ATTEMPT_BYTES || n > PACKET_BYTES)
+            || self.entries >= ENTRIES
+        {
+            return Err(OwnerError("EVIDENCE_BOUND"));
+        }
+        self.bytes += length;
+        self.entries += 1;
+        let mut file = File::from(
+            rustix::fs::openat(
+                &self.root,
+                name,
+                OFlags::WRONLY | OFlags::CREATE | OFlags::EXCL | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+                Mode::from_bits_truncate(0o600),
+            )
+            .map_err(|_| OwnerError("EVIDENCE_OPEN"))?,
+        );
+        file.write_all(bytes)
+            .map_err(|_| OwnerError("EVIDENCE_WRITE"))?;
+        file.sync_all().map_err(|_| OwnerError("EVIDENCE_SYNC"))?;
+        self.root
+            .sync_all()
+            .map_err(|_| OwnerError("EVIDENCE_SYNC"))
+    }
+    pub fn json<T: Serialize>(&mut self, name: &str, value: &T, phase: Phase) -> Result<()> {
+        if self.failed {
+            return if phase == Phase::Cleanup {
+                Ok(())
+            } else {
+                Err(OwnerError("EVIDENCE_FAILED"))
+            };
+        }
+        let bytes = match serde_json::to_vec(value) {
+            Ok(v) => v,
+            Err(_) => {
+                self.failed = true;
+                return Err(OwnerError("EVIDENCE_SERIALIZE"));
+            }
+        };
+        self.write(name, &bytes, phase)
+    }
+}
diff --git a/crates/gpu-owner/src/input.rs b/crates/gpu-owner/src/input.rs
new file mode 100644
index 000000000..7e8fa5276
--- /dev/null
+++ b/crates/gpu-owner/src/input.rs
@@ -0,0 +1,442 @@
+// SPEC: _spec/gpu-owner.md
+use crate::{
+    OwnerError, Result,
+    json::{self, Decimal},
+    policy::{Configuration, valid_config},
+};
+use serde::{Deserialize, Serialize};
+use std::path::{Component, Path};
+
+pub const FILE_BOUND: u64 = 512 * 1024 * 1024;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ByteRef {
+    #[serde(deserialize_with = "json::safe_u64")]
+    pub byte_length: u64,
+    pub sha256: String,
+}
+
+impl ByteRef {
+    pub fn validate(&self) -> Result<()> {
+        if self.byte_length > json::SAFE_INTEGER || !json::digest(&self.sha256) {
+            return Err(OwnerError("BYTE_REF"));
+        }
+        Ok(())
+    }
+    pub fn matches(&self, bytes: &[u8]) -> bool {
+        self.byte_length == bytes.len() as u64 && self.sha256 == json::sha256(bytes)
+    }
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct FileExpectation {
+    pub path: String,
+    #[serde(deserialize_with = "json::safe_u64")]
+    pub byte_length: u64,
+    pub sha256: String,
+}
+
+impl FileExpectation {
+    pub fn identity(&self) -> ByteRef {
+        ByteRef {
+            byte_length: self.byte_length,
+            sha256: self.sha256.clone(),
+        }
+    }
+    pub fn validate(&self) -> Result<()> {
+        absolute(&self.path)?;
+        if self.byte_length > FILE_BOUND {
+            return Err(OwnerError("FILE_BOUND"));
+        }
+        self.identity().validate()
+    }
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Envelope {
+    #[serde(deserialize_with = "json::u32_list")]
+    pub cpus: Vec<u32>,
+    #[serde(deserialize_with = "json::safe_u64")]
+    pub cpu_quota: u64,
+    pub memory_max_bytes: Decimal,
+    pub aggregate_parent: String,
+    #[serde(deserialize_with = "json::u32_list")]
+    pub aggregate_cpus: Vec<u32>,
+    #[serde(deserialize_with = "json::safe_u64")]
+    pub aggregate_cpu_quota: u64,
+    pub aggregate_memory_max_bytes: Decimal,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Ownership {
+    pub session_id: String,
+    pub attempt_id: String,
+    pub container_name: String,
+    pub ownership_token: String,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct OutsideControl {
+    pub admission_receipt: FileExpectation,
+    pub expected_self_envelope: Envelope,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct DockerInput {
+    pub executable: FileExpectation,
+    pub anonymous_config_directory: String,
+    pub endpoint_unix_socket: String,
+    pub cgroup_parent_argument: String,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ObservationInput {
+    pub proc_root: String,
+    pub cgroup_root: String,
+    pub approved_job_parent_absolute_path: String,
+    pub expected_outside_control_cgroup_absolute_path: String,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct GpuProfile {
+    pub mode: String,
+    #[serde(deserialize_with = "json::u32_list")]
+    pub cpus: Vec<u32>,
+    pub injection_inventory: FileExpectation,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct JobInput {
+    pub image_id: String,
+    pub runtime_closure: FileExpectation,
+    pub gpu_profile: GpuProfile,
+    pub state_host_source: String,
+    pub job_input_json: String,
+    pub job_input_ref: ByteRef,
+    pub expected_descriptor_sha256: String,
+    pub initial_model_id: String,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct TelemetryInput {
+    pub kind: String,
+    pub executable: FileExpectation,
+    pub runtime_closure: FileExpectation,
+    pub expected_driver: String,
+    pub query_budget_ns: Decimal,
+    pub refresh_interval_ns: Decimal,
+    pub scheduling_reserve_ns: Decimal,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct EvidenceInput {
+    pub exclusive_packet_root: String,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ClosedOwnerInput {
+    pub version: String,
+    pub ownership: Ownership,
+    pub outside_control: OutsideControl,
+    pub docker: DockerInput,
+    pub observation: ObservationInput,
+    pub job: JobInput,
+    pub cooperative: Configuration,
+    pub telemetry: TelemetryInput,
+    pub evidence: EvidenceInput,
+}
+
+pub type OwnerInput = ClosedOwnerInput;
+
+pub fn absolute(value: &str) -> Result<()> {
+    if value.len() > 4096
+        || value.contains('\0')
+        || value == "/"
+        || !value.starts_with('/')
+        || value.ends_with('/')
+        || value.contains("//")
+        || value
+            .split('/')
+            .skip(1)
+            .any(|p| p == "." || p == ".." || p.is_empty())
+        || Path::new(value)
+            .components()
+            .any(|c| !matches!(c, Component::RootDir | Component::Normal(_)))
+    {
+        return Err(OwnerError("ABSOLUTE_PATH"));
+    }
+    Ok(())
+}
+
+pub fn below(path: &str, parent: &str) -> bool {
+    path.strip_prefix(parent)
+        .is_some_and(|tail| tail.starts_with('/') && tail.len() > 1)
+}
+
+pub fn cpus(values: &[u32]) -> bool {
+    !values.is_empty() && values.len() <= 12 && values.windows(2).all(|w| w[0] < w[1])
+}
+
+impl ClosedOwnerInput {
+    pub fn parse(bytes: &[u8], expected_sha256: &str) -> Result<Self> {
+        if bytes.len() > 262_144 {
+            return Err(OwnerError("MANIFEST_BOUND"));
+        }
+        if !json::digest(expected_sha256) || json::sha256(bytes) != expected_sha256 {
+            return Err(OwnerError("MANIFEST_SHA256"));
+        }
+        let input: Self = json::decode(bytes, 262_144)?;
+        input.validate()?;
+        Ok(input)
+    }
+    pub fn validate(&self) -> Result<()> {
+        let o = &self.ownership;
+        if self.version != "chess-coach.gpu-owner.v1"
+            || !json::identifier(&o.session_id, 64)
+            || !json::identifier(&o.attempt_id, 32)
+            || !json::identifier(&o.container_name, 128)
+            || !o.container_name.as_bytes()[0].is_ascii_alphanumeric()
+            || o.ownership_token.len() != 32
+            || !o
+                .ownership_token
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        {
+            return Err(OwnerError("OWNERSHIP"));
+        }
+        for file in [
+            &self.outside_control.admission_receipt,
+            &self.docker.executable,
+            &self.job.runtime_closure,
+            &self.job.gpu_profile.injection_inventory,
+            &self.telemetry.executable,
+            &self.telemetry.runtime_closure,
+        ] {
+            file.validate()?;
+        }
+        for path in [
+            &self.docker.anonymous_config_directory,
+            &self.docker.endpoint_unix_socket,
+            &self.observation.proc_root,
+            &self.observation.cgroup_root,
+            &self.observation.approved_job_parent_absolute_path,
+            &self
+                .observation
+                .expected_outside_control_cgroup_absolute_path,
+            &self.job.state_host_source,
+            &self.evidence.exclusive_packet_root,
+            &self.outside_control.expected_self_envelope.aggregate_parent,
+        ] {
+            absolute(path)?;
+        }
+        if self.evidence.exclusive_packet_root == self.job.state_host_source
+            || below(
+                &self.evidence.exclusive_packet_root,
+                &self.job.state_host_source,
+            )
+        {
+            return Err(OwnerError("EVIDENCE_STATE_OVERLAP"));
+        }
+        let slice = &self.docker.cgroup_parent_argument;
+        if !slice.ends_with(".slice")
+            || slice.len() > 128
+            || !slice
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"_.-".contains(&b))
+        {
+            return Err(OwnerError("CGROUP_ARGUMENT"));
+        }
+        let obs = &self.observation;
+        if obs.approved_job_parent_absolute_path
+            == obs.expected_outside_control_cgroup_absolute_path
+            || below(
+                &obs.approved_job_parent_absolute_path,
+                &obs.expected_outside_control_cgroup_absolute_path,
+            )
+            || below(
+                &obs.expected_outside_control_cgroup_absolute_path,
+                &obs.approved_job_parent_absolute_path,
+            )
+        {
+            return Err(OwnerError("CONTROL_OVERLAP"));
+        }
+        let e = &self.outside_control.expected_self_envelope;
+        let job_cpus = &self.job.gpu_profile.cpus;
+        if !cpus(&e.cpus)
+            || !cpus(&e.aggregate_cpus)
+            || !cpus(job_cpus)
+            || job_cpus.len() != 4
+            || !e
+                .cpus
+                .iter()
+                .chain(job_cpus)
+                .all(|c| e.aggregate_cpus.contains(c))
+            || e.cpus.iter().any(|c| job_cpus.contains(c))
+            || e.cpu_quota == 0
+            || e.aggregate_cpu_quota > 1_200_000
+            || e.cpu_quota.saturating_add(400_000) > e.aggregate_cpu_quota
+            || e.memory_max_bytes.0 <= 0
+            || e.aggregate_memory_max_bytes.0 > 24_000_000_000
+            || i128::from(e.memory_max_bytes.0) + 8_589_934_592
+                > i128::from(e.aggregate_memory_max_bytes.0)
+            || !below(
+                &obs.expected_outside_control_cgroup_absolute_path,
+                &e.aggregate_parent,
+            )
+            || !(below(&obs.approved_job_parent_absolute_path, &e.aggregate_parent)
+                || obs.approved_job_parent_absolute_path == e.aggregate_parent)
+        {
+            return Err(OwnerError("ENVELOPE"));
+        }
+        let job = &self.job;
+        if job.state_host_source.contains(',')
+            || !job.image_id.starts_with("sha256:")
+            || !json::digest(&job.image_id[7..])
+            || job.gpu_profile.mode != "legacy-nvidia-device-request.v1"
+            || job.job_input_json.len() > 65_536
+            || !job.job_input_ref.matches(job.job_input_json.as_bytes())
+            || !json::digest(&job.expected_descriptor_sha256)
+            || !json::digest(&job.initial_model_id)
+        {
+            return Err(OwnerError("JOB_INPUT"));
+        }
+        job.job_input_ref.validate()?;
+        let t = &self.telemetry;
+        if !valid_config(&self.cooperative)
+            || t.kind != "registered-nvidia-smi-query.v1"
+            || t.expected_driver.is_empty()
+            || t.expected_driver.len() > 128
+            || !t
+                .expected_driver
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"._-".contains(&b))
+            || t.query_budget_ns.0 <= 0
+            || t.refresh_interval_ns.0 <= 0
+            || t.scheduling_reserve_ns.0 <= 0
+            || i128::from(t.query_budget_ns.0)
+                + i128::from(t.refresh_interval_ns.0)
+                + i128::from(t.scheduling_reserve_ns.0)
+                >= i128::from(self.cooperative.sample_period_ns.0)
+        {
+            return Err(OwnerError("TELEMETRY_CONFIGURATION"));
+        }
+        Ok(())
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Admission {
+    pub version: String,
+    pub expected_self_envelope: Envelope,
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RuntimeClosure {
+    pub version: String,
+    pub image_id: String,
+    pub selected_uuid: String,
+    pub profile_mode: String,
+    pub input_sha256: String,
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct TelemetryClosure {
+    pub version: String,
+    pub executable: ByteRef,
+    pub expected_driver: String,
+    pub selected_uuid: String,
+}
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Library {
+    pub container_path: String,
+    pub bytes: ByteRef,
+}
+#[derive(Clone, Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct InspectMount {
+    pub kind: String,
+    pub source: String,
+    pub destination: String,
+    pub writable: bool,
+    pub propagation: String,
+}
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Injection {
+    pub version: String,
+    pub mode: String,
+    pub selected_uuid: String,
+    pub devices: Vec<String>,
+    pub libraries: Vec<Library>,
+    pub inspect_mounts: Vec<InspectMount>,
+}
+
+impl Injection {
+    pub fn validate(&self, uuid: &str) -> Result<()> {
+        if self.version != "chess-coach.gpu-injection.v1"
+            || self.mode != "legacy"
+            || self.selected_uuid != uuid
+            || self.devices.is_empty()
+            || self.devices.len() > 16
+            || self.libraries.is_empty()
+            || self.libraries.len() > 256
+            || self.inspect_mounts.len() > 256
+        {
+            return Err(OwnerError("INJECTION"));
+        }
+        let mut devices = std::collections::HashSet::new();
+        for path in &self.devices {
+            absolute(path)?;
+            if !path.starts_with("/dev/nvidia") || path[11..].contains('/') || !devices.insert(path)
+            {
+                return Err(OwnerError("INJECTION_DEVICE"));
+            }
+        }
+        let mut paths = std::collections::HashSet::new();
+        for lib in &self.libraries {
+            absolute(&lib.container_path)?;
+            lib.bytes.validate()?;
+            if lib.bytes.byte_length == 0 || !paths.insert(&lib.container_path) {
+                return Err(OwnerError("INJECTION_LIBRARY"));
+            }
+        }
+        if !self
+            .libraries
+            .iter()
+            .any(|l| l.container_path.ends_with("/libcuda.so.1"))
+        {
+            return Err(OwnerError("INJECTION_LIBCUDA"));
+        }
+        let mut destinations = std::collections::HashSet::new();
+        for m in &self.inspect_mounts {
+            absolute(&m.source)?;
+            absolute(&m.destination)?;
+            if m.kind != "bind"
+                || m.writable
+                || m.propagation != "rprivate"
+                || !paths.contains(&m.destination)
+                || !destinations.insert(&m.destination)
+                || ["/state", "/tmp", "/home", "/root", "/run", "/var"]
+                    .iter()
+                    .any(|p| m.destination == *p || below(&m.destination, p))
+            {
+                return Err(OwnerError("INJECTION_MOUNT"));
+            }
+        }
+        Ok(())
+    }
+}
diff --git a/crates/gpu-owner/src/json.rs b/crates/gpu-owner/src/json.rs
new file mode 100644
index 000000000..53a083ba1
--- /dev/null
+++ b/crates/gpu-owner/src/json.rs
@@ -0,0 +1,313 @@
+// SPEC: _spec/gpu-owner.md
+use crate::{OwnerError, Result};
+use serde::de::{DeserializeOwned, DeserializeSeed, MapAccess, SeqAccess, Visitor};
+use serde::{Deserialize, Deserializer};
+use serde_json::value::RawValue;
+use sha2::{Digest, Sha256};
+use std::{collections::HashSet, fmt};
+
+pub const SAFE_INTEGER: u64 = 9_007_199_254_740_991;
+
+pub fn sha256(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+pub fn digest(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+
+pub fn identifier(value: &str, max: usize) -> bool {
+    !value.is_empty()
+        && value.len() <= max
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"._:-".contains(&b))
+}
+
+pub fn decode<'a, T: Deserialize<'a>>(bytes: &'a [u8], bound: usize) -> Result<T> {
+    validate(bytes, bound)?;
+    serde_json::from_slice(bytes).map_err(|_| OwnerError("JSON_SCHEMA"))
+}
+
+pub fn validate(bytes: &[u8], bound: usize) -> Result<()> {
+    if bytes.len() > bound || std::str::from_utf8(bytes).is_err() {
+        return Err(OwnerError("JSON_BOUND"));
+    }
+    let mut deserializer = serde_json::Deserializer::from_slice(bytes);
+    let mut entries = 0;
+    Unique {
+        depth: 0,
+        entries: &mut entries,
+    }
+    .deserialize(&mut deserializer)
+    .map_err(|_| OwnerError("JSON_UNIQUE"))?;
+    deserializer.end().map_err(|_| OwnerError("JSON_TRAILING"))
+}
+
+struct Unique<'a> {
+    depth: usize,
+    entries: &'a mut usize,
+}
+
+impl<'de> DeserializeSeed<'de> for Unique<'_> {
+    type Value = ();
+    fn deserialize<D: Deserializer<'de>>(
+        self,
+        deserializer: D,
+    ) -> std::result::Result<(), D::Error> {
+        *self.entries += 1;
+        if self.depth > 32 || *self.entries > 16_384 {
+            return Err(serde::de::Error::custom("depth"));
+        }
+        deserializer.deserialize_any(self)
+    }
+}
+
+impl<'de> Visitor<'de> for Unique<'_> {
+    type Value = ();
+    fn expecting(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("bounded unique JSON")
+    }
+    fn visit_bool<E: serde::de::Error>(self, _: bool) -> std::result::Result<(), E> {
+        Ok(())
+    }
+    fn visit_i64<E: serde::de::Error>(self, value: i64) -> std::result::Result<(), E> {
+        if value.unsigned_abs() > SAFE_INTEGER {
+            return Err(E::custom("safe integer"));
+        }
+        Ok(())
+    }
+    fn visit_u64<E: serde::de::Error>(self, value: u64) -> std::result::Result<(), E> {
+        if value > SAFE_INTEGER {
+            return Err(E::custom("safe integer"));
+        }
+        Ok(())
+    }
+    fn visit_f64<E: serde::de::Error>(self, value: f64) -> std::result::Result<(), E> {
+        if !value.is_finite() || (value.fract() == 0.0 && value.abs() > SAFE_INTEGER as f64) {
+            return Err(E::custom("safe number"));
+        }
+        Ok(())
+    }
+    fn visit_str<E: serde::de::Error>(self, _: &str) -> std::result::Result<(), E> {
+        Ok(())
+    }
+    fn visit_unit<E: serde::de::Error>(self) -> std::result::Result<(), E> {
+        Ok(())
+    }
+    fn visit_none<E: serde::de::Error>(self) -> std::result::Result<(), E> {
+        Ok(())
+    }
+    fn visit_seq<A: SeqAccess<'de>>(self, mut seq: A) -> std::result::Result<(), A::Error> {
+        loop {
+            let value = seq.next_element_seed(Unique {
+                depth: self.depth + 1,
+                entries: self.entries,
+            })?;
+            if value.is_none() {
+                return Ok(());
+            }
+        }
+    }
+    fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> std::result::Result<(), A::Error> {
+        let mut seen = HashSet::new();
+        while let Some(key) = map.next_key::<String>()? {
+            *self.entries += 1;
+            if *self.entries > 16_384 || !seen.insert(key) {
+                return Err(serde::de::Error::custom("duplicate or entries"));
+            }
+            map.next_value_seed(Unique {
+                depth: self.depth + 1,
+                entries: self.entries,
+            })?;
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub struct Decimal(pub i64);
+
+impl serde::Serialize for Decimal {
+    fn serialize<S: serde::Serializer>(
+        &self,
+        serializer: S,
+    ) -> std::result::Result<S::Ok, S::Error> {
+        if self.0 < 0 {
+            return Err(serde::ser::Error::custom("unsigned decimal"));
+        }
+        serializer.serialize_str(&self.0.to_string())
+    }
+}
+
+impl<'de> Deserialize<'de> for Decimal {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> std::result::Result<Self, D::Error> {
+        let value = String::deserialize(deserializer)?;
+        if value.is_empty()
+            || value.len() > 19
+            || (value.len() > 1 && value.starts_with('0'))
+            || !value.bytes().all(|b| b.is_ascii_digit())
+        {
+            return Err(serde::de::Error::custom("canonical decimal"));
+        }
+        value
+            .parse::<i64>()
+            .map(Decimal)
+            .map_err(serde::de::Error::custom)
+    }
+}
+
+pub fn integer<'de, D: Deserializer<'de>, T: DeserializeOwned>(
+    deserializer: D,
+) -> std::result::Result<T, D::Error> {
+    let raw = Box::<RawValue>::deserialize(deserializer)?;
+    serde_json::from_str(if raw.get() == "-0" { "0" } else { raw.get() })
+        .map_err(serde::de::Error::custom)
+}
+
+struct LexicalU32(u32);
+
+impl<'de> Deserialize<'de> for LexicalU32 {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> std::result::Result<Self, D::Error> {
+        integer(deserializer).map(Self)
+    }
+}
+
+pub fn u32_list<'de, D: Deserializer<'de>>(
+    deserializer: D,
+) -> std::result::Result<Vec<u32>, D::Error> {
+    Vec::<LexicalU32>::deserialize(deserializer)
+        .map(|values| values.into_iter().map(|value| value.0).collect())
+}
+
+pub fn optional_u32<'de, D: Deserializer<'de>>(
+    deserializer: D,
+) -> std::result::Result<Option<u32>, D::Error> {
+    Option::<LexicalU32>::deserialize(deserializer).map(|value| value.map(|value| value.0))
+}
+
+pub fn safe_u64<'de, D: Deserializer<'de>>(deserializer: D) -> std::result::Result<u64, D::Error> {
+    let value: u64 = integer(deserializer)?;
+    if value > SAFE_INTEGER {
+        return Err(serde::de::Error::custom("safe integer"));
+    }
+    Ok(value)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[derive(Debug, Deserialize, PartialEq)]
+    struct U32(#[serde(deserialize_with = "integer")] u32);
+    #[derive(Debug, Deserialize, PartialEq)]
+    struct I32(#[serde(deserialize_with = "integer")] i32);
+    #[derive(Debug, Deserialize, PartialEq)]
+    struct U64(#[serde(deserialize_with = "integer")] u64);
+    #[derive(Debug, Deserialize, PartialEq)]
+    struct SafeU64(#[serde(deserialize_with = "safe_u64")] u64);
+    #[derive(Debug, Deserialize, PartialEq)]
+    #[serde(deny_unknown_fields)]
+    struct Collection {
+        #[serde(deserialize_with = "u32_list")]
+        values: Vec<u32>,
+        #[serde(deserialize_with = "optional_u32")]
+        nullable: Option<u32>,
+    }
+
+    #[test]
+    fn lexical_integer_normalizes_only_the_exact_negative_zero_token() {
+        assert_eq!(serde_json::from_str::<U32>("-0").unwrap(), U32(0));
+        assert_eq!(serde_json::from_str::<I32>("-0").unwrap(), I32(0));
+        assert_eq!(serde_json::from_str::<U64>("-0").unwrap(), U64(0));
+        assert_eq!(serde_json::from_str::<I32>("-12").unwrap(), I32(-12));
+        for token in [
+            "-0.0", "-0e0", "0.0", "0e0", "1.0", "1e0", "true", "null", "\"0\"", "\"-0\"",
+        ] {
+            assert!(serde_json::from_str::<U32>(token).is_err(), "u32 {token}");
+            assert!(serde_json::from_str::<I32>(token).is_err(), "i32 {token}");
+            assert!(serde_json::from_str::<U64>(token).is_err(), "u64 {token}");
+        }
+        assert!(serde_json::from_str::<U32>("-1").is_err());
+        assert!(serde_json::from_str::<U64>("-1").is_err());
+        assert_eq!(
+            serde_json::from_str::<U32>("4294967295").unwrap(),
+            U32(u32::MAX)
+        );
+        assert!(serde_json::from_str::<U32>("4294967296").is_err());
+        assert_eq!(
+            serde_json::from_str::<I32>("2147483647").unwrap(),
+            I32(i32::MAX)
+        );
+        assert_eq!(
+            serde_json::from_str::<I32>("-2147483648").unwrap(),
+            I32(i32::MIN)
+        );
+        assert!(serde_json::from_str::<I32>("2147483648").is_err());
+        assert!(serde_json::from_str::<I32>("-2147483649").is_err());
+        assert_eq!(
+            serde_json::from_str::<U64>("18446744073709551615").unwrap(),
+            U64(u64::MAX)
+        );
+        assert!(serde_json::from_str::<U64>("18446744073709551616").is_err());
+    }
+
+    #[test]
+    fn safe_integer_ceiling_and_decimal_strings_keep_their_original_contracts() {
+        assert_eq!(serde_json::from_str::<SafeU64>("-0").unwrap(), SafeU64(0));
+        assert_eq!(
+            serde_json::from_str::<SafeU64>("9007199254740991").unwrap(),
+            SafeU64(SAFE_INTEGER)
+        );
+        assert!(serde_json::from_str::<SafeU64>("9007199254740992").is_err());
+        assert!(decode::<SafeU64>(b"9007199254740992", 64).is_err());
+        for token in ["-0.0", "-0e0", "1.0", "1e0", "-1", "true", "\"0\""] {
+            assert!(serde_json::from_str::<SafeU64>(token).is_err(), "{token}");
+        }
+        assert!(serde_json::from_str::<Decimal>("-0").is_err());
+        assert!(serde_json::from_str::<Decimal>("\"-0\"").is_err());
+        assert_eq!(
+            serde_json::from_str::<Decimal>("\"0\"").unwrap(),
+            Decimal(0)
+        );
+    }
+
+    #[test]
+    fn list_elements_and_required_nullable_values_use_lexical_integers() {
+        assert_eq!(
+            serde_json::from_str::<Collection>(r#"{"values":[-0,1,4294967295],"nullable":-0}"#)
+                .unwrap(),
+            Collection {
+                values: vec![0, 1, u32::MAX],
+                nullable: Some(0)
+            }
+        );
+        assert_eq!(
+            serde_json::from_str::<Collection>(r#"{"values":[],"nullable":null}"#).unwrap(),
+            Collection {
+                values: vec![],
+                nullable: None
+            }
+        );
+        for text in [
+            r#"{"values":[]}"#,
+            r#"{"nullable":null}"#,
+            r#"{"values":[-0.0],"nullable":null}"#,
+            r#"{"values":[-0e0],"nullable":null}"#,
+            r#"{"values":[1.0],"nullable":null}"#,
+            r#"{"values":[1e0],"nullable":null}"#,
+            r#"{"values":[-1],"nullable":null}"#,
+            r#"{"values":[4294967296],"nullable":null}"#,
+            r#"{"values":[],"nullable":-0.0}"#,
+            r#"{"values":[],"nullable":-0e0}"#,
+            r#"{"values":[],"nullable":1e0}"#,
+            r#"{"values":[],"nullable":4294967296}"#,
+            r#"{"values":[],"nullable":true}"#,
+        ] {
+            assert!(serde_json::from_str::<Collection>(text).is_err(), "{text}");
+        }
+    }
+}
