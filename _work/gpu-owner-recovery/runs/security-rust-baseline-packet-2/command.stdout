+// SPEC: _spec/gpu-owner.md
+
+fn main() {
+    let mut args = std::env::args_os().skip(1);
+    if args.next().as_deref() == Some(std::ffi::OsStr::new("--help")) && args.next().is_none() {
+        println!("host-gpu-owner --help\nSource-only recovery. Operational entrypoint disabled.");
+        return;
+    }
+    eprintln!("SOURCE_ONLY_DISABLED");
+    std::process::exit(2);
+}
diff --git a/crates/gpu-owner/src/observe.rs b/crates/gpu-owner/src/observe.rs
new file mode 100644
index 000000000..871e76d18
--- /dev/null
+++ b/crates/gpu-owner/src/observe.rs
@@ -0,0 +1,417 @@
+// SPEC: _spec/gpu-owner.md
+use crate::{
+    OwnerError, Result,
+    input::{self, OwnerInput},
+    linux::{self, Identity},
+};
+use std::{
+    collections::{BTreeSet, VecDeque},
+    fs::File,
+    os::{fd::AsRawFd, unix::fs::MetadataExt},
+};
+
+pub fn parse_cpuset(value: &str) -> Result<Vec<u32>> {
+    let value = value.trim_end_matches('\n');
+    if value.is_empty() {
+        return Err(OwnerError("CPUSET"));
+    }
+    let mut cpus = BTreeSet::new();
+    for part in value.split(',') {
+        let mut range = part.split('-');
+        let first = integer(range.next().ok_or(OwnerError("CPUSET"))?)?;
+        let last = match range.next() {
+            Some(s) => integer(s)?,
+            None => first,
+        };
+        if range.next().is_some() || first > last || last > u32::MAX as u64 || last - first > 4096 {
+            return Err(OwnerError("CPUSET"));
+        }
+        for cpu in first..=last {
+            if !cpus.insert(cpu as u32) || cpus.len() > 4096 {
+                return Err(OwnerError("CPUSET"));
+            }
+        }
+    }
+    Ok(cpus.into_iter().collect())
+}
+
+fn integer(value: &str) -> Result<u64> {
+    if value.is_empty()
+        || (value.len() > 1 && value.starts_with('0'))
+        || !value.bytes().all(|b| b.is_ascii_digit())
+    {
+        return Err(OwnerError("CGROUP_INTEGER"));
+    }
+    value.parse().map_err(|_| OwnerError("CGROUP_INTEGER"))
+}
+fn text(path: &str) -> Result<String> {
+    String::from_utf8(linux::read_bounded(path, 65536)?).map_err(|_| OwnerError("CGROUP_UTF8"))
+}
+fn scalar(path: &str, name: &str) -> Result<u64> {
+    integer(text(&format!("{path}/{name}"))?.trim_end_matches('\n'))
+}
+fn quota(path: &str) -> Result<(u64, u64)> {
+    let text = text(&format!("{path}/cpu.max"))?;
+    let parts: Vec<_> = text.trim_end_matches('\n').split(' ').collect();
+    if parts.len() != 2 {
+        return Err(OwnerError("CGROUP_CPU_MAX"));
+    }
+    let period = integer(parts[1])?;
+    if period == 0 {
+        return Err(OwnerError("CGROUP_CPU_MAX"));
+    }
+    let quota = if parts[0] == "max" {
+        u64::MAX
+    } else {
+        integer(parts[0])?
+    };
+    if quota == 0 {
+        return Err(OwnerError("CGROUP_CPU_MAX"));
+    }
+    Ok((quota, period))
+}
+fn memory(path: &str) -> Result<u64> {
+    let value = text(&format!("{path}/memory.max"))?;
+    if value == "max\n" || value == "max" {
+        Ok(u64::MAX)
+    } else {
+        integer(value.trim_end_matches('\n'))
+    }
+}
+fn effective(path: &str) -> Result<Vec<u32>> {
+    parse_cpuset(&text(&format!("{path}/cpuset.cpus.effective"))?)
+}
+
+fn membership(proc_root: &str, pid: u32) -> Result<String> {
+    let value = text(&format!("{proc_root}/{pid}/cgroup"))?;
+    if !value.ends_with('\n') || value[..value.len() - 1].contains('\n') {
+        return Err(OwnerError("PROC_CGROUP"));
+    }
+    let path = value
+        .strip_prefix("0::")
+        .and_then(|v| v.strip_suffix('\n'))
+        .ok_or(OwnerError("PROC_CGROUP"))?;
+    input::absolute(path)?;
+    Ok(path.into())
+}
+
+struct Bound {
+    path: String,
+    file: File,
+    identity: Identity,
+    ancestors: Vec<(String, File, Identity)>,
+}
+impl Bound {
+    fn stable(&self) -> Result<()> {
+        if Identity::of(&self.file)? != self.identity {
+            return Err(OwnerError("C8_REPLACED"));
+        }
+        for (path, file, identity) in &self.ancestors {
+            if Identity::of(file)? != *identity
+                || Identity::of(&linux::open_directory(path)?)? != *identity
+            {
+                return Err(OwnerError("C8_REPLACED"));
+            }
+        }
+        Ok(())
+    }
+    fn present(&self) -> Result<()> {
+        self.stable()?;
+        if Identity::of(&linux::open_directory(&self.path)?)? != self.identity {
+            return Err(OwnerError("C8_REPLACED"));
+        }
+        self.stable()
+    }
+}
+
+pub struct Observer {
+    proc_root: String,
+    cgroup_root: String,
+    parent: String,
+    outside: String,
+    aggregate: String,
+    roots: Vec<(String, File, Identity)>,
+    bound: Option<Bound>,
+}
+impl Observer {
+    pub fn new(input: &OwnerInput) -> Result<Self> {
+        let o = &input.observation;
+        let aggregate = &input
+            .outside_control
+            .expected_self_envelope
+            .aggregate_parent;
+        if !input::below(&o.approved_job_parent_absolute_path, &o.cgroup_root)
+            || !input::below(
+                &o.expected_outside_control_cgroup_absolute_path,
+                &o.cgroup_root,
+            )
+            || !(input::below(aggregate, &o.cgroup_root) || aggregate == &o.cgroup_root)
+        {
+            return Err(OwnerError("OBSERVATION_PATH"));
+        }
+        let mut roots = Vec::new();
+        for path in [
+            &o.proc_root,
+            &o.cgroup_root,
+            &o.approved_job_parent_absolute_path,
+            aggregate,
+            &o.expected_outside_control_cgroup_absolute_path,
+        ] {
+            let file = linux::open_directory(path)?;
+            let identity = Identity::of(&file)?;
+            roots.push((path.clone(), file, identity));
+        }
+        let observer = Self {
+            proc_root: o.proc_root.clone(),
+            cgroup_root: o.cgroup_root.clone(),
+            parent: o.approved_job_parent_absolute_path.clone(),
+            outside: o.expected_outside_control_cgroup_absolute_path.clone(),
+            aggregate: aggregate.clone(),
+            roots,
+            bound: None,
+        };
+        observer.check_outside(input)?;
+        Ok(observer)
+    }
+    pub fn stable(&self) -> Result<()> {
+        for (path, file, identity) in &self.roots {
+            if Identity::of(file)? != *identity
+                || Identity::of(&linux::open_directory(path)?)? != *identity
+            {
+                return Err(OwnerError("OBSERVATION_REPLACED"));
+            }
+        }
+        if let Some(bound) = &self.bound {
+            bound.stable()?;
+        }
+        Ok(())
+    }
+    fn host_path(&self, hierarchy: &str) -> String {
+        format!("{}{}", self.cgroup_root, hierarchy)
+    }
+    pub fn check_outside(&self, input: &OwnerInput) -> Result<()> {
+        self.stable()?;
+        if self.host_path(&membership(&self.proc_root, std::process::id())?) != self.outside {
+            return Err(OwnerError("OUTSIDE_MEMBERSHIP"));
+        }
+        let e = &input.outside_control.expected_self_envelope;
+        if effective(&self.outside)? != e.cpus
+            || quota(&self.outside)? != (e.cpu_quota, 100000)
+            || memory(&self.outside)? != e.memory_max_bytes.0 as u64
+            || effective(&self.aggregate)? != e.aggregate_cpus
+            || quota(&self.aggregate)? != (e.aggregate_cpu_quota, 100000)
+            || memory(&self.aggregate)? != e.aggregate_memory_max_bytes.0 as u64
+        {
+            return Err(OwnerError("OUTSIDE_ENVELOPE"));
+        }
+        self.stable()
+    }
+    pub fn bind(&mut self, pid: u32, input: &OwnerInput) -> Result<()> {
+        self.check_outside(input)?;
+        if pid == 0 {
+            return Err(OwnerError("C8_PID"));
+        }
+        let path = self.host_path(&membership(&self.proc_root, pid)?);
+        if !input::below(&path, &self.parent)
+            || input::below(&path, &self.outside)
+            || input::below(&self.outside, &path)
+        {
+            return Err(OwnerError("C8_PARENT"));
+        }
+        let mut ancestors = Vec::new();
+        let mut current = std::path::Path::new(&path)
+            .parent()
+            .ok_or(OwnerError("C8_ANCESTOR"))?;
+        while current != std::path::Path::new(&self.parent) {
+            let ancestor = current.to_str().ok_or(OwnerError("C8_ANCESTOR"))?;
+            if !input::below(ancestor, &self.parent) {
+                return Err(OwnerError("C8_PARENT"));
+            }
+            let file = linux::open_directory(ancestor)?;
+            let identity = Identity::of(&file)?;
+            ancestors.push((ancestor.to_owned(), file, identity));
+            current = current.parent().ok_or(OwnerError("C8_ANCESTOR"))?;
+        }
+        ancestors.reverse();
+        let file = linux::open_directory(&path)?;
+        let identity = Identity::of(&file)?;
+        if let Some(old) = &self.bound
+            && (old.path != path || old.identity != identity)
+        {
+            return Err(OwnerError("C8_REBOUND"));
+        }
+        let bound = Bound {
+            path,
+            file,
+            identity,
+            ancestors,
+        };
+        bound.present()?;
+        self.stable()?;
+        self.check_leaf(&bound.path, pid, input)?;
+        bound.present()?;
+        self.stable()?;
+        if self.bound.is_none() {
+            self.bound = Some(bound);
+        }
+        Ok(())
+    }
+    fn check_leaf(&self, path: &str, pid: u32, input: &OwnerInput) -> Result<()> {
+        if quota(path)? != (400000, 100000)
+            || memory(path)? != 8_589_934_592
+            || scalar(path, "memory.swap.max")? != 0
+            || scalar(path, "pids.max")? != 512
+            || effective(path)? != input.job.gpu_profile.cpus
+        {
+            return Err(OwnerError("C8_C2"));
+        }
+        let mut current = std::path::Path::new(path)
+            .parent()
+            .ok_or(OwnerError("C8_ANCESTOR"))?;
+        loop {
+            let ancestor = current.to_str().ok_or(OwnerError("C8_ANCESTOR"))?;
+            if !(ancestor == self.aggregate || input::below(ancestor, &self.aggregate)) {
+                return Err(OwnerError("C8_ANCESTOR"));
+            }
+            let (q, p) = quota(ancestor)?;
+            if u128::from(q) * 100000 < 400000 * u128::from(p)
+                || memory(ancestor)? < 8_589_934_592
+                || !input
+                    .job
+                    .gpu_profile
+                    .cpus
+                    .iter()
+                    .all(|cpu| effective(ancestor).is_ok_and(|cpus| cpus.contains(cpu)))
+            {
+                return Err(OwnerError("C8_STRICT_ANCESTOR"));
+            }
+            if ancestor == self.aggregate {
+                break;
+            }
+            current = current.parent().ok_or(OwnerError("C8_ANCESTOR"))?;
+        }
+        let mut queue = VecDeque::from([path.to_string()]);
+        let mut directories = 0usize;
+        let mut tasks = BTreeSet::new();
+        let mut processes = BTreeSet::new();
+        let mut found = false;
+        while let Some(path) = queue.pop_front() {
+            directories += 1;
+            if directories > 513 {
+                return Err(OwnerError("C8_DESCENDANTS"));
+            }
+            let file = linux::open_directory(&path)?;
+            for line in text(&format!("{path}/cgroup.procs"))?.lines() {
+                let task = integer(line)?;
+                if task == 0
+                    || task > u32::MAX as u64
+                    || !processes.insert(task)
+                    || processes.len() > 512
+                {
+                    return Err(OwnerError("C8_TASKS"));
+                }
+                if self.host_path(&membership(&self.proc_root, task as u32)?) != path {
+                    return Err(OwnerError("C8_TASK_MEMBERSHIP"));
+                }
+                if task == u64::from(pid) {
+                    found = true;
+                }
+            }
+            for line in text(&format!("{path}/cgroup.threads"))?.lines() {
+                let task = integer(line)?;
+                if task == 0 || task > u32::MAX as u64 || !tasks.insert(task) || tasks.len() > 512 {
+                    return Err(OwnerError("C8_TASKS"));
+                }
+                if self.host_path(&membership(&self.proc_root, task as u32)?) != path {
+                    return Err(OwnerError("C8_TASK_MEMBERSHIP"));
+                }
+            }
+            let entries = std::fs::read_dir(format!(
+                "/proc/{}/fd/{}",
+                std::process::id(),
+                file.as_raw_fd()
+            ))
+            .map_err(|_| OwnerError("C8_READ_DIR"))?;
+            let mut count = 0;
+            for entry in entries {
+                count += 1;
+                if count > 16384 {
+                    return Err(OwnerError("C8_ENTRIES"));
+                }
+                let entry = entry.map_err(|_| OwnerError("C8_READ_DIR"))?;
+                let kind = entry.file_type().map_err(|_| OwnerError("C8_READ_DIR"))?;
+                if kind.is_symlink() {
+                    return Err(OwnerError("C8_SYMLINK"));
+                }
+                if kind.is_dir() {
+                    let name = entry.file_name();
+                    let name = name.to_str().ok_or(OwnerError("C8_UTF8"))?;
+                    queue.push_back(format!("{path}/{name}"));
+                    if queue.len() + directories > 513 {
+                        return Err(OwnerError("C8_DESCENDANTS"));
+                    }
+                }
+            }
+        }
+        if !found || !tasks.contains(&u64::from(pid)) {
+            return Err(OwnerError("C8_INIT_MEMBERSHIP"));
+        }
+        Ok(())
+    }
+    pub fn bound_path(&self) -> Option<&str> {
+        self.bound.as_ref().map(|bound| bound.path.as_str())
+    }
+    pub fn gone(&self) -> Result<bool> {
+        self.stable()?;
+        let Some(bound) = &self.bound else {
+            return Ok(false);
+        };
+        let directory = match bound.ancestors.last() {
+            Some((_, file, _)) => file,
+            None => {
+                &self
+                    .roots
+                    .iter()
+                    .find(|(path, _, _)| path == &self.parent)
+                    .ok_or(OwnerError("C8_PARENT"))?
+                    .1
+            }
+        };
+        let name = bound
+            .path
+            .rsplit('/')
+            .next()
+            .ok_or(OwnerError("C8_PARENT"))?;
+        let gone = match rustix::fs::openat(
+            directory,
+            name,
+            rustix::fs::OFlags::RDONLY
+                | rustix::fs::OFlags::DIRECTORY
+                | rustix::fs::OFlags::NOFOLLOW
+                | rustix::fs::OFlags::CLOEXEC,
+            rustix::fs::Mode::empty(),
+        ) {
+            Ok(fd) => {
+                if Identity::of(&File::from(fd))? != bound.identity {
+                    return Err(OwnerError("C8_REPLACED"));
+                }
+                false
+            }
+            Err(rustix::io::Errno::NOENT) => {
+                if bound
+                    .file
+                    .metadata()
+                    .map_err(|_| OwnerError("C8_DISAPPEARANCE"))?
+                    .nlink()
+                    != 0
+                {
+                    return Err(OwnerError("C8_DISAPPEARANCE"));
+                }
+                true
+            }
+            Err(_) => return Err(OwnerError("C8_DISAPPEARANCE")),
+        };
+        self.stable()?;
+        Ok(gone)
+    }
+}
diff --git a/crates/gpu-owner/src/owner.rs b/crates/gpu-owner/src/owner.rs
new file mode 100644
index 000000000..51025ccb9
--- /dev/null
+++ b/crates/gpu-owner/src/owner.rs
@@ -0,0 +1,813 @@
+// SPEC: _spec/gpu-owner.md
+use crate::{
+    OwnerError, Result, docker,
+    evidence::{Evidence, Phase},
+    input::{self, Admission, Injection, OwnerInput, RuntimeClosure, TelemetryClosure},
+    json::{self, Decimal},
+    linux::{self, Boottime, Budget, Clock, Executable, LinuxWaiter, Waiter},
+    observe::Observer,
+    policy::Policy,
+    process::{Detached, Limits, Process},
+    telemetry,
+    wire::{self, AttemptInput, Receiver},
+};
+use serde::Serialize;
+use std::{cell::Cell, fs::File, io::Read, sync::Arc};
+
+#[derive(Clone, Debug)]
+pub struct RawLaunchRequest {
+    pub input_manifest: String,
+    pub expected_manifest_sha256: String,
+}
+
+#[derive(Debug, Serialize)]
+pub struct Report {
+    pub success: bool,
+    pub first_failure: Option<String>,
+    pub cleanup_errors: Vec<String>,
+    pub proposal_json: Option<String>,
+    pub cgroup_gone: bool,
+    pub all_helpers_reaped: bool,
+    #[serde(serialize_with = "serialize_origin")]
+    pub origin_ns: i64,
+    pub training_ready: bool,
+}
+fn serialize_origin<S: serde::Serializer>(
+    value: &i64,
+    serializer: S,
+) -> std::result::Result<S::Ok, S::Error> {
+    Decimal(*value).serialize(serializer)
+}
+impl Report {
+    fn new(origin_ns: i64) -> Self {
+        Self {
+            success: false,
+            first_failure: None,
+            cleanup_errors: Vec::new(),
+            proposal_json: None,
+            cgroup_gone: false,
+            all_helpers_reaped: true,
+            origin_ns,
+            training_ready: false,
+        }
+    }
+    fn fail(&mut self, error: OwnerError) {
+        if self.first_failure.is_none() {
+            self.first_failure = Some(error.0.into());
+        }
+    }
+    fn cleanup_fault(&mut self, error: OwnerError) {
+        self.fail(error);
+        if !self.cleanup_errors.iter().any(|reason| reason == error.0) {
+            self.cleanup_errors.push(error.0.into());
+        }
+    }
+}
+
+pub fn run_once(request: RawLaunchRequest) -> Result<Report> {
+    run_once_with(request, &Boottime, &mut LinuxWaiter)
+}
+
+pub fn run_once_with(
+    request: RawLaunchRequest,
+    clock: &impl Clock,
+    waiter: &mut impl Waiter,
+) -> Result<Report> {
+    let budget = Budget::capture(clock)?;
+    let clock = TrackedClock {
+        inner: clock,
+        last: Cell::new(budget.origin_ns),
+    };
+    let mut report = Report::new(budget.origin_ns);
+    let prepared = prepare(request, &clock, budget);
+    let prepared = match prepared {
+        Ok(p) => p,
+        Err(error) => {
+            report.fail(error);
+            return Ok(report);
+        }
+    };
+    let mut runtime = Runtime {
+        input: prepared.input,
+        embedded: prepared.embedded,
+        docker: prepared.docker,
+        telemetry: prepared.telemetry,
+        injection: prepared.injection,
+        observer: prepared.observer,
+        evidence: prepared.evidence,
+        config_directory: prepared.config_directory,
+        state_directory: prepared.state_directory,
+        clock: &clock,
+        waiter,
+        budget,
+        report,
+        helpers: Vec::new(),
+        recorded: Vec::new(),
+        query: None,
+        attach: None,
+        policy: prepared.policy,
+        next_check: None,
+        next_query: None,
+        receiver: Receiver::default(),
+        container_id: None,
+        creation_attempted: false,
+        last_now: budget.origin_ns,
+    };
+    if let Err(error) = runtime.work() {
+        runtime.report.fail(error);
+    }
+    runtime.cleanup();
+    runtime.report.success = runtime.report.first_failure.is_none()
+        && runtime.report.proposal_json.is_some()
+        && runtime.report.cgroup_gone
+        && runtime.report.all_helpers_reaped
+        && !runtime.evidence.failed;
+    Ok(runtime.report)
+}
+
+struct TrackedClock<'a, C: Clock> {
+    inner: &'a C,
+    last: Cell<i64>,
+}
+impl<C: Clock> Clock for TrackedClock<'_, C> {
+    fn now_ns(&self) -> Result<i64> {
+        let now = self.inner.now_ns()?;
+        if now < self.last.get() {
+            return Err(OwnerError("CLOCK"));
+        }
+        self.last.set(now);
+        Ok(now)
+    }
+}
+
+struct Prepared {
+    input: OwnerInput,
+    embedded: AttemptInput,
+    docker: Arc<Executable>,
+    telemetry: Arc<Executable>,
+    injection: Injection,
+    observer: Observer,
+    evidence: Evidence,
+    config_directory: DirectoryCustody,
+    state_directory: DirectoryCustody,
+    policy: Policy,
+}
+
+struct DirectoryCustody {
+    path: String,
+    file: File,
+    identity: linux::Identity,
+}
+impl DirectoryCustody {
+    fn new(path: &str, file: File) -> Result<Self> {
+        let identity = linux::Identity::of(&file)?;
+        let custody = Self {
+            path: path.into(),
+            file,
+            identity,
+        };
+        custody.check()?;
+        Ok(custody)
+    }
+    fn check(&self) -> Result<()> {
+        if linux::Identity::of(&self.file)? != self.identity
+            || linux::Identity::of(&linux::open_directory(&self.path)?)? != self.identity
+        {
+            return Err(OwnerError("DIRECTORY_REPLACED"));
+        }
+        Ok(())
+    }
+}
+
+fn registered_json<T: serde::de::DeserializeOwned>(
+    file: &input::FileExpectation,
+    clock: &impl Clock,
+    budget: Budget,
+) -> Result<T> {
+    let mut file = linux::verified_file(file, || budget.before(clock, budget.cold_ns).map(|_| ()))?;
+    let mut bytes = Vec::new();
+    file.by_ref()
+        .take(262145)
+        .read_to_end(&mut bytes)
+        .map_err(|_| OwnerError("PROVENANCE_READ"))?;
+    let value = json::decode(&bytes, 262144)?;
+    budget.before(clock, budget.cold_ns)?;
+    Ok(value)
+}
+
+fn prepare(request: RawLaunchRequest, clock: &impl Clock, budget: Budget) -> Result<Prepared> {
+    budget.before(clock, budget.cold_ns)?;
+    let input = OwnerInput::parse(
+        request.input_manifest.as_bytes(),
+        &request.expected_manifest_sha256,
+    )?;
+    budget.before(clock, budget.cold_ns)?;
+    let embedded = AttemptInput::parse(&input)?;
+    let admission: Admission =
+        registered_json(&input.outside_control.admission_receipt, clock, budget)?;
+    if admission.version != "chess-coach.outside-admission.v1"
+        || admission.expected_self_envelope != input.outside_control.expected_self_envelope
+    {
+        return Err(OwnerError("ADMISSION_PROVENANCE"));
+    }
+    let runtime: RuntimeClosure = registered_json(&input.job.runtime_closure, clock, budget)?;
+    if runtime.version != "chess-coach.gpu-runtime-closure.v1"
+        || runtime.image_id != input.job.image_id
+        || runtime.selected_uuid != input.cooperative.selected_uuid
+        || runtime.profile_mode != input.job.gpu_profile.mode
+        || runtime.input_sha256 != input.job.job_input_ref.sha256
+    {
+        return Err(OwnerError("RUNTIME_PROVENANCE"));
+    }
+    let closure: TelemetryClosure =
+        registered_json(&input.telemetry.runtime_closure, clock, budget)?;
+    if closure.version != "chess-coach.telemetry-closure.v1"
+        || closure.executable != input.telemetry.executable.identity()
+        || closure.expected_driver != input.telemetry.expected_driver
+        || closure.selected_uuid != input.cooperative.selected_uuid
+    {
+        return Err(OwnerError("TELEMETRY_PROVENANCE"));
+    }
+    let injection: Injection =
+        registered_json(&input.job.gpu_profile.injection_inventory, clock, budget)?;
+    injection.validate(&input.cooperative.selected_uuid)?;
+    let docker = Arc::new(Executable::open(&input.docker.executable, || {
+        budget.before(clock, budget.cold_ns).map(|_| ())
+    })?);
+    let telemetry = Arc::new(Executable::open(&input.telemetry.executable, || {
+        budget.before(clock, budget.cold_ns).map(|_| ())
+    })?);
+    let config = linux::empty_private_directory(&input.docker.anonymous_config_directory)?;
+    let state = linux::empty_private_directory(&input.job.state_host_source)?;
+    if linux::Identity::of(&config)? == linux::Identity::of(&state)? {
+        return Err(OwnerError("DIRECTORY_ALIAS"));
+    }
+    let config_directory = DirectoryCustody::new(&input.docker.anonymous_config_directory, config)?;
+    let state_directory = DirectoryCustody::new(&input.job.state_host_source, state)?;
+    linux::socket_path(&input.docker.endpoint_unix_socket)?;
+    let observer = Observer::new(&input)?;
+    budget.before(clock, budget.cold_ns)?;
+    let mut evidence = Evidence::create(&input.evidence.exclusive_packet_root)?;
+    evidence.write(
+        "owner-input.json",
+        request.input_manifest.as_bytes(),
+        Phase::Working,
+    )?;
+    budget.before(clock, budget.cold_ns)?;
+    let policy = Policy::new(Some(input.cooperative.clone()), Some(budget.origin_ns));
+    Ok(Prepared {
+        input,
+        embedded,
+        docker,
+        telemetry,
+        injection,
+        observer,
+        evidence,
+        config_directory,
+        state_directory,
+        policy,
+    })
+}
+
+struct Runtime<'a, C: Clock, W: Waiter> {
+    input: OwnerInput,
+    embedded: AttemptInput,
+    docker: Arc<Executable>,
+    telemetry: Arc<Executable>,
+    injection: Injection,
+    observer: Observer,
+    evidence: Evidence,
+    config_directory: DirectoryCustody,
+    state_directory: DirectoryCustody,
+    clock: &'a C,
+    waiter: &'a mut W,
+    budget: Budget,
+    report: Report,
+    helpers: Vec<Detached>,
+    recorded: Vec<bool>,
+    query: Option<(usize, i64)>,
+    attach: Option<usize>,
+    policy: Policy,
+    next_check: Option<i64>,
+    next_query: Option<i64>,
+    receiver: Receiver,
+    container_id: Option<String>,
+    creation_attempted: bool,
+    last_now: i64,
+}
+
+impl<C: Clock, W: Waiter> Runtime<'_, C, W> {
+    fn check_working_custody(&self) -> Result<()> {
+        self.config_directory
+            .check()
+            .map_err(|_| OwnerError("ANONYMOUS_CONFIG_REPLACED"))?;
+        self.state_directory
+            .check()
+            .map_err(|_| OwnerError("STATE_PATH_REPLACED"))
+    }
+    fn now(&mut self, deadline: i64) -> Result<i64> {
+        let now = self.budget.before(self.clock, deadline)?;
+        if now < self.last_now {
+            return Err(OwnerError("CLOCK"));
+        }
+        self.last_now = now;
+        Ok(now)
+    }
+    fn work_deadline(&self) -> i64 {
+        if self.receiver.startup {
+            self.budget.work_ns
+        } else {
+            self.budget.cold_ns
+        }
+    }
+    fn spawn(
+        &mut self,
+        role: &str,
+        args: Vec<String>,
+        query: bool,
+        interactive: bool,
+        phase: Phase,
+    ) -> Result<usize> {
+        self.config_directory
+            .check()
+            .map_err(|_| OwnerError("ANONYMOUS_CONFIG_REPLACED"))?;
+        if phase == Phase::Working {
+            self.check_working_custody()?;
+        }
+        let now = self.now(if phase == Phase::Working {
+            self.work_deadline()
+        } else {
+            self.budget.cleanup_ns
+        })?;
+        if phase == Phase::Working && self.next_check.is_some() {
+            let decision = self.policy.check(Some(now));
+            self.policy_result(decision)?;
+        }
+        let index = self.helpers.len();
+        if let Err(error) =
+            self.evidence
+                .json(&format!("helper-{index:04}-argv.json"), &args, phase)
+        {
+            if phase == Phase::Working {
+                return Err(error);
+            }
+            self.report.cleanup_fault(error);
+        }
+        let now = self.now(if phase == Phase::Working {
+            self.work_deadline()
+        } else {
+            self.budget.cleanup_ns
+        })?;
+        if phase == Phase::Working && self.next_check.is_some() {
+            let decision = self.policy.check(Some(now));
+            self.policy_result(decision)?;
+        }
+        let limits = if query {
+            Limits {
+                stdout: 4096,
+                stderr: 4096,
+                pending: 0,
+            }
+        } else if interactive {
+            Limits {
+                stdout: wire::OUTPUT_BYTES,
+                stderr: 65536,
+                pending: 1024 * 1024,
+            }
+        } else {
+            Limits {
+                stdout: 1024 * 1024,
+                stderr: 65536,
+                pending: 0,
+            }
+        };
+        self.config_directory
+            .check()
+            .map_err(|_| OwnerError("ANONYMOUS_CONFIG_REPLACED"))?;
+        if phase == Phase::Working {
+            self.check_working_custody()?;
+        }
+        if role == "create" {
+            self.creation_attempted = true;
+        }
+        let process = Process::spawn(
+            if query {
+                self.telemetry.clone()
+            } else {
+                self.docker.clone()
+            },
+            &args,
+            interactive,
+            limits,
+        )?;
+        self.helpers.push(Detached {
+            role: role.into(),
+            process,
+        });
+        self.recorded.push(false);
+        self.report.all_helpers_reaped = false;
+        Ok(index)
+    }
+    fn record(&mut self, index: usize, phase: Phase) -> Result<()> {
+        if self.recorded[index] || (self.evidence.failed && phase == Phase::Cleanup) {
+            return Ok(());
+        }
+        let process = &self.helpers[index].process;
+        self.evidence.write(
+            &format!("helper-{index:04}-stdout"),
+            &process.stdout.prefix,
+            phase,
+        )?;
+        self.evidence.write(
+            &format!("helper-{index:04}-stderr"),
+            &process.stderr.prefix,
+            phase,
+        )?;
+        let metadata = serde_json::json!({"role":self.helpers[index].role,"stdoutReceived":process.stdout.received,"stderrReceived":process.stderr.received,
+            "stdoutEof":process.stdout.eof,"stderrEof":process.stderr.eof,"exitCode":process.status.and_then(|s|s.code()),"reaped":process.status.is_some(),"naturalClean":process.natural_clean()});
+        self.evidence
+            .json(&format!("helper-{index:04}-exit.json"), &metadata, phase)?;
+        self.recorded[index] = true;
+        Ok(())
+    }
+    fn policy_result(&mut self, decision: crate::policy::Decision) -> Result<()> {
+        if let Some(next) = decision.next_check_ns() {
+            self.next_check = Some(next);
+            Ok(())
+        } else {
+            Err(OwnerError(match decision.reason().unwrap_or("TELEMETRY") {
+                "CONFIGURATION" => "CONFIGURATION",
+                "ORIGIN" => "ORIGIN",
+                "CLOCK" => "CLOCK",
+                "NOT_ADMITTED" => "NOT_ADMITTED",
+                "ALREADY_ADMITTED" => "ALREADY_ADMITTED",
+                "COLD_DEADLINE" => "COLD_DEADLINE",
+                "WORK_DEADLINE" => "WORK_DEADLINE",
+                "DEVICE" => "DEVICE",
+                "CAPACITY" => "CAPACITY",
+                "SAMPLE_TIME" => "SAMPLE_TIME",
+                "SAMPLE_ORDER" => "SAMPLE_ORDER",
+                "STALE_SAMPLE" => "STALE_SAMPLE",
+                "MISSED_SAMPLE" => "MISSED_SAMPLE",
+                "HEADROOM" => "HEADROOM",
+                _ => "TELEMETRY",
+            }))
+        }
+    }
+    fn launch_query(&mut self) -> Result<()> {
+        if self.query.is_some() {
+            return Err(OwnerError("TELEMETRY_OVERLAP"));
+        }
+        let q0 = self.now(self.work_deadline())?;
+        if let Some(next_check) = self.next_check {
+            let latest = i128::from(next_check)
+                - i128::from(self.input.telemetry.query_budget_ns.0)
+                - i128::from(self.input.telemetry.scheduling_reserve_ns.0);
+            if i128::from(q0) > latest {
+                return Err(OwnerError("TELEMETRY_LATE_QUERY"));
+            }
+        }
+        let index = self.spawn(
+            "query",
+            telemetry::argv(&self.input.cooperative.selected_uuid),
+            true,
+            false,
+            Phase::Working,
+        )?;
+        self.query = Some((index, q0));
+        self.next_query = None;
+        Ok(())
+    }
+    fn tick(&mut self) -> Result<()> {
+        let now = self.now(self.work_deadline())?;
+        if self.next_check.is_some() {
+            let decision = self.policy.check(Some(now));
+            self.policy_result(decision)?;
+        }
+        if let Some((_, q0)) = self.query
+            && i128::from(now)
+                >= i128::from(q0) + i128::from(self.input.telemetry.query_budget_ns.0)
+        {
+            return Err(OwnerError("TELEMETRY_QUERY_DEADLINE"));
+        }
+        if self.query.is_none() && self.next_query.is_some_and(|next| now >= next) {
+            self.launch_query()?;
+        }
+        for index in 0..self.helpers.len() {
+            let progress = if !self.helpers[index].process.complete() {
+                self.helpers[index].process.pump()
+            } else {
+                Ok(())
+            };
+            let now = self.now(self.work_deadline())?;
+            if self.next_check.is_some() {
+                let decision = self.policy.check(Some(now));
+                self.policy_result(decision)?;
+            }
+            if let Some((_, q0)) = self.query
+                && i128::from(now)
+                    >= i128::from(q0) + i128::from(self.input.telemetry.query_budget_ns.0)
+            {
+                return Err(OwnerError("TELEMETRY_QUERY_DEADLINE"));
+            }
+            progress?;
+        }
+        if let Some((index, q0)) = self.query
+            && self.helpers[index].process.complete()
+        {
+            let sample = telemetry::finish(
+                &self.helpers[index].process,
+                &self.input.telemetry,
+                &self.input.cooperative.selected_uuid,
+                q0,
+                self.clock.now_ns()?,
+            )?;
+            let q1 = self.now(self.work_deadline())?;
+            if i128::from(q1) >= i128::from(q0) + i128::from(self.input.telemetry.query_budget_ns.0)
+            {
+                return Err(OwnerError("TELEMETRY_QUERY_DEADLINE"));
+            }
+            let decision = if self.next_check.is_none() {
+                self.policy.admit(Some(q1), Some(sample))
+            } else {
+                self.policy.observe(Some(q1), Some(sample))
+            };
+            self.policy_result(decision)?;
+            self.next_query = Some(telemetry::next_query(
+                q0,
+                self.next_check.ok_or(OwnerError("TELEMETRY_LEASE"))?,
+                &self.input.telemetry,
+            )?);
+            self.query = None;
+            self.record(index, Phase::Working)?;
+        }
+        if let Some(index) = self.attach {
+            let admission_deadline = self.work_deadline();
+            self.now(admission_deadline)?;
+            let process = &mut self.helpers[index].process;
+            self.receiver.receive(
+                &process.stdout.prefix,
+                process.write_complete,
+                &self.input,
+                &self.embedded,
+            )?;
+            if process.complete() {
+                if !process.natural_clean() {
+                    return Err(OwnerError("ATTACH_EXIT"));
+                }
+                self.receiver.finish(&process.stdout.prefix)?;
+            }
+            self.now(admission_deadline)?;
+        }
+        let now = self.now(self.work_deadline())?;
+        if self.next_check.is_some() {
+            let decision = self.policy.check(Some(now));
+            self.policy_result(decision)?;
+        }
+        Ok(())
+    }
+    fn wait_work(&mut self) -> Result<()> {
+        let mut deadline = self.work_deadline();
+        if let Some(next) = self.next_check {
+            deadline = deadline.min(next);
+        }
+        if let Some(next) = self.next_query {
+            deadline = deadline.min(next);
+        }
+        if let Some((_, q0)) = self.query {
+            deadline = deadline.min(
+                q0.checked_add(self.input.telemetry.query_budget_ns.0)
+                    .ok_or(OwnerError("TELEMETRY_RANGE"))?,
+            );
+        }
+        let now = self.now(self.work_deadline())?;
+        if now >= deadline {
+            return Ok(());
+        }
+        let watches = self
+            .helpers
+            .iter()
+            .flat_map(|h| h.process.watches())
+            .collect::<Vec<_>>();
+        match self.waiter.wait_until(deadline, &watches) {
+            Ok(_) => Ok(()),
+            Err(OwnerError("DEADLINE")) => Ok(()),
+            Err(e) => Err(e),
+        }
+    }
+    fn command(&mut self, role: &str, args: Vec<String>) -> Result<usize> {
+        let index = self.spawn(role, args, false, false, Phase::Working)?;
+        loop {
+            self.tick()?;
+            if self.helpers[index].process.complete() {
+                self.check_working_custody()?;
+                self.record(index, Phase::Working)?;
+                if !self.helpers[index].process.natural_clean() {
+                    return Err(OwnerError("MANAGER_EXIT"));
+                }
+                return Ok(index);
+            }
+            self.wait_work()?;
+        }
+    }
+    fn work(&mut self) -> Result<()> {
+        self.launch_query()?;
+        while self.next_check.is_none() {
+            self.tick()?;
+            if self.next_check.is_none() {
+                self.wait_work()?;
+            }
+        }
+        self.observer.check_outside(&self.input)?;
+        self.evidence.json("STARTED.json",&serde_json::json!({"status":"STARTED","originNs":Decimal(self.budget.origin_ns),
+            "sessionId":self.input.ownership.session_id,"attemptId":self.input.ownership.attempt_id}),Phase::Working)?;
+        self.now(self.work_deadline())?;
+        let create = self.command("create", docker::create(&self.input))?;
+        let id = docker::id(&self.helpers[create].process.stdout.prefix)?;
+        self.container_id = Some(id.clone());
+        let inspect = self.command("inspect-created", docker::inspect(&self.input, &id))?;
+        let (_, value) = docker::ownership(
+            &self.helpers[inspect].process.stdout.prefix,
+            &self.input,
+            Some(&id),
+        )?;
+        docker::validate_c2(&value, &self.input, &self.injection)?;
+        let attach = self.spawn(
+            "attach",
+            docker::start(&self.input, &id),
+            false,
+            true,
+            Phase::Working,
+        )?;
+        self.attach = Some(attach);
+        while !self.receiver.boot {
+            self.tick()?;
+            if !self.receiver.boot {
+                self.wait_work()?;
+            }
+        }
+        let inspect = self.command("inspect-running", docker::inspect(&self.input, &id))?;
+        let (owned, value) = docker::ownership(
+            &self.helpers[inspect].process.stdout.prefix,
+            &self.input,
+            Some(&id),
+        )?;
+        docker::validate_c2(&value, &self.input, &self.injection)?;
+        if !owned.running {
+            return Err(OwnerError("CONTAINER_NOT_RUNNING"));
+        }
+        self.observer.bind(owned.pid, &self.input)?;
+        let now = self.now(self.work_deadline())?;
+        let start = wire::start(&self.input, now - self.budget.origin_ns)?;
+        self.evidence
+            .write("job-start.json", &start, Phase::Working)?;
+        self.now(self.work_deadline())?;
+        self.check_working_custody()?;
+        self.helpers[attach].process.queue_and_close(start)?;
+        loop {
+            self.tick()?;
+            if self.helpers[attach].process.complete() {
+                self.receiver
+                    .finish(&self.helpers[attach].process.stdout.prefix)?;
+                self.report.proposal_json = self.receiver.proposal_json.clone();
+                self.record(attach, Phase::Working)?;
+                return Ok(());
+            }
+            self.wait_work()?;
+        }
+    }
+    fn stop(&mut self, index: usize) {
+        if let Err(error) = self.helpers[index].process.kill_owned() {
+            self.report.cleanup_fault(error);
+        }
+    }
+    fn cleanup_tick(&mut self) -> Result<()> {
+        self.now(self.budget.cleanup_ns)?;
+        for index in 0..self.helpers.len() {
+            if !self.helpers[index].process.complete()
+                && let Err(error) = self.helpers[index].process.cleanup_pump()
+            {
+                self.report.cleanup_fault(error);
+            }
+            self.now(self.budget.cleanup_ns)?;
+            if self.helpers[index].process.complete()
+                && let Err(error) = self.record(index, Phase::Cleanup)
+            {
+                self.report.cleanup_fault(error);
+            }
+        }
+        Ok(())
+    }
+    fn cleanup_wait(&mut self) -> Result<()> {
+        let now = self.now(self.budget.cleanup_ns)?;
+        let deadline = now.saturating_add(10_000_000).min(self.budget.cleanup_ns);
+        let watches = self
+            .helpers
+            .iter()
+            .flat_map(|h| h.process.cleanup_watches())
+            .collect::<Vec<_>>();
+        match self.waiter.wait_until(deadline, &watches) {
+            Ok(_) | Err(OwnerError("DEADLINE")) => Ok(()),
+            Err(e) => Err(e),
+        }
+    }
+    fn cleanup_command(&mut self, role: &str, args: Vec<String>) -> Result<usize> {
+        let index = self.spawn(role, args, false, false, Phase::Cleanup)?;
+        loop {
+            self.cleanup_tick()?;
+            if self.helpers[index].process.complete() {
+                if !self.helpers[index].process.natural_clean() {
+                    return Err(OwnerError("CLEANUP_MANAGER_EXIT"));
+                }
+                return Ok(index);
+            }
+            self.cleanup_wait()?;
+        }
+    }
+    fn cleanup_owned(&mut self) -> Result<()> {
+        if !self.creation_attempted {
+            return Ok(());
+        }
+        let reference = self
+            .container_id
+            .clone()
+            .unwrap_or_else(|| self.input.ownership.container_name.clone());
+        let inspect =
+            self.cleanup_command("cleanup-inspect", docker::inspect(&self.input, &reference))?;
+        let (owned, _) = docker::ownership(
+            &self.helpers[inspect].process.stdout.prefix,
+            &self.input,
+            self.container_id.as_deref(),
+        )?;
+        self.container_id = Some(owned.id.clone());
+        if self.observer.bound_path().is_none() {
+            if owned.running && owned.pid != 0 {
+                if let Err(error) = self.observer.bind(owned.pid, &self.input) {
+                    self.report.cleanup_fault(error);
+                }
+            } else if self.attach.is_some() {
+                self.report.cleanup_fault(OwnerError("C8_UNBOUND"));
+            }
+        } else {
+            if let Err(error) = self.observer.stable() {
+                self.report.cleanup_fault(error);
+            }
+        }
+        if let Some(attach) = self.attach {
+            self.stop(attach);
+        }
+        self.cleanup_command("remove", docker::remove(&self.input, &owned.id, true))?;
+        Ok(())
+    }
+    fn cleanup(&mut self) {
+        for index in 0..self.helpers.len() {
+            if Some(index) != self.attach {
+                self.stop(index);
+            }
+        }
+        if let Err(error) = self.cleanup_owned() {
+            self.report.cleanup_fault(error);
+        }
+        for index in 0..self.helpers.len() {
+            self.stop(index);
+        }
+        loop {
+            if let Err(error) = self.cleanup_tick() {
+                self.report.cleanup_fault(error);
+                break;
+            }
+            self.report.all_helpers_reaped = self.helpers.iter().all(|h| h.process.complete());
+            if self.observer.bound_path().is_some() {
+                match self.observer.gone() {
+                    Ok(gone) => self.report.cgroup_gone = gone,
+                    Err(error) => {
+                        self.report.cleanup_fault(error);
+                        break;
+                    }
+                }
+            }
+            if self.report.all_helpers_reaped
+                && (self.report.cgroup_gone || self.observer.bound_path().is_none())
+            {
+                break;
+            }
+            if let Err(error) = self.cleanup_wait() {
+                self.report.cleanup_fault(error);
+                break;
+            }
+        }
+        self.report.all_helpers_reaped = self.helpers.iter().all(|h| h.process.complete());
+        if self.creation_attempted && !self.report.cgroup_gone {
+            self.report.cleanup_fault(OwnerError("CGROUP_NOT_GONE"));
+        }
+        if !self.report.all_helpers_reaped {
+            self.report.cleanup_fault(OwnerError("HELPERS_NOT_REAPED"));
+        }
+        if self.evidence.failed {
+            self.report.fail(OwnerError("EVIDENCE_FAILED"));
+        }
+        if let Err(error) = self.now(self.budget.cleanup_ns) {
+            self.report.cleanup_fault(error);
+        }
+    }
+}
diff --git a/crates/gpu-owner/src/policy.rs b/crates/gpu-owner/src/policy.rs
new file mode 100644
index 000000000..33f80ade9
--- /dev/null
+++ b/crates/gpu-owner/src/policy.rs
@@ -0,0 +1,272 @@
+// SPEC: _spec/gpu-cooperative-policy.md
+use crate::json::Decimal;
+use serde::{Deserialize, Serialize};
+
+pub const COLD_NS: i64 = 10_000_000_000;
+pub const WORK_NS: i64 = 297_000_000_000;
+pub const CLEANUP_NS: i64 = 300_000_000_000;
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Configuration {
+    pub selected_uuid: String,
+    pub startup_min_free_bytes: Decimal,
+    pub running_stop_below_free_bytes: Decimal,
+    pub sample_period_ns: Decimal,
+    pub max_sample_age_ns: Decimal,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Sample {
+    pub uuid: String,
+    pub free_bytes: Decimal,
+    pub total_bytes: Decimal,
+    pub observed_boottime_ns: Decimal,
+}
+
+pub fn valid_uuid(value: &str) -> bool {
+    value.len() == 40
+        && value.starts_with("GPU-")
+        && value.bytes().enumerate().skip(4).all(|(i, b)| {
+            if [12, 17, 22, 27].contains(&i) {
+                b == b'-'
+            } else {
+                b.is_ascii_hexdigit()
+            }
+        })
+}
+
+pub fn valid_config(c: &Configuration) -> bool {
+    valid_uuid(&c.selected_uuid)
+        && c.running_stop_below_free_bytes.0 > 0
+        && c.running_stop_below_free_bytes <= c.startup_min_free_bytes
+        && c.sample_period_ns.0 > 0
+        && c.sample_period_ns <= c.max_sample_age_ns
+}
+
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "kebab-case", deny_unknown_fields)]
+pub enum Decision {
+    Admit {
+        #[serde(rename = "nextCheckNs")]
+        next_check_ns: Decimal,
+    },
+    Continue {
+        #[serde(rename = "nextCheckNs")]
+        next_check_ns: Decimal,
+    },
+    Reject {
+        reason: String,
+    },
+    AbortOwned {
+        reason: String,
+        #[serde(rename = "cleanupDeadlineNs")]
+        cleanup_deadline_ns: Decimal,
+    },
+    Terminal {
+        reason: String,
+    },
+}
+
+impl Decision {
+    pub fn next_check_ns(&self) -> Option<i64> {
+        match self {
+            Self::Admit { next_check_ns } | Self::Continue { next_check_ns } => {
+                Some(next_check_ns.0)
+            }
+            _ => None,
+        }
+    }
+    pub fn reason(&self) -> Option<&str> {
+        match self {
+            Self::Reject { reason }
+            | Self::AbortOwned { reason, .. }
+            | Self::Terminal { reason } => Some(reason),
+            _ => None,
+        }
+    }
+}
+
+pub struct Policy {
+    configuration: Option<Configuration>,
+    origin: Option<i64>,
+    initial_failure: Option<&'static str>,
+    first_failure: Option<&'static str>,
+    running: bool,
+    last_now: Option<i64>,
+    sample: Option<Sample>,
+}
+
+impl Policy {
+    pub fn new(configuration: Option<Configuration>, origin: Option<i64>) -> Self {
+        let initial_failure = if !configuration.as_ref().is_some_and(valid_config) {
+            Some("CONFIGURATION")
+        } else if !origin.is_some_and(|s| (0..=i64::MAX - CLEANUP_NS).contains(&s)) {
+            Some("ORIGIN")
+        } else {
+            None
+        };
+        Self {
+            configuration,
+            origin,
+            initial_failure,
+            first_failure: None,
+            running: false,
+            last_now: None,
+            sample: None,
+        }
+    }
+    pub fn admit(&mut self, now: Option<i64>, sample: Option<Sample>) -> Decision {
+        self.accept(now, sample, true)
+    }
+    pub fn observe(&mut self, now: Option<i64>, sample: Option<Sample>) -> Decision {
+        self.accept(now, sample, false)
+    }
+    pub fn check(&mut self, now: Option<i64>) -> Decision {
+        match self.gate(now, false) {
+            Some(d) => d,
+            None => self.progress(false),
+        }
+    }
+    fn fail(&mut self, reason: &'static str) -> Decision {
+        self.first_failure = Some(reason);
+        if self.running {
+            Decision::AbortOwned {
+                reason: reason.into(),
+                cleanup_deadline_ns: Decimal(self.origin.unwrap_or(0) + CLEANUP_NS),
+            }
+        } else {
+            Decision::Reject {
+                reason: reason.into(),
+            }
+        }
+    }
+    fn expiry(&self, now: i64, sample: &Sample) -> Option<&'static str> {
+        let c = self.configuration.as_ref()?;
+        if i128::from(now)
+            >= i128::from(sample.observed_boottime_ns.0) + i128::from(c.max_sample_age_ns.0)
+        {
+            Some("STALE_SAMPLE")
+        } else if i128::from(now)
+            >= i128::from(sample.observed_boottime_ns.0) + i128::from(c.sample_period_ns.0)
+        {
+            Some("MISSED_SAMPLE")
+        } else {
+            None
+        }
+    }
+    fn gate(&mut self, now: Option<i64>, admit: bool) -> Option<Decision> {
+        if let Some(reason) = self.first_failure {
+            return Some(Decision::Terminal {
+                reason: reason.into(),
+            });
+        }
+        if let Some(reason) = self.initial_failure {
+            return Some(self.fail(reason));
+        }
+        let s0 = self.origin.unwrap_or(0);
+        let Some(now) = now.filter(|n| *n >= s0 && self.last_now.is_none_or(|last| *n >= last))
+        else {
+            return Some(self.fail("CLOCK"));
+        };
+        self.last_now = Some(now);
+        let failure = if !self.running {
+            if !admit {
+                Some("NOT_ADMITTED")
+            } else if now >= s0 + COLD_NS {
+                Some("COLD_DEADLINE")
+            } else {
+                None
+            }
+        } else if admit {
+            Some("ALREADY_ADMITTED")
+        } else if now >= s0 + WORK_NS {
+            Some("WORK_DEADLINE")
+        } else {
+            self.sample
+                .as_ref()
+                .and_then(|sample| self.expiry(now, sample))
+        };
+        failure.map(|reason| self.fail(reason))
+    }
+    fn accept(&mut self, now: Option<i64>, sample: Option<Sample>, admit: bool) -> Decision {
+        if let Some(d) = self.gate(now, admit) {
+            return d;
+        }
+        let now = now.unwrap_or(0);
+        let Some(sample) = sample else {
+            return self.fail("TELEMETRY");
+        };
+        if !valid_uuid(&sample.uuid)
+            || sample.free_bytes.0 < 0
+            || sample.total_bytes.0 <= 0
+            || sample.free_bytes > sample.total_bytes
+            || sample.observed_boottime_ns.0 < 0
+        {
+            return self.fail("TELEMETRY");
+        }
+        let c = self
+            .configuration
+            .as_ref()
+            .expect("validated configuration");
+        let failure = if sample.uuid != c.selected_uuid {
+            Some("DEVICE")
+        } else if sample.observed_boottime_ns.0 < self.origin.unwrap_or(0)
+            || sample.observed_boottime_ns.0 > now
+        {
+            Some("SAMPLE_TIME")
+        } else if self
+            .sample
+            .as_ref()
+            .is_some_and(|old| sample.observed_boottime_ns <= old.observed_boottime_ns)
+        {
+            Some("SAMPLE_ORDER")
+        } else if c.startup_min_free_bytes > sample.total_bytes
+            || self
+                .sample
+                .as_ref()
+                .is_some_and(|old| old.total_bytes != sample.total_bytes)
+        {
+            Some("CAPACITY")
+        } else if let Some(reason) = self.expiry(now, &sample) {
+            Some(reason)
+        } else if sample.free_bytes
+            < if self.running {
+                c.running_stop_below_free_bytes
+            } else {
+                c.startup_min_free_bytes
+            }
+        {
+            Some("HEADROOM")
+        } else {
+            None
+        };
+        if let Some(reason) = failure {
+            return self.fail(reason);
+        }
+        self.sample = Some(sample);
+        self.running = true;
+        self.progress(admit)
+    }
+    fn progress(&self, admit: bool) -> Decision {
+        let c = self
+            .configuration
+            .as_ref()
+            .expect("validated configuration");
+        let sample = self.sample.as_ref().expect("accepted sample");
+        let next = (i128::from(sample.observed_boottime_ns.0) + i128::from(c.sample_period_ns.0))
+            .min(i128::from(sample.observed_boottime_ns.0) + i128::from(c.max_sample_age_ns.0))
+            .min(i128::from(self.origin.unwrap_or(0)) + i128::from(WORK_NS))
+            as i64;
+        if admit {
+            Decision::Admit {
+                next_check_ns: Decimal(next),
+            }
+        } else {
+            Decision::Continue {
+                next_check_ns: Decimal(next),
+            }
+        }
+    }
+}
diff --git a/crates/gpu-owner/src/process.rs b/crates/gpu-owner/src/process.rs
new file mode 100644
index 000000000..c9e8b6620
--- /dev/null
+++ b/crates/gpu-owner/src/process.rs
@@ -0,0 +1,386 @@
+// SPEC: _spec/gpu-owner.md
+use crate::{
+    OwnerError, Result,
+    linux::{Executable, Watch},
+};
+use rustix::{
+    event::{PollFd, PollFlags},
+    fs::OFlags,
+    process::{Pid, Signal},
+};
+use std::{
+    io::{Read, Write},
+    os::{
+        fd::{AsFd, OwnedFd},
+        unix::process::CommandExt,
+    },
+    process::{Child, ChildStderr, ChildStdin, ChildStdout, Command, ExitStatus, Stdio},
+    sync::Arc,
+};
+
+#[derive(Clone, Copy)]
+pub struct Limits {
+    pub stdout: usize,
+    pub stderr: usize,
+    pub pending: usize,
+}
+impl Default for Limits {
+    fn default() -> Self {
+        Self {
+            stdout: 64 * 1024 * 1024,
+            stderr: 65536,
+            pending: 1024 * 1024,
+        }
+    }
+}
+
+pub struct Stream {
+    pub prefix: Vec<u8>,
+    pub received: u64,
+    pub eof: bool,
+    cap: usize,
+}
+impl Stream {
+    fn new(cap: usize) -> Self {
+        Self {
+            prefix: Vec::new(),
+            received: 0,
+            eof: false,
+            cap,
+        }
+    }
+    fn read(&mut self, reader: &mut impl Read) -> Result<bool> {
+        let mut bytes = [0u8; 65536];
+        for _ in 0..16 {
+            match reader.read(&mut bytes) {
+                Ok(0) => {
+                    self.eof = true;
+                    return Ok(false);
+                }
+                Ok(n) => {
+                    self.received = self
+                        .received
+                        .checked_add(n as u64)
+                        .ok_or(OwnerError("OUTPUT_ACCOUNT"))?;
+                    let keep = n.min(self.cap.saturating_sub(self.prefix.len()));
+                    self.prefix.extend_from_slice(&bytes[..keep]);
+                    if keep < n {
+                        return Err(OwnerError("OUTPUT_BOUND"));
+                    }
+                }
+                Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => return Ok(false),
+                Err(e) if e.kind() == std::io::ErrorKind::Interrupted => continue,
+                Err(_) => return Err(OwnerError("PIPE_READ")),
+            }
+        }
+        Ok(true)
+    }
+}
+
+pub struct Process {
+    child: Child,
+    executable: Arc<Executable>,
+    pidfd: Option<OwnedFd>,
+    stdin: Option<ChildStdin>,
+    stdout_pipe: Option<ChildStdout>,
+    stderr_pipe: Option<ChildStderr>,
+    pub stdout: Stream,
+    pub stderr: Stream,
+    pending: Vec<u8>,
+    written: usize,
+    pending_bound: usize,
+    queued: bool,
+    pub write_complete: bool,
+    pub status: Option<ExitStatus>,
+    pub failure: Option<OwnerError>,
+    stopped: bool,
+    forced: bool,
+}
+
+impl Process {
+    pub fn spawn(
+        executable: Arc<Executable>,
+        args: &[String],
+        interactive: bool,
+        limits: Limits,
+    ) -> Result<Self> {
+        if limits.pending > 1024 * 1024
+            || limits.stdout > 64 * 1024 * 1024
+            || limits.stderr > 64 * 1024 * 1024
+        {
+            return Err(OwnerError("PROCESS_LIMITS"));
+        }
+        let mut command = Command::new(executable.path());
+        command
+            .args(args)
+            .env_clear()
+            .env("LANG", "C")
+            .env("LC_ALL", "C")
+            .env("TZ", "UTC")
+            .stdin(if interactive {
+                Stdio::piped()
+            } else {
+                Stdio::null()
+            })
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .process_group(0);
+        let mut child = command.spawn().map_err(|_| OwnerError("SPAWN"))?;
+        let pid = Pid::from_child(&child);
+        let pidfd = rustix::process::pidfd_open(pid, rustix::process::PidfdFlags::empty());
+        let mut process = Self {
+            stdin: child.stdin.take(),
+            stdout_pipe: child.stdout.take(),
+            stderr_pipe: child.stderr.take(),
+            child,
+            executable,
+            pidfd: None,
+            stdout: Stream::new(limits.stdout),
+            stderr: Stream::new(limits.stderr),
+            pending: Vec::new(),
+            written: 0,
+            pending_bound: limits.pending,
+            queued: false,
+            write_complete: !interactive,
+            status: None,
+            failure: None,
+            stopped: false,
+            forced: false,
+        };
+        match pidfd {
+            Ok(fd) => process.pidfd = Some(fd),
+            Err(_) => process.failure = Some(OwnerError("PIDFD")),
+        }
+        if let Some(pipe) = &process.stdin
+            && nonblocking(pipe).is_err()
+        {
+            process.failure = Some(OwnerError("PIPE_NONBLOCK"));
+            process.stdin.take();
+        }
+        if let Some(pipe) = &process.stdout_pipe
+            && nonblocking(pipe).is_err()
+        {
+            process.failure = Some(OwnerError("PIPE_NONBLOCK"));
+            process.stdout_pipe.take();
+        }
+        if let Some(pipe) = &process.stderr_pipe
+            && nonblocking(pipe).is_err()
+        {
+            process.failure = Some(OwnerError("PIPE_NONBLOCK"));
+            process.stderr_pipe.take();
+        }
+        if process.failure.is_some()
+            && let Err(error) = process.kill_owned()
+        {
+            process.failure = Some(error);
+        }
+        Ok(process)
+    }
+    pub fn pid(&self) -> u32 {
+        self.child.id()
+    }
+    pub fn executable(&self) -> &Arc<Executable> {
+        &self.executable
+    }
+    pub fn queue_and_close(&mut self, bytes: Vec<u8>) -> Result<()> {
+        if self.queued || self.stdin.is_none() || bytes.len() > self.pending_bound {
+            return Err(OwnerError("STDIN_BOUND"));
+        }
+        self.pending = bytes;
+        self.queued = true;
+        self.write_complete = false;
+        Ok(())
+    }
+    pub fn watches(&self) -> Vec<Watch<'_>> {
+        self.watches_for(true)
+    }
+    pub fn cleanup_watches(&self) -> Vec<Watch<'_>> {
+        self.watches_for(false)
+    }
+    fn watches_for(&self, writing: bool) -> Vec<Watch<'_>> {
+        let mut watches = Vec::new();
+        if self.status.is_none()
+            && let Some(fd) = &self.pidfd
+        {
+            watches.push(Watch {
+                fd: fd.as_fd(),
+                events: PollFlags::IN,
+            });
+        }
+        if !self.stdout.eof
+            && let Some(pipe) = &self.stdout_pipe
+        {
+            watches.push(Watch {
+                fd: pipe.as_fd(),
+                events: PollFlags::IN,
+            });
+        }
+        if !self.stderr.eof
+            && let Some(pipe) = &self.stderr_pipe
+        {
+            watches.push(Watch {
+                fd: pipe.as_fd(),
+                events: PollFlags::IN,
+            });
+        }
+        if writing
+            && self.queued
+            && let Some(pipe) = &self.stdin
+        {
+            watches.push(Watch {
+                fd: pipe.as_fd(),
+                events: PollFlags::OUT,
+            });
+        }
+        watches
+    }
+    pub fn pump(&mut self) -> Result<()> {
+        self.pump_inner(false)
+    }
+    pub fn cleanup_pump(&mut self) -> Result<()> {
+        self.pump_inner(true)
+    }
+    fn pump_inner(&mut self, cleanup: bool) -> Result<()> {
+        let mut error = None;
+        if !cleanup
+            && self.queued
+            && !self.forced
+            && let Some(pipe) = &mut self.stdin
+        {
+            for _ in 0..16 {
+                if self.written == self.pending.len() {
+                    self.stdin.take();
+                    self.write_complete = true;
+                    break;
+                }
+                match pipe.write(&self.pending[self.written..]) {
+                    Ok(0) => {
+                        error = Some(OwnerError("PIPE_WRITE"));
+                        break;
+                    }
+                    Ok(n) => self.written += n,
+                    Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => break,
+                    Err(e) if e.kind() == std::io::ErrorKind::Interrupted => continue,
+                    Err(_) => {
+                        error = Some(OwnerError("PIPE_WRITE"));
+                        break;
+                    }
+                }
+            }
+        }
+        let (drain_error, _) = self.drain_pipes();
+        if let Some(e) = drain_error {
+            error.get_or_insert(e);
+        }
+        if self.status.is_none() {
+            let exited = if let Some(fd) = &self.pidfd {
+                let mut poll = [PollFd::new(fd, PollFlags::IN)];
+                rustix::event::poll(
+                    &mut poll,
+                    Some(&rustix::time::Timespec {
+                        tv_sec: 0,
+                        tv_nsec: 0,
+                    }),
+                )
+                .map_err(|_| OwnerError("PIDFD_POLL"))?;
+                !poll[0].revents().is_empty()
+            } else {
+                self.stopped
+            };
+            if exited {
+                let (drain_error, exhausted) = self.drain_pipes();
+                if let Some(e) = drain_error {
+                    error.get_or_insert(e);
+                }
+                if !exhausted || error.is_some() {
+                    if !self.stdout.eof || !self.stderr.eof {
+                        self.forced = true;
+                    }
+                    self.stop_group()?;
+                    self.status = self.child.try_wait().map_err(|_| OwnerError("REAP"))?;
+                }
+            }
+        }
+        if self.status.is_some() {
+            self.pidfd.take();
+        }
+        if let Some(e) = error {
+            self.failure.get_or_insert(e);
+            return Err(e);
+        }
+        if !cleanup && let Some(e) = self.failure {
+            return Err(e);
+        }
+        Ok(())
+    }
+    fn drain_pipes(&mut self) -> (Option<OwnerError>, bool) {
+        let mut error = None;
+        let mut exhausted = false;
+        if let Some(pipe) = &mut self.stdout_pipe
+            && !self.stdout.eof
+        {
+            match self.stdout.read(pipe) {
+                Ok(quota) => exhausted |= quota,
+                Err(e) => {
+                    error.get_or_insert(e);
+                }
+            }
+        }
+        if let Some(pipe) = &mut self.stderr_pipe
+            && !self.stderr.eof
+        {
+            match self.stderr.read(pipe) {
+                Ok(quota) => exhausted |= quota,
+                Err(e) => {
+                    error.get_or_insert(e);
+                }
+            }
+        }
+        if self.stdout.eof {
+            self.stdout_pipe.take();
+        }
+        if self.stderr.eof {
+            self.stderr_pipe.take();
+        }
+        (error, exhausted)
+    }
+    fn stop_group(&mut self) -> Result<()> {
+        if self.stopped {
+            return Ok(());
+        }
+        let pid = Pid::from_child(&self.child);
+        match rustix::process::kill_process_group(pid, Signal::KILL) {
+            Ok(()) | Err(rustix::io::Errno::SRCH) => self.stopped = true,
+            Err(_) => return Err(OwnerError("GROUP_KILL")),
+        }
+        Ok(())
+    }
+    pub fn kill_owned(&mut self) -> Result<()> {
+        if self.status.is_none() {
+            self.stop_group()?;
+            self.forced = true;
+        }
+        self.stdin.take();
+        Ok(())
+    }
+    pub fn complete(&self) -> bool {
+        self.status.is_some() && self.stdout.eof && self.stderr.eof
+    }
+    pub fn natural_clean(&self) -> bool {
+        self.complete()
+            && !self.forced
+            && self.failure.is_none()
+            && self.write_complete
+            && self.status.is_some_and(|s| s.success())
+    }
+}
+
+fn nonblocking(fd: &impl AsFd) -> Result<()> {
+    let flags = rustix::fs::fcntl_getfl(fd).map_err(|_| OwnerError("PIPE_FLAGS"))?;
+    rustix::fs::fcntl_setfl(fd, flags | OFlags::NONBLOCK).map_err(|_| OwnerError("PIPE_FLAGS"))
+}
+
+pub struct Detached {
+    pub role: String,
+    pub process: Process,
+}
diff --git a/crates/gpu-owner/src/telemetry.rs b/crates/gpu-owner/src/telemetry.rs
new file mode 100644
index 000000000..fa7c7a294
--- /dev/null
+++ b/crates/gpu-owner/src/telemetry.rs
@@ -0,0 +1,82 @@
+// SPEC: _spec/gpu-owner.md
+use crate::{
+    OwnerError, Result, input::TelemetryInput, json::Decimal, policy::Sample, process::Process,
+};
+
+pub fn argv(uuid: &str) -> Vec<String> {
+    vec![
+        format!("--id={uuid}"),
+        "--query-gpu=uuid,driver_version,memory.total,memory.used,memory.free".into(),
+        "--format=csv,noheader,nounits".into(),
+    ]
+}
+
+pub fn decode(bytes: &[u8], uuid: &str, driver: &str, q0: i64) -> Result<Sample> {
+    if bytes.is_empty()
+        || bytes.len() > 4096
+        || !bytes.is_ascii()
+        || !bytes.ends_with(b"\n")
+        || bytes[..bytes.len() - 1].contains(&b'\n')
+        || bytes.contains(&b'\r')
+    {
+        return Err(OwnerError("TELEMETRY_LINE"));
+    }
+    let text = std::str::from_utf8(&bytes[..bytes.len() - 1])
+        .map_err(|_| OwnerError("TELEMETRY_ASCII"))?;
+    let fields: Vec<_> = text.split(',').map(|s| s.trim_matches(' ')).collect();
+    if fields.len() != 5 || fields[0] != uuid || fields[1] != driver {
+        return Err(OwnerError("TELEMETRY_IDENTITY"));
+    }
+    fn mib(value: &str) -> Result<i64> {
+        if value.is_empty()
+            || (value.len() > 1 && value.starts_with('0'))
+            || !value.bytes().all(|b| b.is_ascii_digit())
+        {
+            return Err(OwnerError("TELEMETRY_INTEGER"));
+        }
+        value
+            .parse::<i64>()
+            .ok()
+            .and_then(|n| n.checked_mul(1_048_576))
+            .ok_or(OwnerError("TELEMETRY_RANGE"))
+    }
+    let total = mib(fields[2])?;
+    let used = mib(fields[3])?;
+    let free = mib(fields[4])?;
+    if q0 < 0 || total <= 0 || used > total || free > total {
+        return Err(OwnerError("TELEMETRY_CAPACITY"));
+    }
+    Ok(Sample {
+        uuid: uuid.into(),
+        free_bytes: Decimal(free),
+        total_bytes: Decimal(total),
+        observed_boottime_ns: Decimal(q0),
+    })
+}
+
+pub fn finish(
+    process: &Process,
+    input: &TelemetryInput,
+    uuid: &str,
+    q0: i64,
+    q1: i64,
+) -> Result<Sample> {
+    if !process.natural_clean()
+        || q1 < q0
+        || i128::from(q1) >= i128::from(q0) + i128::from(input.query_budget_ns.0)
+    {
+        return Err(OwnerError("TELEMETRY_QUERY"));
+    }
+    decode(&process.stdout.prefix, uuid, &input.expected_driver, q0)
+}
+
+pub fn next_query(q0: i64, next_check: i64, input: &TelemetryInput) -> Result<i64> {
+    let scheduled = i128::from(q0) + i128::from(input.refresh_interval_ns.0);
+    let latest = i128::from(next_check)
+        - i128::from(input.query_budget_ns.0)
+        - i128::from(input.scheduling_reserve_ns.0);
+    if scheduled > latest || scheduled > i128::from(i64::MAX) {
+        return Err(OwnerError("TELEMETRY_SCHEDULE"));
+    }
+    Ok(scheduled as i64)
+}
diff --git a/crates/gpu-owner/src/wire.rs b/crates/gpu-owner/src/wire.rs
new file mode 100644
index 000000000..d2ba75abf
--- /dev/null
+++ b/crates/gpu-owner/src/wire.rs
@@ -0,0 +1,581 @@
+// SPEC: _spec/gpu-owner.md
+use crate::{
+    OwnerError, Result,
+    input::{ByteRef, OwnerInput},
+    json::{self, Decimal},
+};
+use serde::{Deserialize, Serialize};
+use serde_json::value::RawValue;
+
+pub const VERSION: &str = "chess-coach.gpu-job.v1";
+pub const FRAME_BYTES: usize = 1_048_576;
+pub const OUTPUT_BYTES: usize = 3 * (FRAME_BYTES + 1);
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Bindings {
+    pub source: ByteRef,
+    pub tests: ByteRef,
+    pub closure: ByteRef,
+    pub dependency_lock: ByteRef,
+    pub image: ByteRef,
+    pub runtime_configuration: ByteRef,
+    pub core_rules: ByteRef,
+    pub strategic_source: ByteRef,
+    pub corpus_manifest: ByteRef,
+    pub corpus_source: ByteRef,
+    pub recipe: ByteRef,
+    pub feature_layout: ByteRef,
+    pub fixture_manifest: ByteRef,
+    pub host_configuration: ByteRef,
+}
+impl Bindings {
+    pub fn validate(&self) -> Result<()> {
+        for reference in [
+            &self.source,
+            &self.tests,
+            &self.closure,
+            &self.dependency_lock,
+            &self.image,
+            &self.runtime_configuration,
+            &self.core_rules,
+            &self.strategic_source,
+            &self.corpus_manifest,
+            &self.corpus_source,
+            &self.recipe,
+            &self.feature_layout,
+            &self.fixture_manifest,
+            &self.host_configuration,
+        ] {
+            reference.validate()?;
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ModelConfig {
+    pub version: String,
+    pub architecture: String,
+    pub feature_version: String,
+    #[serde(deserialize_with = "json::integer")]
+    pub input_features: u32,
+    #[serde(deserialize_with = "json::integer")]
+    pub hidden_units: u32,
+    pub record_sha256: String,
+}
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct AttemptInput {
+    pub version: String,
+    pub bindings: Bindings,
+    pub model_config: ModelConfig,
+    pub record_ref: ByteRef,
+    pub initial_state_sha256: String,
+    pub expected_descriptor_sha256: String,
+    pub initial_model_id: String,
+}
+impl AttemptInput {
+    pub fn parse(input: &OwnerInput) -> Result<Self> {
+        let job = &input.job;
+        if !job.job_input_ref.matches(job.job_input_json.as_bytes()) {
+            return Err(OwnerError("INPUT_HASH"));
+        }
+        let value: Self = json::decode(job.job_input_json.as_bytes(), 65_536)?;
+        value.bindings.validate()?;
+        value.record_ref.validate()?;
+        let c = &value.model_config;
+        if value.version != "chess-coach.gpu-attempt-input.v1"
+            || c.version != "chess-coach.model-config.v1"
+            || c.architecture != "mlp-relu-32"
+            || c.feature_version != "chess-coach.features.v1"
+            || c.input_features != 2271
+            || c.hidden_units != 32
+            || value.record_ref.byte_length == 0
+            || value.record_ref.byte_length > FRAME_BYTES as u64
+            || c.record_sha256 != value.record_ref.sha256
+            || value.initial_model_id != value.record_ref.sha256
+            || value.initial_model_id != job.initial_model_id
+            || !json::digest(&value.initial_state_sha256)
+            || value.expected_descriptor_sha256 != job.expected_descriptor_sha256
+            || !json::digest(&value.expected_descriptor_sha256)
+        {
+            return Err(OwnerError("INPUT_BINDING"));
+        }
+        Ok(value)
+    }
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(tag = "kind", deny_unknown_fields)]
+pub enum Reply {
+    #[serde(rename = "boot")]
+    Boot {
+        version: String,
+        #[serde(rename = "sessionId")]
+        session_id: String,
+    },
+    #[serde(rename = "startup")]
+    Startup {
+        version: String,
+        #[serde(rename = "sessionId")]
+        session_id: String,
+        #[serde(rename = "attemptId")]
+        attempt_id: String,
+        #[serde(rename = "inputSha256")]
+        input_sha256: String,
+        #[serde(rename = "descriptorSha256")]
+        descriptor_sha256: String,
+        #[serde(rename = "initialModelId")]
+        initial_model_id: String,
+    },
+    #[serde(rename = "attempt-proposal")]
+    Proposal {
+        version: String,
+        #[serde(rename = "sessionId")]
+        session_id: String,
+        #[serde(rename = "attemptId")]
+        attempt_id: String,
+        #[serde(rename = "inputSha256")]
+        input_sha256: String,
+        #[serde(rename = "descriptorSha256")]
+        descriptor_sha256: String,
+        #[serde(rename = "proposalJson")]
+        proposal_json: String,
+        #[serde(rename = "proposalSha256")]
+        proposal_sha256: String,
+    },
+}
+
+pub fn start(input: &OwnerInput, elapsed: i64) -> Result<Vec<u8>> {
+    if elapsed < 0 {
+        return Err(OwnerError("START_CLOCK"));
+    }
+    let mut bytes=serde_json::to_vec(&serde_json::json!({"version":VERSION,"sessionId":input.ownership.session_id,
+        "operation":"run-attempt","attemptId":input.ownership.attempt_id,"inputJson":input.job.job_input_json,
+        "inputSha256":input.job.job_input_ref.sha256,"ownerElapsedNs":Decimal(elapsed)})).map_err(|_|OwnerError("START_SERIALIZE"))?;
+    if bytes.len() > FRAME_BYTES {
+        return Err(OwnerError("START_BOUND"));
+    }
+    bytes.push(b'\n');
+    Ok(bytes)
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Stream {
+    pub status: String,
+    #[serde(deserialize_with = "json::integer")]
+    pub root: u32,
+    #[serde(deserialize_with = "json::integer")]
+    pub state: u32,
+    #[serde(deserialize_with = "json::safe_u64")]
+    pub draw_count: u64,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Generator {
+    pub status: String,
+    #[serde(deserialize_with = "json::optional_u32")]
+    pub root: Option<u32>,
+    #[serde(deserialize_with = "json::optional_u32")]
+    pub state: Option<u32>,
+    #[serde(deserialize_with = "json::safe_u64")]
+    pub draw_count: u64,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Rng {
+    pub selection: Stream,
+    #[serde(rename = "environment-settlement")]
+    pub environment_settlement: Stream,
+    #[serde(rename = "policy-sampling")]
+    pub policy_sampling: Stream,
+    pub opponent: Stream,
+    pub generator: Generator,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Counters {
+    #[serde(deserialize_with = "json::integer")]
+    pub started: u32,
+    #[serde(deserialize_with = "json::integer")]
+    pub verified_completed: u32,
+    #[serde(deserialize_with = "json::integer")]
+    pub eligible_completed: u32,
+    #[serde(deserialize_with = "json::integer")]
+    pub updates: u32,
+    #[serde(rename = "nonzeroPGUpdates", deserialize_with = "json::integer")]
+    pub nonzero_pg_updates: u32,
+    #[serde(deserialize_with = "json::integer")]
+    pub baseline_count: u32,
+    #[serde(deserialize_with = "json::integer")]
+    pub baseline_sum: i32,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Control {
+    #[serde(deserialize_with = "json::u32_list")]
+    pub corpus_permutation: Vec<u32>,
+    #[serde(deserialize_with = "json::integer")]
+    pub corpus_cursor: u32,
+    #[serde(deserialize_with = "json::integer")]
+    pub corpus_epoch: u32,
+    #[serde(deserialize_with = "json::integer")]
+    pub schedule_cursor: u32,
+    #[serde(deserialize_with = "json::integer")]
+    pub live_ordinal: u32,
+    #[serde(deserialize_with = "json::integer")]
+    pub due_bucket: u32,
+    #[serde(deserialize_with = "json::integer")]
+    pub fulfilled_bucket: u32,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct JournalRef {
+    #[serde(deserialize_with = "json::safe_u64")]
+    pub byte_length: u64,
+    pub sha256: String,
+    #[serde(deserialize_with = "json::safe_u64")]
+    pub last_record_ordinal: u64,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct TrainingState {
+    pub version: String,
+    #[serde(deserialize_with = "json::integer")]
+    pub master: u32,
+    #[serde(deserialize_with = "json::integer")]
+    pub initialization_seed: u32,
+    pub model_id: String,
+    pub counters: Counters,
+    pub rng: Rng,
+    pub control: Control,
+    #[serde(deserialize_with = "required_option")]
+    pub journal_ref: Option<JournalRef>,
+    pub history_refs: Vec<ByteRef>,
+    pub bindings: Bindings,
+}
+
+fn required_option<'de, D: serde::Deserializer<'de>, T: Deserialize<'de>>(
+    deserializer: D,
+) -> std::result::Result<Option<T>, D::Error> {
+    Option::<T>::deserialize(deserializer)
+}
+#[derive(Clone, Debug)]
+pub enum Schedule {
+    Corpus {
+        corpus_index: u32,
+        candidate_side: String,
+    },
+    Live {
+        live_ordinal: u32,
+        candidate_side: String,
+    },
+}
+
+#[derive(Deserialize)]
+struct ScheduleKind {
+    kind: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct CorpusSchedule {
+    kind: String,
+    #[serde(deserialize_with = "json::integer")]
+    corpus_index: u32,
+    candidate_side: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct LiveSchedule {
+    kind: String,
+    #[serde(deserialize_with = "json::integer")]
+    live_ordinal: u32,
+    candidate_side: String,
+}
+
+impl<'de> Deserialize<'de> for Schedule {
+    fn deserialize<D: serde::Deserializer<'de>>(
+        deserializer: D,
+    ) -> std::result::Result<Self, D::Error> {
+        let raw = Box::<RawValue>::deserialize(deserializer)?;
+        let kind: ScheduleKind =
+            serde_json::from_str(raw.get()).map_err(serde::de::Error::custom)?;
+        match kind.kind.as_str() {
+            "corpus" => {
+                let value: CorpusSchedule =
+                    serde_json::from_str(raw.get()).map_err(serde::de::Error::custom)?;
+                if value.kind != "corpus" {
+                    return Err(serde::de::Error::custom("schedule kind"));
+                }
+                Ok(Self::Corpus {
+                    corpus_index: value.corpus_index,
+                    candidate_side: value.candidate_side,
+                })
+            }
+            "live" => {
+                let value: LiveSchedule =
+                    serde_json::from_str(raw.get()).map_err(serde::de::Error::custom)?;
+                if value.kind != "live" {
+                    return Err(serde::de::Error::custom("schedule kind"));
+                }
+                Ok(Self::Live {
+                    live_ordinal: value.live_ordinal,
+                    candidate_side: value.candidate_side,
+                })
+            }
+            _ => Err(serde::de::Error::custom("schedule kind")),
+        }
+    }
+}
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Descriptor {
+    pub version: String,
+    pub attempt_id: String,
+    #[serde(deserialize_with = "json::integer")]
+    pub master: u32,
+    #[serde(deserialize_with = "json::integer")]
+    pub started_ordinal: u32,
+    pub model_id: String,
+    pub frozen_baseline: f64,
+    pub schedule: Schedule,
+}
+
+pub fn validate_state(s: &TrainingState) -> Result<()> {
+    let c = &s.counters;
+    let k = &s.control;
+    let rng = &s.rng;
+    if s.version != "chess-coach.training-state.v1"
+        || !(101..=105).contains(&s.master)
+        || s.initialization_seed != s.master
+        || !json::digest(&s.model_id)
+        || c.started > 1000
+        || c.nonzero_pg_updates > c.updates
+        || c.updates != c.eligible_completed
+        || c.updates != c.baseline_count
+        || c.updates > c.verified_completed
+        || c.verified_completed > c.started
+        || c.baseline_sum.unsigned_abs() > c.baseline_count
+        || c.started != k.schedule_cursor
+        || k.live_ordinal != c.started / 2
+        || k.due_bucket != k.schedule_cursor / 100
+        || k.fulfilled_bucket > k.due_bucket
+        || k.due_bucket > 10
+        || k.corpus_cursor > 18
+        || k.corpus_epoch > 999
+        || k.corpus_permutation.len() != 18
+        || s.history_refs.len() != c.verified_completed as usize
+    {
+        return Err(OwnerError("STATE_COUNTERS"));
+    }
+    let mut permutation_set = std::collections::HashSet::new();
+    for n in &k.corpus_permutation {
+        if *n > 17 || !permutation_set.insert(*n) {
+            return Err(OwnerError("STATE_PERMUTATION"));
+        }
+    }
+    s.bindings.validate()?;
+    for reference in &s.history_refs {
+        reference.validate()?;
+    }
+    if let Some(j) = &s.journal_ref
+        && (j.byte_length > json::SAFE_INTEGER
+            || j.last_record_ordinal > json::SAFE_INTEGER
+            || !json::digest(&j.sha256))
+    {
+        return Err(OwnerError("STATE_JOURNAL"));
+    }
+    for (stream, active) in [
+        (&rng.selection, true),
+        (&rng.environment_settlement, false),
+        (&rng.policy_sampling, true),
+        (&rng.opponent, true),
+    ] {
+        if stream.status != if active { "active" } else { "unused" }
+            || stream.draw_count > json::SAFE_INTEGER
+            || u128::from(stream.state)
+                != (u128::from(stream.root) + u128::from(stream.draw_count) * 0x6d2b79f5)
+                    & 0xffff_ffff
+            || (!active && stream.draw_count != 0)
+        {
+            return Err(OwnerError("STATE_RNG"));
+        }
+    }
+    if rng.generator.status != "unused"
+        || rng.generator.root.is_some()
+        || rng.generator.state.is_some()
+        || rng.generator.draw_count != 0
+    {
+        return Err(OwnerError("STATE_RNG_DRAWS"));
+    }
+    Ok(())
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct ProposalRaw<'a> {
+    version: String,
+    #[serde(borrow)]
+    descriptor: &'a RawValue,
+    initial_model_id: String,
+    state: TrainingState,
+}
+
+pub fn validate_proposal(
+    bytes: &str,
+    proposal_sha256: &str,
+    descriptor_sha256: &str,
+    input: &OwnerInput,
+    embedded: &AttemptInput,
+) -> Result<()> {
+    if bytes.len() > FRAME_BYTES {
+        return Err(OwnerError("PROPOSAL_BOUND"));
+    }
+    if !json::digest(proposal_sha256) || json::sha256(bytes.as_bytes()) != proposal_sha256 {
+        return Err(OwnerError("PROPOSAL_SHA256"));
+    }
+    let raw: ProposalRaw<'_> = json::decode(bytes.as_bytes(), FRAME_BYTES)?;
+    if json::sha256(raw.descriptor.get().as_bytes()) != descriptor_sha256
+        || descriptor_sha256 != input.job.expected_descriptor_sha256
+    {
+        return Err(OwnerError("DESCRIPTOR_SHA256"));
+    }
+    let d: Descriptor =
+        serde_json::from_str(raw.descriptor.get()).map_err(|_| OwnerError("DESCRIPTOR_SCHEMA"))?;
+    validate_state(&raw.state)?;
+    let s = &raw.state;
+    if raw.version != "chess-coach.gpu-attempt-proposal.v1"
+        || raw.initial_model_id != input.job.initial_model_id
+        || d.version != "chess-coach.attempt.v1"
+        || d.attempt_id != input.ownership.attempt_id
+        || d.master != 101
+        || d.started_ordinal != 0
+        || d.model_id != raw.initial_model_id
+        || !json::identifier(&d.attempt_id, 32)
+        || !json::digest(&d.model_id)
+        || !json::digest(&raw.initial_model_id)
+        || !(-1.0..=1.0).contains(&d.frozen_baseline)
+        || s.master != 101
+        || s.counters.started != 1
+        || s.counters.verified_completed != 1
+        || s.bindings != embedded.bindings
+    {
+        return Err(OwnerError("PROPOSAL_BINDING"));
+    }
+    match d.schedule {
+        Schedule::Corpus {
+            corpus_index,
+            candidate_side,
+        } if corpus_index < 18 && candidate_side == "b" => {}
+        Schedule::Live {
+            live_ordinal,
+            candidate_side,
+        } if live_ordinal < 500 && (candidate_side == "w" || candidate_side == "b") => {}
+        _ => return Err(OwnerError("PROPOSAL_SCHEDULE")),
+    }
+    Ok(())
+}
+
+#[derive(Default)]
+pub struct Receiver {
+    offset: usize,
+    pub boot: bool,
+    pub startup: bool,
+    pub proposal_json: Option<String>,
+}
+impl Receiver {
+    pub fn receive(
+        &mut self,
+        bytes: &[u8],
+        write_complete: bool,
+        input: &OwnerInput,
+        embedded: &AttemptInput,
+    ) -> Result<bool> {
+        if bytes.len() > OUTPUT_BYTES || self.offset > bytes.len() {
+            return Err(OwnerError("WIRE_OUTPUT_BOUND"));
+        }
+        let mut booted = false;
+        while let Some(lf) = bytes[self.offset..].iter().position(|b| *b == b'\n') {
+            let end = self.offset + lf;
+            let reply: Reply = json::decode(&bytes[self.offset..end], FRAME_BYTES)?;
+            self.offset = end + 1;
+            match reply {
+                Reply::Boot {
+                    version,
+                    session_id,
+                } => {
+                    if self.boot || version != VERSION || session_id != input.ownership.session_id {
+                        return Err(OwnerError("WIRE_BOOT"));
+                    }
+                    self.boot = true;
+                    booted = true;
+                }
+                Reply::Startup {
+                    version,
+                    session_id,
+                    attempt_id,
+                    input_sha256,
+                    descriptor_sha256,
+                    initial_model_id,
+                } => {
+                    if !self.boot
+                        || self.startup
+                        || !write_complete
+                        || version != VERSION
+                        || session_id != input.ownership.session_id
+                        || attempt_id != input.ownership.attempt_id
+                        || input_sha256 != input.job.job_input_ref.sha256
+                        || descriptor_sha256 != input.job.expected_descriptor_sha256
+                        || initial_model_id != input.job.initial_model_id
+                    {
+                        return Err(OwnerError("WIRE_STARTUP"));
+                    }
+                    self.startup = true;
+                }
+                Reply::Proposal {
+                    version,
+                    session_id,
+                    attempt_id,
+                    input_sha256,
+                    descriptor_sha256,
+                    proposal_json,
+                    proposal_sha256,
+                } => {
+                    if !self.startup
+                        || self.proposal_json.is_some()
+                        || version != VERSION
+                        || session_id != input.ownership.session_id
+                        || attempt_id != input.ownership.attempt_id
+                        || input_sha256 != input.job.job_input_ref.sha256
+                        || descriptor_sha256 != input.job.expected_descriptor_sha256
+                    {
+                        return Err(OwnerError("WIRE_PROPOSAL"));
+                    }
+                    validate_proposal(
+                        &proposal_json,
+                        &proposal_sha256,
+                        &descriptor_sha256,
+                        input,
+                        embedded,
+                    )?;
+                    self.proposal_json = Some(proposal_json);
+                }
+            }
+        }
+        if bytes.len() - self.offset > FRAME_BYTES {
+            return Err(OwnerError("WIRE_FRAME_BOUND"));
+        }
+        Ok(booted)
+    }
+    pub fn finish(&self, bytes: &[u8]) -> Result<()> {
+        if !self.startup || self.proposal_json.is_none() || self.offset != bytes.len() {
+            return Err(OwnerError("WIRE_INCOMPLETE"));
+        }
+        Ok(())
+    }
+}
diff --git a/crates/gpu-owner/tests/adapters.rs b/crates/gpu-owner/tests/adapters.rs
new file mode 100644
index 000000000..e3b66d3eb
--- /dev/null
+++ b/crates/gpu-owner/tests/adapters.rs
@@ -0,0 +1,392 @@
+// SPEC: _spec/gpu-owner.md
+use chess_coach_gpu_owner::{
+    OwnerError,
+    evidence::{Evidence, Phase},
+    input::FileExpectation,
+    json,
+    linux::{self, Boottime, Clock, Executable, LinuxWaiter, Waiter, Watch},
+    process::{Limits, Process},
+    telemetry,
+};
+use rustix::event::PollFlags;
+use std::{
+    fs,
+    io::{Read, Write},
+    os::{
+        fd::AsFd,
+        unix::{
+            fs::{PermissionsExt, symlink},
+            net::UnixStream,
+        },
+    },
+    path::Path,
+    sync::Arc,
+};
+
+fn scratch() -> tempfile::TempDir {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../_work/gpu-owner-recovery/scratch");
+    fs::create_dir_all(&root).unwrap();
+    tempfile::tempdir_in(root.canonicalize().unwrap()).unwrap()
+}
+fn registered(path: &Path, bytes: &[u8]) -> FileExpectation {
+    fs::write(path, bytes).unwrap();
+    FileExpectation {
+        path: path.to_str().unwrap().into(),
+        byte_length: bytes.len() as u64,
+        sha256: json::sha256(bytes),
+    }
+}
+fn helper(root: &Path, body: &str) -> Arc<Executable> {
+    let path = root.join("helper.ts");
+    let bytes = format!("#!/usr/local/bin/bun --no-env-file\n{body}\n");
+    let expected = registered(&path, bytes.as_bytes());
+    fs::set_permissions(path, fs::Permissions::from_mode(0o700)).unwrap();
+    Arc::new(Executable::open(&expected, || Ok(())).unwrap())
+}
+fn finish(process: &mut Process) {
+    let mut waiter = LinuxWaiter;
+    let deadline = Boottime.now_ns().unwrap() + 5_000_000_000;
+    while !process.complete() {
+        process.pump().unwrap();
+        if process.complete() {
+            break;
+        }
+        waiter.wait_until(deadline, &process.watches()).unwrap();
+    }
+    assert!(process.natural_clean());
+}
+
+fn drain_cleanup(process: &mut Process) -> Vec<OwnerError> {
+    let mut errors = Vec::new();
+    let mut waiter = LinuxWaiter;
+    let deadline = Boottime.now_ns().unwrap() + 5_000_000_000;
+    while !process.complete() {
+        if let Err(error) = process.cleanup_pump() {
+            errors.push(error);
+        }
+        if !process.complete() {
+            waiter
+                .wait_until(deadline, &process.cleanup_watches())
+                .unwrap();
+        }
+    }
+    errors
+}
+
+#[test]
+fn file_hashing_checks_deadlines_exact_length_identity_and_rewinds() {
+    let root = scratch();
+    let path = root.path().join("bytes");
+    let bytes = vec![b'x'; 131073];
+    let expected = registered(&path, &bytes);
+    let mut calls = 0;
+    let mut file = linux::verified_file(&expected, || {
+        calls += 1;
+        Ok(())
+    })
+    .unwrap();
+    let mut read = Vec::new();
+    file.read_to_end(&mut read).unwrap();
+    assert_eq!(read, bytes);
+    assert!(calls >= 5);
+    let mut wrong = expected.clone();
+    wrong.sha256 = "0".repeat(64);
+    assert_eq!(
+        linux::verified_file(&wrong, || Ok(())).unwrap_err(),
+        OwnerError("FILE_SHA256")
+    );
+    let mut wrong = expected.clone();
+    wrong.byte_length += 1;
+    assert_eq!(
+        linux::verified_file(&wrong, || Ok(())).unwrap_err(),
+        OwnerError("FILE_LENGTH")
+    );
+    assert_eq!(
+        linux::verified_file(&expected, || Err(OwnerError("TEST_DEADLINE"))).unwrap_err(),
+        OwnerError("TEST_DEADLINE")
+    );
+}
+
+#[test]
+fn file_custody_rejects_symlink_leaves_and_ancestors() {
+    let root = scratch();
+    let real = root.path().join("real");
+    fs::create_dir(&real).unwrap();
+    let expected = registered(&real.join("file"), b"identity");
+    let leaf = root.path().join("leaf");
+    symlink(&expected.path, &leaf).unwrap();
+    assert!(linux::open_regular(leaf.to_str().unwrap()).is_err());
+    let ancestor = root.path().join("ancestor");
+    symlink(&real, &ancestor).unwrap();
+    assert!(linux::open_regular(ancestor.join("file").to_str().unwrap()).is_err());
+}
+
+#[test]
+fn pinned_executable_survives_path_replacement_without_fallback() {
+    let root = scratch();
+    let executable = helper(root.path(), "await Bun.write(Bun.stdout, 'pinned\\n');");
+    fs::rename(
+        root.path().join("helper.ts"),
+        root.path().join("retained.ts"),
+    )
+    .unwrap();
+    fs::write(root.path().join("helper.ts"), b"not executable").unwrap();
+    let mut process = Process::spawn(executable, &[], false, Limits::default()).unwrap();
+    finish(&mut process);
+    assert_eq!(process.stdout.prefix, b"pinned\n");
+}
+
+#[test]
+fn helper_multiplexes_large_concurrent_output_and_complete_stdin_close() {
+    let root = scratch();
+    let executable = helper(
+        root.path(),
+        "await Promise.all([Bun.write(Bun.stdout, 'o'.repeat(262144)), Bun.write(Bun.stderr, 'e'.repeat(262144))]); const data = await new Response(Bun.stdin.stream()).arrayBuffer(); await Bun.write(Bun.stdout, String(data.byteLength) + '\\n');",
+    );
+    let mut process = Process::spawn(
+        executable,
+        &[],
+        true,
+        Limits {
+            stdout: 400000,
+            stderr: 400000,
+            pending: 1048576,
+        },
+    )
+    .unwrap();
+    process.queue_and_close(vec![b'x'; 1048576]).unwrap();
+    assert!(!process.write_complete);
+    finish(&mut process);
+    assert!(process.write_complete);
+    assert_eq!(process.stderr.received, 262144);
+    assert_eq!(process.stdout.received, 262152);
+    assert!(process.stdout.prefix.ends_with(b"1048576\n"));
+}
+
+#[test]
+fn received_bytes_and_retained_prefix_have_distinct_limits() {
+    let root = scratch();
+    let executable = helper(
+        root.path(),
+        "await Bun.write(Bun.stdout, 'x'.repeat(65536));",
+    );
+    let mut process = Process::spawn(
+        executable,
+        &[],
+        false,
+        Limits {
+            stdout: 16,
+            stderr: 16,
+            pending: 0,
+        },
+    )
+    .unwrap();
+    let deadline = Boottime.now_ns().unwrap() + 5_000_000_000;
+    let mut waiter = LinuxWaiter;
+    let mut failure = None;
+    while failure.is_none() {
+        if let Err(error) = process.pump() {
+            failure = Some(error);
+            break;
+        }
+        waiter.wait_until(deadline, &process.watches()).unwrap();
+    }
+    assert_eq!(failure, Some(OwnerError("OUTPUT_BOUND")));
+    assert_eq!(process.stdout.prefix.len(), 16);
+    assert!(process.stdout.received > 16);
+    process.kill_owned().unwrap();
+    assert!(
+        drain_cleanup(&mut process)
+            .iter()
+            .all(|error| *error == OwnerError("OUTPUT_BOUND"))
+    );
+    assert!(!process.natural_clean());
+}
+
+#[test]
+fn cleanup_does_not_transmit_or_close_queued_start_input() {
+    let root = scratch();
+    let executable = helper(
+        root.path(),
+        "let bytes = 0, eof = false; void (async () => { for await (const chunk of Bun.stdin.stream()) bytes += chunk.byteLength; eof = true; })(); setInterval(() => { void Bun.write(Bun.stdout, JSON.stringify({ bytes, eof }) + '\\n'); }, 10);",
+    );
+    let mut process = Process::spawn(executable, &[], true, Limits::default()).unwrap();
+    process
+        .queue_and_close(b"{\"start\":true}\n".to_vec())
+        .unwrap();
+    assert!(
+        !process
+            .cleanup_watches()
+            .iter()
+            .any(|watch| watch.events.contains(PollFlags::OUT))
+    );
+    let deadline = Boottime.now_ns().unwrap() + 5_000_000_000;
+    let mut waiter = LinuxWaiter;
+    while !process.stdout.prefix.contains(&b'\n') {
+        process.cleanup_pump().unwrap();
+        if !process.stdout.prefix.contains(&b'\n') {
+            waiter
+                .wait_until(deadline, &process.cleanup_watches())
+                .unwrap();
+        }
+    }
+    let write_complete = process.write_complete;
+    let received = process.stdout.prefix.clone();
+    process.kill_owned().unwrap();
+    assert!(drain_cleanup(&mut process).is_empty());
+    assert!(!write_complete);
+    assert!(!process.write_complete);
+    assert_eq!(
+        serde_json::from_slice::<serde_json::Value>(
+            received.split(|byte| *byte == b'\n').next().unwrap()
+        )
+        .unwrap(),
+        serde_json::json!({"bytes":0,"eof":false})
+    );
+    assert!(!process.natural_clean());
+}
+
+#[test]
+fn cleanup_reports_new_output_faults_and_still_drains_and_reaps() {
+    let root = scratch();
+    let executable = helper(
+        root.path(),
+        "await Bun.write(Bun.stdout, 'x'.repeat(65536));",
+    );
+    let mut process = Process::spawn(
+        executable,
+        &[],
+        false,
+        Limits {
+            stdout: 16,
+            stderr: 16,
+            pending: 0,
+        },
+    )
+    .unwrap();
+    let errors = drain_cleanup(&mut process);
+    assert!(errors.contains(&OwnerError("OUTPUT_BOUND")));
+    assert_eq!(process.failure, Some(OwnerError("OUTPUT_BOUND")));
+    assert!(process.complete());
+    assert!(!process.natural_clean());
+    assert!(process.cleanup_pump().is_ok());
+}
+
+#[test]
+fn group_kill_cannot_manufacture_natural_helper_eof() {
+    let root = scratch();
+    let executable = helper(
+        root.path(),
+        "Bun.spawn([process.execPath, '--no-env-file', '--no-install', '-e', 'setInterval(() => {}, 1000)'], { stdin: 'ignore', stdout: 'inherit', stderr: 'inherit' }); console.log('valid'); process.exit(0);",
+    );
+    let mut process = Process::spawn(executable, &[], false, Limits::default()).unwrap();
+    let deadline = Boottime.now_ns().unwrap() + 5_000_000_000;
+    let mut waiter = LinuxWaiter;
+    while !process.complete() {
+        process.pump().unwrap();
+        if !process.complete() {
+            waiter.wait_until(deadline, &process.watches()).unwrap();
+        }
+    }
+    assert_eq!(process.stdout.prefix, b"valid\n");
+    assert!(process.status.unwrap().success());
+    assert!(!process.natural_clean());
+}
+
+#[test]
+fn expired_timer_wins_over_readable_io() {
+    let (mut write, read) = UnixStream::pair().unwrap();
+    write.write_all(b"ready").unwrap();
+    let deadline = Boottime.now_ns().unwrap();
+    let result = LinuxWaiter.wait_until(
+        deadline,
+        &[Watch {
+            fd: read.as_fd(),
+            events: PollFlags::IN,
+        }],
+    );
+    assert_eq!(result.unwrap_err(), OwnerError("DEADLINE"));
+}
+
+#[test]
+fn evidence_is_exclusive_counts_root_and_latches_failures_without_cleanup_io() {
+    let root = scratch();
+    let packet = root.path().join("packet");
+    let mut evidence = Evidence::create(packet.to_str().unwrap()).unwrap();
+    assert_eq!(evidence.entries, 1);
+    evidence.write("first", b"prefix", Phase::Working).unwrap();
+    assert_eq!(evidence.entries, 2);
+    assert!(
+        evidence
+            .write("first", b"replacement", Phase::Working)
+            .is_err()
+    );
+    assert!(evidence.failed);
+    assert!(evidence.write("cleanup", b"skip", Phase::Cleanup).is_ok());
+    assert!(!packet.join("cleanup").exists());
+    assert_eq!(fs::read(packet.join("first")).unwrap(), b"prefix");
+    assert!(evidence.write("working", b"stop", Phase::Working).is_err());
+    assert!(Evidence::create(packet.to_str().unwrap()).is_err());
+}
+
+#[test]
+fn replacing_the_evidence_path_latches_failure_even_with_a_pinned_directory() {
+    let root = scratch();
+    let packet = root.path().join("packet");
+    let preserved = root.path().join("preserved");
+    let mut evidence = Evidence::create(packet.to_str().unwrap()).unwrap();
+    evidence.write("first", b"kept", Phase::Working).unwrap();
+    fs::rename(&packet, &preserved).unwrap();
+    fs::write(&packet, b"replacement").unwrap();
+    assert!(
+        evidence
+            .write("next", b"not accepted", Phase::Working)
+            .is_err()
+    );
+    assert!(evidence.failed);
+    assert!(evidence.write("cleanup", b"skip", Phase::Cleanup).is_ok());
+    assert_eq!(fs::read(preserved.join("first")).unwrap(), b"kept");
+    assert!(!preserved.join("cleanup").exists());
+}
+
+#[test]
+fn telemetry_is_one_uuid_filtered_five_field_csv_not_sum_accounting() {
+    let uuid = "GPU-12345678-1234-1234-1234-123456789abc";
+    let good = format!("{uuid}, fixture, 10, 9, 9\n");
+    let sample = telemetry::decode(good.as_bytes(), uuid, "fixture", 123).unwrap();
+    assert_eq!(sample.free_bytes.0, 9 * 1048576);
+    assert_eq!(sample.observed_boottime_ns.0, 123);
+    for line in [
+        good.trim_end().to_string(),
+        format!("{good}{good}"),
+        good.replace(", 10,", ", 010,"),
+        good.replace(", 10,", ", 1e1,"),
+        good.replace(", 10,", ", 0,"),
+        good.replace(", 9,", ", 11,"),
+        good.replace("fixture", "wrong"),
+        good.replace("\n", "\r\n"),
+    ] {
+        assert!(
+            telemetry::decode(line.as_bytes(), uuid, "fixture", 123).is_err(),
+            "{line}"
+        );
+    }
+    let args = telemetry::argv(uuid);
+    assert_eq!(args.len(), 3);
+    assert!(args[0].contains(uuid));
+    assert!(!args.iter().any(|s| s == "--query-compute-apps"));
+}
+
+#[test]
+fn cpu_ranges_are_bounded_sorted_and_unique() {
+    assert_eq!(
+        chess_coach_gpu_owner::observe::parse_cpuset("2-4,7\n").unwrap(),
+        vec![2, 3, 4, 7]
+    );
+    for value in ["", "1,1", "0-9999999", "2-1", "01", "-1", "1--2"] {
+        assert!(
+            chess_coach_gpu_owner::observe::parse_cpuset(value).is_err(),
+            "{value}"
+        );
+    }
+}
