+#[test]
+fn startup_requires_completed_write_and_closed_stdin_not_queue_intent() {
+    let f = fixture();
+    let mut receiver = Receiver::default();
+    let mut output = boot();
+    assert!(
+        receiver
+            .receive(&output, false, &f.input, &f.embedded)
+            .unwrap()
+    );
+    output.extend(startup(&f));
+    assert!(
+        receiver
+            .receive(&output, false, &f.input, &f.embedded)
+            .is_err()
+    );
+    let mut receiver = Receiver::default();
+    let mut output = boot();
+    receiver
+        .receive(&output, false, &f.input, &f.embedded)
+        .unwrap();
+    output.extend(startup(&f));
+    receiver
+        .receive(&output, true, &f.input, &f.embedded)
+        .unwrap();
+    assert!(receiver.startup);
+    assert!(receiver.finish(&output).is_err());
+    let proposal_json = serde_json::to_string(&f.proposal).unwrap();
+    output.extend(frame(json!({"version":wire::VERSION,"sessionId":"session","kind":"attempt-proposal","attemptId":"attempt","inputSha256":f.input.job.job_input_ref.sha256,
+        "descriptorSha256":f.input.job.expected_descriptor_sha256,"proposalSha256":json::sha256(proposal_json.as_bytes()),"proposalJson":proposal_json})));
+    receiver
+        .receive(&output, true, &f.input, &f.embedded)
+        .unwrap();
+    receiver.finish(&output).unwrap();
+    assert!(receiver.proposal_json.is_some());
+    output.extend(boot());
+    assert!(
+        receiver
+            .receive(&output, true, &f.input, &f.embedded)
+            .is_err()
+    );
+}
+
+#[test]
+fn start_serializes_exact_bound_identity_and_decimal_elapsed() {
+    let f = fixture();
+    let bytes = wire::start(&f.input, 123).unwrap();
+    assert!(bytes.ends_with(b"\n"));
+    let value: Value = serde_json::from_slice(&bytes).unwrap();
+    assert_eq!(value["ownerElapsedNs"], "123");
+    assert_eq!(value["inputJson"], f.input.job.job_input_json);
+    assert_eq!(value.as_object().unwrap().len(), 7);
+    assert!(wire::start(&f.input, -1).is_err());
+}
+
+fn zero_integer_proposal(f: &Fixture) -> Value {
+    let mut proposal = f.proposal.clone();
+    proposal["descriptor"]["schedule"]["corpusIndex"] = json!(0);
+    proposal["state"]["control"]["corpusPermutation"] = json!((0..18).collect::<Vec<u32>>());
+    proposal["state"]["control"]["corpusCursor"] = json!(0);
+    proposal["state"]["journalRef"]["byteLength"] = json!(0);
+    proposal["state"]["journalRef"]["lastRecordOrdinal"] = json!(0);
+    proposal["state"]["historyRefs"][0]["byteLength"] = json!(0);
+    for label in [
+        "selection",
+        "environment-settlement",
+        "policy-sampling",
+        "opponent",
+    ] {
+        proposal["state"]["rng"][label]["root"] = json!(0);
+        proposal["state"]["rng"][label]["state"] = json!(0);
+        proposal["state"]["rng"][label]["drawCount"] = json!(0);
+    }
+    proposal
+}
+
+fn negative_zero_integer_literals(text: &str) -> String {
+    text.replace(":0,", ":-0,")
+        .replace(":0}", ":-0}")
+        .replace("[0,", "[-0,")
+        .replace("\"frozenBaseline\":-0", "\"frozenBaseline\":0")
+}
+
+fn literal_at(value: &Value, pointer: &str, token: &str) -> String {
+    let mut value = value.clone();
+    *value.pointer_mut(pointer).unwrap() = json!("__INTEGER_TOKEN__");
+    serde_json::to_string(&value)
+        .unwrap()
+        .replace("\"__INTEGER_TOKEN__\"", token)
+}
+
+#[test]
+fn literal_negative_zero_integer_fields_preserve_structural_state_and_exact_descriptor_bytes() {
+    let f = fixture();
+    let proposal = zero_integer_proposal(&f);
+    let canonical = serde_json::to_string(&proposal).unwrap();
+    let canonical_descriptor = serde_json::to_string(&proposal["descriptor"]).unwrap();
+    let canonical_pin = json::sha256(canonical_descriptor.as_bytes());
+    let mut input = f.input.clone();
+    input.job.expected_descriptor_sha256 = canonical_pin.clone();
+    wire::validate_proposal(
+        &canonical,
+        &json::sha256(canonical.as_bytes()),
+        &canonical_pin,
+        &input,
+        &f.embedded,
+    )
+    .unwrap();
+    let text = negative_zero_integer_literals(&canonical);
+    let descriptor = negative_zero_integer_literals(&canonical_descriptor);
+    assert!(text.contains("\"historyRefs\":[{\"byteLength\":-0"));
+    assert!(text.contains("\"corpusPermutation\":[-0,1"));
+    assert!(text.contains("\"baselineSum\":-0"));
+    assert!(text.contains("\"root\":-0"));
+    assert!(text.contains("\"state\":-0"));
+    assert!(text.contains("\"drawCount\":-0"));
+    assert!(descriptor.contains("\"startedOrdinal\":-0"));
+    assert!(descriptor.contains("\"corpusIndex\":-0"));
+    assert!(descriptor.contains("\"frozenBaseline\":0,"));
+    assert_eq!(
+        wire::validate_proposal(
+            &text,
+            &json::sha256(text.as_bytes()),
+            &canonical_pin,
+            &input,
+            &f.embedded
+        )
+        .unwrap_err(),
+        chess_coach_gpu_owner::OwnerError("DESCRIPTOR_SHA256")
+    );
+    let pin = json::sha256(descriptor.as_bytes());
+    assert_ne!(pin, canonical_pin);
+    input.job.expected_descriptor_sha256 = pin.clone();
+    wire::validate_proposal(
+        &text,
+        &json::sha256(text.as_bytes()),
+        &pin,
+        &input,
+        &f.embedded,
+    )
+    .unwrap();
+    let original: wire::TrainingState =
+        serde_json::from_str(&serde_json::to_string(&proposal["state"]).unwrap()).unwrap();
+    let changed: wire::TrainingState = serde_json::from_str(&negative_zero_integer_literals(
+        &serde_json::to_string(&proposal["state"]).unwrap(),
+    ))
+    .unwrap();
+    wire::validate_state(&changed).unwrap();
+    assert_eq!(
+        serde_json::to_value(changed).unwrap(),
+        serde_json::to_value(original).unwrap()
+    );
+}
+
+#[test]
+fn literal_negative_zero_live_schedule_uses_the_exact_new_descriptor_pin() {
+    let f = fixture();
+    let mut proposal = zero_integer_proposal(&f);
+    proposal["descriptor"]["schedule"] = json!({"kind":"live","liveOrdinal":0,"candidateSide":"w"});
+    let canonical = serde_json::to_string(&proposal).unwrap();
+    let canonical_descriptor = serde_json::to_string(&proposal["descriptor"]).unwrap();
+    let old_pin = json::sha256(canonical_descriptor.as_bytes());
+    let descriptor = negative_zero_integer_literals(&canonical_descriptor);
+    let text = canonical.replacen(&canonical_descriptor, &descriptor, 1);
+    assert!(descriptor.contains("\"liveOrdinal\":-0"));
+    let mut input = f.input.clone();
+    input.job.expected_descriptor_sha256 = old_pin.clone();
+    assert_eq!(
+        wire::validate_proposal(
+            &text,
+            &json::sha256(text.as_bytes()),
+            &old_pin,
+            &input,
+            &f.embedded
+        )
+        .unwrap_err(),
+        chess_coach_gpu_owner::OwnerError("DESCRIPTOR_SHA256")
+    );
+    let pin = json::sha256(descriptor.as_bytes());
+    input.job.expected_descriptor_sha256 = pin.clone();
+    wire::validate_proposal(
+        &text,
+        &json::sha256(text.as_bytes()),
+        &pin,
+        &input,
+        &f.embedded,
+    )
+    .unwrap();
+}
+
+#[test]
+fn typed_wire_integer_fields_reject_fraction_exponent_and_coercion_tokens() {
+    let f = fixture();
+    let proposal = zero_integer_proposal(&f);
+    for pointer in [
+        "/master",
+        "/initializationSeed",
+        "/counters/started",
+        "/counters/verifiedCompleted",
+        "/counters/eligibleCompleted",
+        "/counters/updates",
+        "/counters/nonzeroPGUpdates",
+        "/counters/baselineCount",
+        "/counters/baselineSum",
+        "/control/corpusPermutation/0",
+        "/control/corpusCursor",
+        "/control/corpusEpoch",
+        "/control/scheduleCursor",
+        "/control/liveOrdinal",
+        "/control/dueBucket",
+        "/control/fulfilledBucket",
+        "/rng/selection/root",
+        "/rng/selection/state",
+        "/rng/selection/drawCount",
+        "/rng/environment-settlement/root",
+        "/rng/environment-settlement/state",
+        "/rng/environment-settlement/drawCount",
+        "/rng/policy-sampling/root",
+        "/rng/policy-sampling/state",
+        "/rng/policy-sampling/drawCount",
+        "/rng/opponent/root",
+        "/rng/opponent/state",
+        "/rng/opponent/drawCount",
+        "/rng/generator/root",
+        "/rng/generator/state",
+        "/rng/generator/drawCount",
+        "/journalRef/byteLength",
+        "/journalRef/lastRecordOrdinal",
+        "/historyRefs/0/byteLength",
+        "/bindings/source/byteLength",
+    ] {
+        for token in ["-0.0", "-0e0", "0.0", "0e0", "1.0", "1e0", "true", "\"0\""] {
+            let text = literal_at(&proposal["state"], pointer, token);
+            assert_eq!(
+                json::decode::<wire::TrainingState>(text.as_bytes(), wire::FRAME_BYTES)
+                    .unwrap_err(),
+                chess_coach_gpu_owner::OwnerError("JSON_SCHEMA"),
+                "{pointer} = {token}"
+            );
+        }
+    }
+    for pointer in ["/master", "/startedOrdinal", "/schedule/corpusIndex"] {
+        for token in ["-0.0", "-0e0", "1.0", "1e0", "true", "\"0\""] {
+            let text = literal_at(&proposal["descriptor"], pointer, token);
+            assert!(
+                serde_json::from_str::<wire::Descriptor>(&text).is_err(),
+                "{pointer} = {token}"
+            );
+        }
+    }
+    let model: Value =
+        serde_json::from_str::<Value>(&f.input.job.job_input_json).unwrap()["modelConfig"].clone();
+    for pointer in ["/inputFeatures", "/hiddenUnits"] {
+        let text = literal_at(&model, pointer, "-0");
+        let parsed: wire::ModelConfig = serde_json::from_str(&text).unwrap();
+        assert_eq!(
+            if pointer == "/inputFeatures" {
+                parsed.input_features
+            } else {
+                parsed.hidden_units
+            },
+            0
+        );
+        for token in ["-0.0", "-0e0", "1.0", "1e0", "true", "\"0\""] {
+            assert!(
+                serde_json::from_str::<wire::ModelConfig>(&literal_at(&model, pointer, token))
+                    .is_err(),
+                "{pointer} = {token}"
+            );
+        }
+    }
+    let unsafe_count = literal_at(
+        &proposal["state"],
+        "/historyRefs/0/byteLength",
+        "9007199254740992",
+    );
+    assert!(
+        json::decode::<wire::TrainingState>(unsafe_count.as_bytes(), wire::FRAME_BYTES).is_err()
+    );
+    let decimal_input = literal_at(
+        &serde_json::from_str::<Value>(&f.input.job.job_input_json).unwrap(),
+        "/modelConfig/inputFeatures",
+        "2271.0",
+    );
+    let mut input = f.input.clone();
+    input.job.job_input_json = decimal_input;
+    input.job.job_input_ref.byte_length = input.job.job_input_json.len() as u64;
+    input.job.job_input_ref.sha256 = json::sha256(input.job.job_input_json.as_bytes());
+    assert!(AttemptInput::parse(&input).is_err());
+}
+
+#[test]
+fn raw_schedule_decoding_keeps_variants_fields_and_integer_grammar_closed() {
+    assert!(matches!(
+        serde_json::from_str::<wire::Schedule>(
+            r#"{"corpusIndex":-0,"candidateSide":"b","kind":"corpus"}"#
+        )
+        .unwrap(),
+        wire::Schedule::Corpus {
+            corpus_index: 0,
+            ..
+        }
+    ));
+    assert!(matches!(
+        serde_json::from_str::<wire::Schedule>(
+            r#"{"kind":"live","liveOrdinal":-0,"candidateSide":"w"}"#
+        )
+        .unwrap(),
+        wire::Schedule::Live {
+            live_ordinal: 0,
+            ..
+        }
+    ));
+    for field in ["corpusIndex", "liveOrdinal"] {
+        let kind = if field == "corpusIndex" {
+            "corpus"
+        } else {
+            "live"
+        };
+        for token in [
+            "-0.0",
+            "-0e0",
+            "0.0",
+            "1.0",
+            "1e0",
+            "-1",
+            "4294967296",
+            "true",
+            "\"0\"",
+        ] {
+            let text =
+                format!("{{\"kind\":\"{kind}\",\"{field}\":{token},\"candidateSide\":\"b\"}}");
+            assert!(
+                serde_json::from_str::<wire::Schedule>(&text).is_err(),
+                "{text}"
+            );
+        }
+    }
+    for text in [
+        r#"{"kind":"other","corpusIndex":0,"candidateSide":"b"}"#,
+        r#"{"kind":"corpus","liveOrdinal":0,"candidateSide":"b"}"#,
+        r#"{"kind":"live","corpusIndex":0,"candidateSide":"b"}"#,
+        r#"{"kind":"corpus","corpusIndex":0,"candidateSide":"b","extra":0}"#,
+        r#"{"kind":"live","liveOrdinal":0,"candidateSide":"b","extra":0}"#,
+        r#"{"kind":"corpus","candidateSide":"b"}"#,
+        r#"{"kind":"live","candidateSide":"w"}"#,
+        r#"{"kind":"corpus","corpusIndex":0}"#,
+        r#"{"corpusIndex":0,"candidateSide":"b"}"#,
+        r#"{"kind":"corpus","kind":"live","corpusIndex":0,"candidateSide":"b"}"#,
+    ] {
+        assert!(
+            serde_json::from_str::<wire::Schedule>(text).is_err(),
+            "{text}"
+        );
+    }
+    let generator: wire::Generator =
+        serde_json::from_str(r#"{"status":"unused","root":-0,"state":-0,"drawCount":-0}"#).unwrap();
+    assert_eq!(generator.root, Some(0));
+    assert_eq!(generator.state, Some(0));
+    assert_eq!(generator.draw_count, 0);
+    for text in [
+        r#"{"status":"unused","state":null,"drawCount":0}"#,
+        r#"{"status":"unused","root":null,"drawCount":0}"#,
+    ] {
+        assert!(serde_json::from_str::<wire::Generator>(text).is_err());
+    }
+}
diff --git a/packages/contracts/src/gpu-job.ts b/packages/contracts/src/gpu-job.ts
new file mode 100644
index 000000000..be2bc4e0a
--- /dev/null
+++ b/packages/contracts/src/gpu-job.ts
@@ -0,0 +1,117 @@
+// SPEC: _spec/gpu-owner.md, _spec/gpu-owner.puml
+import { createHash } from "node:crypto";
+import { z } from "zod";
+import { modelConfigShape } from "./learning-channel";
+import { attemptDescriptorShape, bindingsShape, byteRefShape, trainingStateShape } from "./training-state";
+import type { TrainingState } from "./training-state";
+
+export const GPU_JOB_VERSION = "chess-coach.gpu-job.v1" as const;
+export const MAX_GPU_JOB_FRAME_BYTES = 1048576;
+export const MAX_GPU_JOB_OUTPUT_BYTES = 3 * (MAX_GPU_JOB_FRAME_BYTES + 1);
+export const MAX_GPU_ATTEMPT_INPUT_BYTES = 65536;
+const digest = z.string().regex(/^[a-f0-9]{64}$/), session = z.string().regex(/^[A-Za-z0-9._:-]{1,64}$/);
+const attempt = z.string().regex(/^[A-Za-z0-9._:-]{1,32}$/);
+const elapsed = z.string().regex(/^(0|[1-9][0-9]{0,18})$/).refine(value => BigInt(value) <= 9223372036854775807n);
+const boundedString = (max: number) => z.string().max(max).refine(value => Buffer.byteLength(value) <= max);
+export const gpuJobStartShape = z.strictObject({ version: z.literal(GPU_JOB_VERSION), sessionId: session, operation: z.literal("run-attempt"),
+  attemptId: attempt, inputJson: boundedString(MAX_GPU_ATTEMPT_INPUT_BYTES), inputSha256: digest, ownerElapsedNs: elapsed });
+export const gpuJobReplyShape = z.discriminatedUnion("kind", [
+  z.strictObject({ version: z.literal(GPU_JOB_VERSION), sessionId: session, kind: z.literal("boot") }),
+  z.strictObject({ version: z.literal(GPU_JOB_VERSION), sessionId: session, kind: z.literal("startup"), attemptId: attempt,
+    inputSha256: digest, descriptorSha256: digest, initialModelId: digest }),
+  z.strictObject({ version: z.literal(GPU_JOB_VERSION), sessionId: session, kind: z.literal("attempt-proposal"), attemptId: attempt,
+    inputSha256: digest, descriptorSha256: digest, proposalJson: boundedString(MAX_GPU_JOB_FRAME_BYTES), proposalSha256: digest }),
+]);
+export const gpuAttemptInputShape = z.strictObject({ version: z.literal("chess-coach.gpu-attempt-input.v1"), bindings: bindingsShape,
+  modelConfig: modelConfigShape, recordRef: byteRefShape.extend({ byteLength: z.int().min(1).max(1048576) }),
+  initialStateSha256: digest, expectedDescriptorSha256: digest, initialModelId: digest }).refine(value =>
+    value.modelConfig.recordSha256 === value.recordRef.sha256 && value.initialModelId === value.recordRef.sha256, { message: "GPU input model binding" });
+export type GpuJobStart = z.infer<typeof gpuJobStartShape>;
+export type GpuJobReply = z.infer<typeof gpuJobReplyShape>;
+export type GpuAttemptInput = z.infer<typeof gpuAttemptInputShape>;
+export const gpuJobSha256 = (bytes: string | Uint8Array): string => createHash("sha256").update(bytes).digest("hex");
+
+function closedDocument(json: string, maxBytes: number): { value: unknown; tokens: Map<string, string> } {
+  if (json.length > maxBytes || Buffer.byteLength(json) > maxBytes || Buffer.from(json).toString("utf8") !== json) throw new Error("GPU JSON: BYTE_BOUND_OR_UTF8");
+  let at = 0, nodes = 0;
+  const tokens = new Map<string, string>();
+  const fail = (): never => { throw new Error("GPU JSON: CLOSED_JSON"); };
+  const space = () => { while (at < json.length && " \t\r\n".includes(json[at]!)) at++; };
+  const string = (): string => {
+    const start = at++;
+    while (at < json.length) {
+      const char = json[at++]!;
+      if (char === '"') return JSON.parse(json.slice(start, at)) as string;
+      if (char === "\\") at++;
+    }
+    return fail();
+  };
+  const value = (depth: number): void => {
+    if (depth > 32 || ++nodes > 16384) fail();
+    space();
+    const char = json[at];
+    if (char === "{") {
+      at++; space();
+      const keys = new Set<string>();
+      if (json[at] === "}") { at++; return; }
+      for (;;) {
+        if (json[at] !== '"' || ++nodes > 16384) fail();
+        const key = string();
+        if (keys.has(key)) fail();
+        keys.add(key); space();
+        if (json[at++] !== ":") fail();
+        space(); const start = at;
+        value(depth + 1);
+        if (depth === 0) tokens.set(key, json.slice(start, at));
+        space(); const end = json[at++];
+        if (end === "}") return;
+        if (end !== ",") fail();
+        space();
+      }
+    }
+    if (char === "[") {
+      at++; space();
+      if (json[at] === "]") { at++; return; }
+      for (;;) {
+        value(depth + 1); space(); const end = json[at++];
+        if (end === "]") return;
+        if (end !== ",") fail();
+      }
+    }
+    if (char === '"') { string(); return; }
+    for (const literal of ["true", "false", "null"]) if (json.startsWith(literal, at)) { at += literal.length; return; }
+    const start = at;
+    while (at < json.length && "-+0123456789.eE".includes(json[at]!)) at++;
+    if (at === start) fail();
+    const number: unknown = JSON.parse(json.slice(start, at));
+    if (typeof number !== "number" || !Number.isFinite(number) || Number.isInteger(number) && !Number.isSafeInteger(number)) fail();
+  };
+  value(0); space();
+  if (at !== json.length) fail();
+  return { value: JSON.parse(json) as unknown, tokens };
+}
+export function parseClosedJson(json: string, maxBytes = MAX_GPU_JOB_FRAME_BYTES): unknown { return closedDocument(json, maxBytes).value; }
+export function decodeGpuJobStart(json: string): GpuJobStart { return gpuJobStartShape.parse(parseClosedJson(json)); }
+export function decodeGpuJobReply(json: string): GpuJobReply { return gpuJobReplyShape.parse(parseClosedJson(json)); }
+export function decodeGpuAttemptInput(json: string, expectedSha256?: string): GpuAttemptInput {
+  const parsed = parseClosedJson(json, MAX_GPU_ATTEMPT_INPUT_BYTES);
+  if (expectedSha256 !== undefined && gpuJobSha256(json) !== expectedSha256) throw new Error("GPU input: HASH");
+  return gpuAttemptInputShape.parse(parsed);
+}
+
+export function checkGpuTrainingState(input: unknown): TrainingState {
+  return trainingStateShape.parse(input);
+}
+export const gpuAttemptProposalShape = z.strictObject({ version: z.literal("chess-coach.gpu-attempt-proposal.v1"), descriptor: attemptDescriptorShape,
+  initialModelId: digest, state: trainingStateShape }).superRefine((value, context) => {
+    const { descriptor: d, state: s } = value;
+    if (d.master !== 101 || d.startedOrdinal !== 0 || d.attemptId.length > 32 || d.modelId !== value.initialModelId ||
+      s.master !== 101 || s.counters.started !== 1 || s.counters.verifiedCompleted !== 1) context.addIssue({ code: "custom", message: "GPU proposal binding" });
+  });
+export type GpuAttemptProposal = z.infer<typeof gpuAttemptProposalShape>;
+export function decodeGpuAttemptProposal(json: string, expectedProposalSha256?: string, expectedDescriptorSha256?: string): GpuAttemptProposal {
+  const parsed = closedDocument(json, MAX_GPU_JOB_FRAME_BYTES), token = parsed.tokens.get("descriptor");
+  if (expectedProposalSha256 !== undefined && gpuJobSha256(json) !== expectedProposalSha256) throw new Error("GPU proposal: HASH");
+  if (token === undefined || expectedDescriptorSha256 !== undefined && gpuJobSha256(token) !== expectedDescriptorSha256) throw new Error("GPU proposal: DESCRIPTOR_HASH");
+  return gpuAttemptProposalShape.parse(parsed.value);
+}
diff --git a/packages/runtime/tests/fixtures/gpu-owner/driver.ts b/packages/runtime/tests/fixtures/gpu-owner/driver.ts
new file mode 100644
index 000000000..a460fce36
--- /dev/null
+++ b/packages/runtime/tests/fixtures/gpu-owner/driver.ts
@@ -0,0 +1,16 @@
+// SPEC: _spec/gpu-owner.md, _spec/gpu-owner.puml
+import { readFileSync } from "node:fs";
+import { parseClosedJson } from "../../../../contracts/src/gpu-job";
+import { runGpuJobLoop } from "../../../src/gpu-job";
+import { syntheticCorpus } from "../../match-fixture";
+import type { GpuOwnerFixture } from "./register";
+
+if (import.meta.main) {
+  try {
+    const registered = parseClosedJson(readFileSync(`${import.meta.path}.layout.json`, "utf8")) as GpuOwnerFixture;
+    const [sessionId] = Bun.argv.slice(2);
+    if (Bun.argv.length !== 3 || sessionId !== registered.sessionId) throw new Error("GPU fixture driver: SESSION");
+    await runGpuJobLoop({ sessionId, layout: registered.layout, input: Bun.stdin.stream(),
+      write: async json => { await Bun.write(Bun.stdout, json + "\n"); }, loadCorpus: async () => syntheticCorpus(0), loadStrategic: async () => null });
+  } catch (error) { await Bun.write(Bun.stderr, String(error) + "\n"); process.exitCode = 1; }
+}
diff --git a/packages/runtime/tests/fixtures/gpu-owner/learner.ts b/packages/runtime/tests/fixtures/gpu-owner/learner.ts
new file mode 100644
index 000000000..4e19620ba
--- /dev/null
+++ b/packages/runtime/tests/fixtures/gpu-owner/learner.ts
@@ -0,0 +1,27 @@
+// SPEC: _spec/gpu-owner.md, _spec/gpu-owner.puml
+import { readFileSync, writeFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { gpuJobSha256, parseClosedJson } from "../../../../contracts/src/gpu-job";
+import { learningRequestShape, modelConfigShape } from "../../../../contracts/src/learning-channel";
+import { jsonLines } from "../../../src/framing";
+
+if (import.meta.main) {
+  try {
+    const [configPath, recordPath, sessionId] = Bun.argv.slice(2);
+    if (Bun.argv.length !== 5 || !configPath || !recordPath || !sessionId || !/:[ab]$/.test(sessionId)) throw new Error("GPU fixture learner: ARGUMENTS");
+    const config = modelConfigShape.parse(parseClosedJson(readFileSync(configPath, "utf8"))), record = readFileSync(recordPath);
+    if (gpuJobSha256(record) !== config.recordSha256) throw new Error("GPU fixture learner: RECORD");
+    const events: string[] = [], suffix = sessionId.slice(-1), root = dirname(import.meta.path);
+    writeFileSync(join(root, `learner-${suffix}.started.json`), JSON.stringify({ pid: process.pid, sessionId, configPath, recordPath }) + "\n", { flag: "wx", mode: 0o600 });
+    for await (const frame of jsonLines(Bun.stdin.stream(), 1048576, 3 * 1048577, process.hrtime.bigint, true)) {
+      const request = learningRequestShape.parse(parseClosedJson(frame.json)), expected = ["begin", "finish", "close"][events.length];
+      if (request.sessionId !== sessionId || request.modelId !== config.recordSha256 || request.ordinal !== events.length || request.command.kind !== expected) throw new Error("GPU fixture learner: SEQUENCE");
+      events.push(request.command.kind);
+      writeFileSync(join(root, `learner-${suffix}.events.json`), JSON.stringify(events) + "\n", { mode: 0o600 });
+      const kind = expected === "begin" ? "begun" : expected === "finish" ? "diagnostic" : "closed";
+      await Bun.write(Bun.stdout, JSON.stringify({ version: request.version, sessionId, ordinal: request.ordinal, modelId: request.modelId, result: { kind } }) + "\n");
+    }
+    if (events.join(",") !== "begin,finish,close") throw new Error("GPU fixture learner: MISSING_CLOSE");
+    writeFileSync(join(root, `learner-${suffix}.receipt.json`), JSON.stringify({ pid: process.pid, stdinEof: true, sessionId, configPath, recordPath, events }) + "\n", { flag: "wx", mode: 0o600 });
+  } catch (error) { await Bun.write(Bun.stderr, String(error) + "\n"); process.exitCode = 1; }
+}
diff --git a/packages/runtime/tests/fixtures/gpu-owner/match.ts b/packages/runtime/tests/fixtures/gpu-owner/match.ts
new file mode 100644
index 000000000..6349048aa
--- /dev/null
+++ b/packages/runtime/tests/fixtures/gpu-owner/match.ts
@@ -0,0 +1,19 @@
+// SPEC: _spec/gpu-owner.md, _spec/gpu-owner.puml
+import { writeFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { MatchWorker } from "../../../src/match-worker";
+import { runMatchWorkerLoop } from "../../../src/match-worker-main";
+import { SyntheticMatchScorer, syntheticCorpus } from "../../match-fixture";
+
+if (import.meta.main) {
+  try {
+    const [attemptId, modelId, remaining] = Bun.argv.slice(2), clock = process.hrtime.bigint;
+    if (Bun.argv.length !== 5 || !attemptId || !modelId || !remaining) throw new Error("GPU fixture match: ARGUMENTS");
+    writeFileSync(join(dirname(import.meta.path), "match.started.json"), JSON.stringify({ pid: process.pid }) + "\n", { flag: "wx", mode: 0o600 });
+    const scorer = new SyntheticMatchScorer(clock);
+    await runMatchWorkerLoop(new MatchWorker(attemptId, { corpus: syntheticCorpus(0), strategic: null, scorer, modelId, clockNs: clock,
+      workDeadlineNs: clock() + BigInt(remaining) }));
+    writeFileSync(join(dirname(import.meta.path), "match.receipt.json"), JSON.stringify({ pid: process.pid, stdinEof: true, scores: scorer.scores,
+      scorerClosed: scorer.closed, scorerStopped: scorer.stopped }) + "\n", { flag: "wx", mode: 0o600 });
+  } catch (error) { await Bun.write(Bun.stderr, String(error) + "\n"); process.exitCode = 1; }
+}
diff --git a/packages/runtime/tests/fixtures/gpu-owner/register.ts b/packages/runtime/tests/fixtures/gpu-owner/register.ts
new file mode 100644
index 000000000..53bc82c63
--- /dev/null
+++ b/packages/runtime/tests/fixtures/gpu-owner/register.ts
@@ -0,0 +1,42 @@
+// SPEC: _spec/gpu-owner.md, _spec/gpu-owner.puml
+import { chmodSync, lstatSync, readFileSync, readdirSync, realpathSync, writeFileSync } from "node:fs";
+import { dirname, isAbsolute, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { gpuJobSha256, GPU_JOB_VERSION } from "../../../../contracts/src/gpu-job";
+import { initialTrainingState, nextAttempt } from "../../../src/curriculum";
+import type { GpuJobLayout } from "../../../src/gpu-job";
+import { bindings, syntheticRecord } from "../../training-fixture";
+
+export function registerGpuOwnerFixture(existingExclusivePrivateRoot: string, bunExecutable = "/usr/local/bin/bun") {
+  const root = existingExclusivePrivateRoot, stat = lstatSync(root);
+  if (!isAbsolute(root) || realpathSync(root) !== root || !stat.isDirectory() || (stat.mode & 0o077) !== 0 || readdirSync(root).length !== 0 ||
+    !isAbsolute(bunExecutable) || /[\s\0]/.test(bunExecutable)) throw new Error("GPU fixture: EXCLUSIVE_PRIVATE_ROOT_OR_BUN");
+  const here = dirname(fileURLToPath(import.meta.url)), driverPath = join(root, "driver.ts"), layoutPath = `${driverPath}.layout.json`;
+  const sessionId = "gpu-owner-fixture", attemptId = "gpu-attempt-0", model = syntheticRecord("gpu-owner-synthetic-initial-not-a-burn-record");
+  const initialState = initialTrainingState(101, model.config.recordSha256, bindings()), { descriptor } = nextAttempt(initialState, attemptId);
+  const initialModelId = model.config.recordSha256, expectedDescriptorSha256 = gpuJobSha256(JSON.stringify(descriptor));
+  const layout: GpuJobLayout = { initialRecordPath: join(root, "initial-model.bpk"), stateRoot: join(root, "state"), factory: {
+    scratchRoot: join(root, "scratch-model"), cwd: root, bunExecutable, learnerExecutable: join(root, "learner.ts"), matchEntrypoint: join(root, "match.ts") } };
+  const inputJson = JSON.stringify({ version: "chess-coach.gpu-attempt-input.v1", bindings: initialState.bindings, modelConfig: model.config,
+    recordRef: { byteLength: model.record.byteLength, sha256: initialModelId }, initialStateSha256: gpuJobSha256(JSON.stringify(initialState)), expectedDescriptorSha256, initialModelId });
+  const inputSha256 = gpuJobSha256(inputJson);
+  const startJson = JSON.stringify({ version: GPU_JOB_VERSION, sessionId, operation: "run-attempt", attemptId, inputJson, inputSha256, ownerElapsedNs: "0" });
+  for (const name of ["driver.ts", "match.ts", "learner.ts"]) {
+    const original = readFileSync(join(here, name), "utf8");
+    const rewritten = original.replace(/(from\s+")([.][.\w/-]*)(")/g, (_, before: string, path: string, after: string) => `${before}${resolve(here, path)}${after}`);
+    const path = join(root, name);
+    writeFileSync(path, (name === "learner.ts" ? `#!${bunExecutable}\n` : "") + rewritten, { flag: "wx", mode: 0o600 });
+    if (name === "learner.ts") chmodSync(path, 0o700);
+  }
+  writeFileSync(layout.initialRecordPath, model.record, { flag: "wx", mode: 0o400 });
+  const registration = { driverPath, layoutPath, sessionId, attemptId, inputJson, inputSha256, initialModelId, expectedDescriptorSha256,
+    layout, initialState, descriptor, startJson };
+  writeFileSync(layoutPath, JSON.stringify(registration) + "\n", { flag: "wx", mode: 0o600 });
+  return registration;
+}
+export type GpuOwnerFixture = ReturnType<typeof registerGpuOwnerFixture>;
+if (import.meta.main) {
+  const [root, bunExecutable] = Bun.argv.slice(2);
+  if (!root || Bun.argv.length > 4) throw new Error("GPU fixture: ARGUMENTS");
+  console.log(JSON.stringify(registerGpuOwnerFixture(root, bunExecutable)));
+}
diff --git a/packages/runtime/tests/fixtures/gpu-owner/support.ts b/packages/runtime/tests/fixtures/gpu-owner/support.ts
new file mode 100644
index 000000000..48b67afe3
--- /dev/null
+++ b/packages/runtime/tests/fixtures/gpu-owner/support.ts
@@ -0,0 +1,12 @@
+// SPEC: _spec/gpu-owner.md, _spec/gpu-owner.puml
+import { mkdirSync, mkdtempSync } from "node:fs";
+import { resolve } from "node:path";
+
+export function gpuOwnerTestRoot(label: string): string {
+  const scratch = resolve(import.meta.dir, "../../../../..", "_work/gpu-owner-recovery/scratch");
+  mkdirSync(scratch, { recursive: true, mode: 0o700 });
+  return mkdtempSync(resolve(scratch, `${label}-`));
+}
+export const inputStream = (bytes: string | Uint8Array): ReadableStream<Uint8Array> => new ReadableStream({ start(controller) {
+  controller.enqueue(typeof bytes === "string" ? new TextEncoder().encode(bytes) : bytes); controller.close();
+} });
