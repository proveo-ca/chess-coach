+#[test]
+fn nested_fields_are_closed_and_nullable_fields_are_required() {
+    let f = fixture();
+    for pointer in [
+        "",
+        "/descriptor",
+        "/descriptor/schedule",
+        "/state",
+        "/state/counters",
+        "/state/control",
+        "/state/rng",
+        "/state/rng/selection",
+        "/state/rng/generator",
+        "/state/journalRef",
+        "/state/historyRefs/0",
+        "/state/bindings",
+        "/state/bindings/source",
+    ] {
+        let mut candidate = f.proposal.clone();
+        candidate
+            .pointer_mut(pointer)
+            .unwrap()
+            .as_object_mut()
+            .unwrap()
+            .insert("unexpected".into(), json!(0));
+        assert!(
+            check(&f, &serde_json::to_string(&candidate).unwrap()).is_err(),
+            "{pointer}"
+        );
+    }
+    for (pointer, key) in [
+        ("/state", "journalRef"),
+        ("/state/rng/generator", "root"),
+        ("/state/rng/generator", "state"),
+    ] {
+        let mut candidate = f.proposal.clone();
+        candidate
+            .pointer_mut(pointer)
+            .unwrap()
+            .as_object_mut()
+            .unwrap()
+            .remove(key);
+        assert!(
+            check(&f, &serde_json::to_string(&candidate).unwrap()).is_err(),
+            "{pointer}/{key}"
+        );
+    }
+}
