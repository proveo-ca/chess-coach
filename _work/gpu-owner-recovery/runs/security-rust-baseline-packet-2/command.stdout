@@ -0,0 +1,40 @@
+// SPEC: _spec/gpu-owner.md
+use std::process::Command;
+
+#[test]
+fn bounded_help_is_the_only_enabled_cli_operation() {
+    let result = Command::new(env!("CARGO_BIN_EXE_host-gpu-owner"))
+        .arg("--help")
+        .env_clear()
+        .output()
+        .unwrap();
+    assert!(result.status.success());
+    assert!(result.stdout.len() < 1024);
+    assert!(result.stderr.is_empty());
+}
+
+#[test]
+fn operational_arguments_and_environment_cannot_enable_main() {
+    for args in [
+        vec![],
+        vec!["--manifest", "/must-not-be-opened"],
+        vec!["--help", "extra"],
+        vec![
+            "--input-manifest",
+            "{}",
+            "--expected-manifest-sha256",
+            "bad",
+        ],
+    ] {
+        let result = Command::new(env!("CARGO_BIN_EXE_host-gpu-owner"))
+            .args(args)
+            .env_clear()
+            .env("GPU_OWNER_ENABLED", "1")
+            .env("CHESS_COACH_GPU_OWNER_ENABLED", "1")
+            .output()
+            .unwrap();
+        assert_eq!(result.status.code(), Some(2));
+        assert!(result.stdout.is_empty());
+        assert_eq!(result.stderr, b"SOURCE_ONLY_DISABLED\n");
+    }
+}
diff --git a/crates/gpu-owner/tests/conformance.rs b/crates/gpu-owner/tests/conformance.rs
new file mode 100644
index 000000000..9db8976bf
--- /dev/null
+++ b/crates/gpu-owner/tests/conformance.rs
@@ -0,0 +1,79 @@
+// SPEC: _spec/gpu-cooperative-policy.md
+use chess_coach_gpu_owner::{
+    json::Decimal,
+    policy::{Configuration, Decision, Policy, Sample},
+};
+use serde_json::Value;
+
+fn signed(value: &Value) -> Option<i64> {
+    let text = value.as_str()?;
+    let digits = text.strip_prefix('-').unwrap_or(text);
+    if digits.is_empty()
+        || (digits.len() > 1 && digits.starts_with('0'))
+        || !digits.bytes().all(|b| b.is_ascii_digit())
+        || text == "-0"
+    {
+        return None;
+    }
+    text.parse().ok()
+}
+fn sample(value: &Value) -> Option<Sample> {
+    let fields = value.as_object()?;
+    if fields.len() != 4
+        || !["uuid", "freeBytes", "totalBytes", "observedBoottimeNs"]
+            .iter()
+            .all(|key| fields.contains_key(*key))
+    {
+        return None;
+    }
+    fn range(value: &Value) -> Option<Decimal> {
+        let text = value.as_str()?;
+        let n = text.parse::<i128>().ok()?;
+        if n.to_string() != text {
+            return None;
+        }
+        Some(Decimal(i64::try_from(n).unwrap_or(-1)))
+    }
+    Some(Sample {
+        uuid: value["uuid"].as_str()?.into(),
+        free_bytes: range(&value["freeBytes"])?,
+        total_bytes: range(&value["totalBytes"])?,
+        observed_boottime_ns: range(&value["observedBoottimeNs"])?,
+    })
+}
+
+#[test]
+fn shared_reconstructed_policy_range_and_clock_traces() {
+    let document: Value = serde_json::from_str(include_str!(
+        "../../../tooling/runtime/fixtures/gpu-policy-traces.json"
+    ))
+    .unwrap();
+    assert_eq!(document["version"], "chess-coach.gpu-policy-conformance.v1");
+    let cases = document["cases"].as_array().unwrap();
+    assert_eq!(cases.len(), 33);
+    let mut groups = std::collections::BTreeSet::new();
+    let mut names = std::collections::BTreeSet::new();
+    for case in cases {
+        let name = case["name"].as_str().unwrap();
+        assert!(names.insert(name));
+        groups.insert(case["group"].as_str().unwrap());
+        let configuration =
+            serde_json::from_value::<Configuration>(case["configuration"].clone()).ok();
+        let mut policy = Policy::new(configuration, signed(&case["originalS0Ns"]));
+        for (index, call) in case["calls"].as_array().unwrap().iter().enumerate() {
+            let now = signed(&call["nowNs"]);
+            let actual = match call["method"].as_str().unwrap() {
+                "admit" => policy.admit(now, sample(&call["sample"])),
+                "observe" => policy.observe(now, sample(&call["sample"])),
+                "check" => policy.check(now),
+                method => panic!("unknown method {method}"),
+            };
+            let expected: Decision = serde_json::from_value(call["expected"].clone()).unwrap();
+            assert_eq!(actual, expected, "{name} call {index}");
+        }
+    }
+    assert_eq!(
+        groups.into_iter().collect::<Vec<_>>(),
+        vec!["clock", "policy", "range"]
+    );
+}
diff --git a/crates/gpu-owner/tests/contracts.rs b/crates/gpu-owner/tests/contracts.rs
new file mode 100644
index 000000000..8f77904a1
--- /dev/null
+++ b/crates/gpu-owner/tests/contracts.rs
@@ -0,0 +1,267 @@
+// SPEC: _spec/gpu-owner.md
+use chess_coach_gpu_owner::{
+    OwnerError, RawLaunchRequest, Result,
+    input::{ByteRef, OwnerInput},
+    json::{self, Decimal},
+    linux::{Clock, Waiter, Watch},
+    run_once_with,
+};
+use rustix::event::PollFlags;
+use serde_json::{Value, json};
+use std::cell::Cell;
+
+fn manifest() -> Value {
+    let digest = "0".repeat(64);
+    let file = json!({"path":"/fixture/tool","byteLength":0,"sha256":digest});
+    json!({"version":"chess-coach.gpu-owner.v1",
+        "ownership":{"sessionId":"session","attemptId":"attempt","containerName":"owned","ownershipToken":"0".repeat(32)},
+        "outsideControl":{"admissionReceipt":file,"expectedSelfEnvelope":{"cpus":[0,1],"cpuQuota":200000,"memoryMaxBytes":"2000000000",
+            "aggregateParent":"/fixture/cgroup/aggregate","aggregateCpus":[0,1,2,3,4,5],"aggregateCpuQuota":600000,"aggregateMemoryMaxBytes":"24000000000"}},
+        "docker":{"executable":file,"anonymousConfigDirectory":"/fixture/config","endpointUnixSocket":"/fixture/socket","cgroupParentArgument":"job.slice"},
+        "observation":{"procRoot":"/fixture/proc","cgroupRoot":"/fixture/cgroup","approvedJobParentAbsolutePath":"/fixture/cgroup/aggregate/jobs",
+            "expectedOutsideControlCgroupAbsolutePath":"/fixture/cgroup/aggregate/control"},
+        "job":{"imageId":format!("sha256:{digest}"),"runtimeClosure":file,"gpuProfile":{"mode":"legacy-nvidia-device-request.v1","cpus":[2,3,4,5],"injectionInventory":file},
+            "stateHostSource":"/fixture/state","jobInputJson":"{}","jobInputRef":{"byteLength":2,"sha256":json::sha256(b"{}")},"expectedDescriptorSha256":digest,"initialModelId":digest},
+        "cooperative":{"selectedUuid":"GPU-12345678-1234-1234-1234-123456789abc","startupMinFreeBytes":"1000","runningStopBelowFreeBytes":"500","samplePeriodNs":"1000","maxSampleAgeNs":"2000"},
+        "telemetry":{"kind":"registered-nvidia-smi-query.v1","executable":file,"runtimeClosure":file,"expectedDriver":"fixture","queryBudgetNs":"100","refreshIntervalNs":"100","schedulingReserveNs":"100"},
+        "evidence":{"exclusivePacketRoot":"/fixture/evidence"}})
+}
+fn parse(value: &Value) -> Result<OwnerInput> {
+    let bytes = serde_json::to_vec(value).unwrap();
+    OwnerInput::parse(&bytes, &json::sha256(&bytes))
+}
+
+#[test]
+fn exact_manifest_names_and_resource_envelope() {
+    assert!(parse(&manifest()).is_ok());
+    for (pointer, replacement) in [
+        ("/outsideControl/expectedSelfEnvelope/cpus", json!([0, 0])),
+        ("/job/gpuProfile/cpus", json!([0, 2, 3, 4])),
+        (
+            "/outsideControl/expectedSelfEnvelope/aggregateCpuQuota",
+            json!(599999),
+        ),
+        (
+            "/outsideControl/expectedSelfEnvelope/memoryMaxBytes",
+            json!("16000000000"),
+        ),
+        (
+            "/outsideControl/expectedSelfEnvelope/aggregateMemoryMaxBytes",
+            json!("24000000001"),
+        ),
+        ("/telemetry/queryBudgetNs", json!("800")),
+        ("/docker/cgroupParentArgument", json!("/job.slice")),
+        ("/job/jobInputJson", json!(" {}")),
+        ("/ownership/ownershipToken", json!("A".repeat(32))),
+    ] {
+        let mut candidate = manifest();
+        *candidate.pointer_mut(pointer).unwrap() = replacement;
+        assert!(parse(&candidate).is_err(), "{pointer}");
+    }
+}
+
+#[test]
+fn rejects_missing_unknown_and_memory_aliases() {
+    for pointer in [
+        "/ownership",
+        "/outsideControl/expectedSelfEnvelope",
+        "/docker",
+        "/observation",
+        "/job/gpuProfile",
+        "/cooperative",
+        "/telemetry",
+        "/evidence",
+    ] {
+        let mut value = manifest();
+        value
+            .pointer_mut(pointer)
+            .unwrap()
+            .as_object_mut()
+            .unwrap()
+            .insert("extra".into(), json!(null));
+        assert!(parse(&value).is_err(), "{pointer}");
+    }
+    for (pointer, key) in [
+        ("/outsideControl/expectedSelfEnvelope", "memoryMaxBytes"),
+        (
+            "/outsideControl/expectedSelfEnvelope",
+            "aggregateMemoryMaxBytes",
+        ),
+        ("/telemetry", "queryBudgetNs"),
+        ("/telemetry", "refreshIntervalNs"),
+        ("/telemetry", "schedulingReserveNs"),
+    ] {
+        let mut value = manifest();
+        let map = value.pointer_mut(pointer).unwrap().as_object_mut().unwrap();
+        let old = map.remove(key).unwrap();
+        map.insert(format!("{key}Decimal"), old);
+        assert!(parse(&value).is_err());
+        let mut value = manifest();
+        value
+            .pointer_mut(pointer)
+            .unwrap()
+            .as_object_mut()
+            .unwrap()
+            .remove(key);
+        assert!(parse(&value).is_err());
+    }
+}
+
+#[test]
+fn independent_hash_commits_original_bytes() {
+    let bytes = serde_json::to_vec(&manifest()).unwrap();
+    let expected = json::sha256(&bytes);
+    assert!(OwnerInput::parse(&bytes, &expected).is_ok());
+    let changed = [b" ".as_slice(), bytes.as_slice()].concat();
+    assert_eq!(
+        OwnerInput::parse(&changed, &expected).unwrap_err(),
+        OwnerError("MANIFEST_SHA256")
+    );
+    assert_eq!(
+        OwnerInput::parse(&vec![b' '; 262_145], "bad").unwrap_err(),
+        OwnerError("MANIFEST_BOUND")
+    );
+}
+
+#[test]
+fn evidence_packet_must_remain_outside_job_writable_state() {
+    for path in [
+        "/fixture/state",
+        "/fixture/state/owner-packet",
+        "/fixture/state/nested/owner-packet",
+    ] {
+        let mut value = manifest();
+        value["evidence"]["exclusivePacketRoot"] = json!(path);
+        assert_eq!(
+            parse(&value).unwrap_err(),
+            OwnerError("EVIDENCE_STATE_OVERLAP")
+        );
+    }
+    for path in ["/fixture/state-other/owner-packet", "/fixture/evidence"] {
+        let mut value = manifest();
+        value["evidence"]["exclusivePacketRoot"] = json!(path);
+        assert!(parse(&value).is_ok());
+    }
+}
+
+#[test]
+fn literal_negative_zero_counts_preserve_bounds_and_manifest_byte_commitment() {
+    let original = serde_json::to_string(&manifest()).unwrap();
+    let text = original
+        .replace("\"byteLength\":0", "\"byteLength\":-0")
+        .replace("\"cpus\":[0,1]", "\"cpus\":[-0,1]")
+        .replace(
+            "\"aggregateCpus\":[0,1,2,3,4,5]",
+            "\"aggregateCpus\":[-0,1,2,3,4,5]",
+        );
+    assert_ne!(text, original);
+    assert!(OwnerInput::parse(text.as_bytes(), &json::sha256(original.as_bytes())).is_err());
+    let input = OwnerInput::parse(text.as_bytes(), &json::sha256(text.as_bytes())).unwrap();
+    assert_eq!(input.outside_control.expected_self_envelope.cpus[0], 0);
+    assert_eq!(input.docker.executable.byte_length, 0);
+    for token in ["-0.0", "-0e0", "0.0", "0e0", "\"0\"", "true"] {
+        let invalid = text.replace("\"byteLength\":-0", &format!("\"byteLength\":{token}"));
+        assert!(
+            OwnerInput::parse(invalid.as_bytes(), &json::sha256(invalid.as_bytes())).is_err(),
+            "{token}"
+        );
+    }
+}
+
+#[test]
+fn decimal_strings_and_json_integer_counts_are_not_coerced() {
+    for value in ["0", "1", "9223372036854775807"] {
+        let parsed: Decimal = serde_json::from_str(&format!("\"{value}\"")).unwrap();
+        assert_eq!(
+            serde_json::to_string(&parsed).unwrap(),
+            format!("\"{value}\"")
+        );
+    }
+    for value in [
+        "00",
+        "01",
+        "+1",
+        "-1",
+        "1.0",
+        "1e3",
+        "9223372036854775808",
+        "",
+    ] {
+        assert!(serde_json::from_str::<Decimal>(&format!("\"{value}\"")).is_err());
+    }
+    assert!(serde_json::from_str::<Decimal>("1").is_err());
+    for token in ["1.0", "1e0", "-1", "9007199254740992", "\"1\""] {
+        let bytes = format!(
+            "{{\"byteLength\":{token},\"sha256\":\"{}\"}}",
+            "0".repeat(64)
+        );
+        assert!(
+            json::decode::<ByteRef>(bytes.as_bytes(), 4096).is_err(),
+            "{token}"
+        );
+    }
+}
+
+#[test]
+fn recursive_json_uniqueness_and_bounds() {
+    for bytes in [
+        r#"{"a":1,"\u0061":2}"#,
+        r#"{"a":{"x":1,"\u0078":2}}"#,
+        r#"[{"a":1,"a":2}]"#,
+        r#"{"a":9007199254740992}"#,
+        r#"{"a":1e999}"#,
+        r#"{"a":1,}"#,
+        "{} trailing",
+        r#""\ud800""#,
+    ] {
+        assert!(
+            json::validate(bytes.as_bytes(), 1_048_576).is_err(),
+            "{bytes}"
+        );
+    }
+    let deep = format!("{}0{}", "[".repeat(34), "]".repeat(34));
+    assert!(json::validate(deep.as_bytes(), 1_048_576).is_err());
+    let many = serde_json::to_vec(&vec![0; 16385]).unwrap();
+    assert!(json::validate(&many, 1_048_576).is_err());
+    assert!(
+        json::validate(
+            br#"{"x":"brace } \" ","a":[true,false,null,-1.5e-2]}"#,
+            4096
+        )
+        .is_ok()
+    );
+}
+
+struct RecordingClock(Cell<u32>);
+impl Clock for RecordingClock {
+    fn now_ns(&self) -> Result<i64> {
+        let n = self.0.get();
+        self.0.set(n + 1);
+        Ok(42 + i64::from(n))
+    }
+}
+struct NeverWait;
+impl Waiter for NeverWait {
+    fn wait_until(&mut self, _: i64, _: &[Watch<'_>]) -> Result<Vec<PollFlags>> {
+        panic!("invalid raw input must not construct helpers")
+    }
+}
+#[test]
+fn origin_precedes_raw_validation_and_remains_a_decimal_string() {
+    let clock = RecordingClock(Cell::new(0));
+    let report = run_once_with(
+        RawLaunchRequest {
+            input_manifest: "not JSON".into(),
+            expected_manifest_sha256: "bad".into(),
+        },
+        &clock,
+        &mut NeverWait,
+    )
+    .unwrap();
+    assert_eq!(report.origin_ns, 42);
+    assert!(!report.success);
+    assert!(!report.training_ready);
+    assert_eq!(report.first_failure.as_deref(), Some("MANIFEST_SHA256"));
+    assert!(clock.0.get() >= 2);
+    assert_eq!(serde_json::to_value(report).unwrap()["origin_ns"], "42");
+}
diff --git a/crates/gpu-owner/tests/lifecycle.rs b/crates/gpu-owner/tests/lifecycle.rs
new file mode 100644
index 000000000..5e91b0e0d
--- /dev/null
+++ b/crates/gpu-owner/tests/lifecycle.rs
@@ -0,0 +1,419 @@
+// SPEC: _spec/gpu-owner.md, _spec/gpu-owner.puml
+#![forbid(unsafe_code)]
+
+mod support;
+
+use chess_coach_gpu_owner::{
+    Report,
+    linux::{Boottime, Clock, LinuxWaiter},
+    run_once, run_once_with,
+};
+use serde_json::json;
+use std::{
+    cell::Cell,
+    fs,
+    path::{Path, PathBuf},
+};
+use support::{Fixture, GuardedWaiter, OffsetClock, assert_pid_gone, read_json, sha256};
+
+fn run(fixture: &Fixture) -> Report {
+    let report = run_once(fixture.request()).unwrap();
+    fixture.record_report(&report);
+    fixture.assert_no_fixture_error();
+    fixture.assert_helper_pids_gone();
+    assert!(!report.training_ready);
+    report
+}
+
+fn assert_removed(fixture: &Fixture, report: &Report) {
+    assert!(report.cgroup_gone, "{report:?}");
+    assert_owned_remove(fixture, report);
+}
+
+fn assert_owned_remove(fixture: &Fixture, report: &Report) {
+    assert!(report.all_helpers_reaped, "{report:?}");
+    assert!(fixture.path("removed").is_file());
+    assert!(!fixture.path("leaf").exists());
+    let events = fixture.events();
+    let remove = events.iter().position(|e| e["event"] == "remove").unwrap();
+    let inspect = events[..remove]
+        .iter()
+        .rposition(|e| e["event"] == "inspect")
+        .unwrap();
+    assert_eq!(events[inspect]["value"]["image"], fixture.config["imageId"]);
+    assert_eq!(events[inspect]["value"]["token"], fixture.config["token"]);
+    assert_eq!(events.iter().filter(|e| e["event"] == "create").count(), 1);
+    assert_eq!(events.iter().filter(|e| e["event"] == "remove").count(), 1);
+    if fixture.path("attachPid").exists() {
+        let pid = fs::read_to_string(fixture.path("attachPid"))
+            .unwrap()
+            .parse()
+            .unwrap();
+        assert_pid_gone(pid);
+    }
+}
+
+fn assert_rejected_before_create(mode: &str) {
+    let fixture = Fixture::new(mode);
+    let report = run(&fixture);
+    assert!(!report.success, "{report:?}");
+    assert!(report.first_failure.is_some());
+    assert!(report.all_helpers_reaped, "{report:?}");
+    assert!(!fixture.path("created").exists());
+    assert!(!fixture.path("removed").exists());
+    assert!(!fixture.path("attachPid").exists());
+    fixture.assert_no_work();
+    let telemetry = fs::read_to_string(fixture.path("telemetryEvents")).unwrap();
+    assert!(!telemetry.is_empty());
+    for line in telemetry.lines() {
+        let event: serde_json::Value = serde_json::from_str(line).unwrap();
+        assert_pid_gone(event["pid"].as_u64().unwrap() as u32);
+    }
+}
+
+#[test]
+fn real_bun_attempt_commits_once_and_naturally_reaps_every_child() {
+    let fixture = Fixture::new("normal");
+    let report = run(&fixture);
+    assert!(report.success, "{report:?}");
+    assert!(report.first_failure.is_none());
+    assert!(report.cleanup_errors.is_empty(), "{report:?}");
+    assert_removed(&fixture, &report);
+    fixture.assert_completed();
+    let frames = fixture.frames();
+    assert_eq!(
+        frames
+            .iter()
+            .map(|frame| frame["kind"].as_str().unwrap())
+            .collect::<Vec<_>>(),
+        ["boot", "startup", "attempt-proposal"]
+    );
+    assert_eq!(
+        frames[1]["initialModelId"],
+        fixture.registration["initialModelId"]
+    );
+    let exact_proposal = frames[2]["proposalJson"].as_str().unwrap();
+    assert_eq!(report.proposal_json.as_deref(), Some(exact_proposal));
+    assert_eq!(
+        frames[2]["proposalSha256"],
+        sha256(exact_proposal.as_bytes())
+    );
+    let proposal: serde_json::Value = serde_json::from_str(exact_proposal).unwrap();
+    assert_eq!(proposal["descriptor"], fixture.registration["descriptor"]);
+    assert_eq!(
+        proposal["state"]["modelId"],
+        fixture.registration["initialModelId"]
+    );
+    assert_eq!(proposal["state"]["master"], 101);
+    assert_eq!(
+        proposal["state"]["counters"],
+        json!({"started": 1, "verifiedCompleted": 1, "eligibleCompleted": 0,
+        "updates": 0, "nonzeroPGUpdates": 0, "baselineCount": 0, "baselineSum": 0})
+    );
+    assert_eq!(
+        read_json(&fixture.root.join("report.json"))["origin_ns"],
+        report.origin_ns.to_string()
+    );
+}
+
+#[test]
+fn wrong_image_or_ownership_token_never_authorizes_remove_or_start_release() {
+    for mode in ["wrong-image", "wrong-label"] {
+        let fixture = Fixture::new(mode);
+        let report = run(&fixture);
+        assert!(!report.success, "{mode}: {report:?}");
+        assert!(report.first_failure.is_some());
+        assert!(report.all_helpers_reaped, "{mode}: {report:?}");
+        assert!(!fixture.path("removed").exists());
+        assert!(fixture.path("created").is_file());
+        assert!(
+            fixture
+                .events()
+                .iter()
+                .any(|event| event["event"] == "inspect"
+                    && (event["value"]["image"] != fixture.config["imageId"]
+                        || event["value"]["token"] != fixture.config["token"]))
+        );
+        assert!(!fixture.events().iter().any(|e| e["event"] == "remove"));
+        fixture.assert_no_work();
+    }
+}
+
+#[test]
+fn extra_gpu_request_fails_c2_but_keeps_owned_cleanup_authority() {
+    let fixture = Fixture::new("extra-gpu");
+    let report = run(&fixture);
+    assert!(!report.success, "{report:?}");
+    assert!(report.first_failure.is_some());
+    assert_owned_remove(&fixture, &report);
+    fixture.assert_no_work();
+}
+
+#[test]
+fn extra_bind_mount_fails_c13_but_keeps_owned_cleanup_authority() {
+    let fixture = Fixture::new("extra-mount");
+    let report = run(&fixture);
+    assert!(!report.success, "{report:?}");
+    assert!(report.first_failure.is_some());
+    assert_owned_remove(&fixture, &report);
+    fixture.assert_no_work();
+}
+
+#[test]
+fn malformed_registered_query_never_creates_or_releases_work() {
+    assert_rejected_before_create("malformed-query");
+}
+
+#[test]
+fn low_registered_query_never_creates_or_releases_work() {
+    assert_rejected_before_create("low-query");
+}
+
+#[test]
+fn stalled_registered_query_expires_and_reaps_without_create() {
+    assert_rejected_before_create("stalled-query");
+}
+
+#[test]
+fn trailing_stdout_after_real_sqlite_commit_never_becomes_success() {
+    let fixture = Fixture::new("trailing-stdout");
+    let report = run(&fixture);
+    assert!(!report.success, "{report:?}");
+    assert!(report.first_failure.is_some());
+    assert_removed(&fixture, &report);
+    fixture.assert_completed();
+    assert_eq!(fixture.frames().len(), 3);
+    assert!(
+        Path::new(
+            fixture.registration["layout"]["stateRoot"]
+                .as_str()
+                .unwrap()
+        )
+        .join("private.sqlite")
+        .is_file()
+    );
+}
+
+#[test]
+fn nonzero_attach_after_real_sqlite_commit_never_becomes_success() {
+    let fixture = Fixture::new("nonzero-after-proposal");
+    let report = run(&fixture);
+    assert!(!report.success, "{report:?}");
+    assert!(report.first_failure.is_some());
+    assert_removed(&fixture, &report);
+    fixture.assert_completed();
+    assert_eq!(fixture.frames().len(), 3);
+}
+
+#[test]
+fn empty_retained_cgroup_is_not_disappearance_before_original_final_deadline() {
+    let fixture = Fixture::new("retained-cgroup");
+    let clock = OffsetClock::new();
+    let mut waiter = GuardedWaiter::new(&clock, &fixture, false);
+    let report = run_once_with(fixture.request(), &clock, &mut waiter).unwrap();
+    fixture.record_report(&report);
+    fixture.assert_no_fixture_error();
+    fixture.assert_helper_pids_gone();
+    assert!(!report.success, "{report:?}");
+    assert!(!report.training_ready);
+    assert!(!report.cgroup_gone);
+    assert!(report.all_helpers_reaped, "{report:?}");
+    assert!(waiter.advanced_cleanup);
+    assert!(clock.now_ns().unwrap() >= report.origin_ns + 300_000_000_000);
+    assert!(fixture.path("leaf").is_dir());
+    assert_eq!(
+        fs::read(fixture.path("leaf").join("cgroup.procs")).unwrap(),
+        b""
+    );
+    assert!(fixture.path("removed").is_file());
+    fixture.assert_completed();
+}
+
+#[test]
+fn evidence_path_failure_still_rechecks_ownership_binds_and_removes() {
+    for mode in [
+        "storage-failure",
+        "storage-wrong-image",
+        "storage-wrong-label",
+    ] {
+        let fixture = Fixture::new(mode);
+        let report = run(&fixture);
+        assert!(!report.success, "{mode}: {report:?}");
+        let first = report.first_failure.as_deref().unwrap();
+        assert!(
+            first.contains("EVIDENCE") || first.contains("IO"),
+            "{mode}: first failure {first}"
+        );
+        assert!(report.all_helpers_reaped, "{mode}: {report:?}");
+        assert!(fixture.path("packetRoot").is_file());
+        assert!(fixture.path("preservedPacket").is_dir());
+        assert!(
+            fs::read_dir(fixture.path("preservedPacket"))
+                .unwrap()
+                .next()
+                .is_some()
+        );
+        let events = fixture.events();
+        assert!(
+            events.iter().filter(|e| e["event"] == "inspect").count() >= 2,
+            "{mode}: {events:?}"
+        );
+        if mode == "storage-failure" {
+            assert_removed(&fixture, &report);
+        } else {
+            assert!(
+                !fixture.path("removed").exists(),
+                "{mode}: removed unowned container"
+            );
+            assert!(!events.iter().any(|e| e["event"] == "remove"));
+        }
+        fixture.assert_no_work();
+    }
+}
+
+#[test]
+fn startup_before_complete_start_write_and_stdin_eof_is_rejected() {
+    let fixture = Fixture::new("premature-startup");
+    assert_eq!(
+        fixture.manifest["job"]["jobInputJson"]
+            .as_str()
+            .unwrap()
+            .len(),
+        65_536
+    );
+    let clock = OffsetClock::new();
+    let mut waiter = GuardedWaiter::new(&clock, &fixture, true);
+    let report = run_once_with(fixture.request(), &clock, &mut waiter).unwrap();
+    fixture.record_report(&report);
+    fixture.assert_no_fixture_error();
+    fixture.assert_helper_pids_gone();
+    assert!(fixture.path("prematureSent").exists());
+    assert!(
+        !waiter.advanced_startup_guard,
+        "owner accepted premature startup and entered ordinary work"
+    );
+    assert!(!report.success, "{report:?}");
+    assert!(!report.training_ready);
+    assert_eq!(report.first_failure.as_deref(), Some("WIRE_STARTUP"));
+    assert_removed(&fixture, &report);
+    fixture.assert_no_work();
+}
+
+struct ColdAfterQueueClock {
+    origin: Cell<Option<i64>>,
+    checks_after_start: Cell<usize>,
+    start_path: PathBuf,
+}
+impl Clock for ColdAfterQueueClock {
+    fn now_ns(&self) -> chess_coach_gpu_owner::Result<i64> {
+        let now = Boottime.now_ns()?;
+        let origin = match self.origin.get() {
+            Some(origin) => origin,
+            None => {
+                self.origin.set(Some(now));
+                now
+            }
+        };
+        if self.start_path.exists() {
+            let checks = self.checks_after_start.get().saturating_add(1);
+            self.checks_after_start.set(checks);
+            if checks >= 2 {
+                return Ok(origin + 10_000_000_000);
+            }
+        }
+        Ok(now)
+    }
+}
+
+#[test]
+fn cold_expiry_after_queueing_does_not_release_job_work_during_cleanup() {
+    for mode in ["cold-after-queue", "cleanup-attach-overflow"] {
+        let fixture = Fixture::new(mode);
+        let clock = ColdAfterQueueClock {
+            origin: Cell::new(None),
+            checks_after_start: Cell::new(0),
+            start_path: fixture.path("packetRoot").join("job-start.json"),
+        };
+        let report = run_once_with(fixture.request(), &clock, &mut LinuxWaiter).unwrap();
+        fixture.record_report(&report);
+        fixture.assert_no_fixture_error();
+        fixture.assert_helper_pids_gone();
+        assert!(clock.checks_after_start.get() >= 2);
+        assert!(clock.start_path.is_file());
+        assert_eq!(
+            report.first_failure.as_deref(),
+            Some("DEADLINE"),
+            "{mode}: {report:?}"
+        );
+        assert!(!report.success);
+        assert_removed(&fixture, &report);
+        fixture.assert_no_work();
+        if mode == "cleanup-attach-overflow" {
+            assert!(
+                report
+                    .cleanup_errors
+                    .iter()
+                    .any(|error| error == "OUTPUT_BOUND"),
+                "{report:?}"
+            );
+        } else {
+            assert_eq!(
+                fixture
+                    .frames()
+                    .iter()
+                    .map(|frame| frame["kind"].as_str().unwrap())
+                    .collect::<Vec<_>>(),
+                ["boot"]
+            );
+        }
+    }
+}
+
+#[test]
+fn owner_rejects_evidence_inside_state_before_any_query_or_manager() {
+    let mut fixture = Fixture::new("normal");
+    let evidence = fixture.path("stateSource").join("owner-packet");
+    fixture.manifest["evidence"]["exclusivePacketRoot"] = json!(evidence);
+    let report = run(&fixture);
+    assert_eq!(
+        report.first_failure.as_deref(),
+        Some("EVIDENCE_STATE_OVERLAP")
+    );
+    assert!(!report.success);
+    assert!(!evidence.exists());
+    assert!(!fixture.path("telemetryEvents").exists());
+    assert!(fixture.events().is_empty());
+    fixture.assert_no_work();
+}
+
+#[test]
+fn state_path_substitution_stops_work_but_preserves_owned_cleanup() {
+    for mode in [
+        "state-replaced-before-create",
+        "state-replaced-after-create",
+        "state-replaced-running",
+    ] {
+        let fixture = Fixture::new(mode);
+        let report = run(&fixture);
+        assert_eq!(
+            report.first_failure.as_deref(),
+            Some("STATE_PATH_REPLACED"),
+            "{mode}: {report:?}"
+        );
+        assert!(!report.success);
+        assert!(report.all_helpers_reaped);
+        assert!(fixture.path("stateReplaced").exists());
+        assert!(fixture.path("preservedState").is_dir());
+        fixture.assert_no_work();
+        if mode == "state-replaced-before-create" {
+            assert!(!fixture.path("created").exists());
+            assert!(!fixture.path("removed").exists());
+            assert!(fixture.events().is_empty());
+        } else {
+            assert_owned_remove(&fixture, &report);
+            if mode == "state-replaced-running" {
+                assert!(report.cgroup_gone, "{report:?}");
+            }
+        }
+    }
+}
diff --git a/crates/gpu-owner/tests/observation.rs b/crates/gpu-owner/tests/observation.rs
new file mode 100644
index 000000000..ddef3e3d0
--- /dev/null
+++ b/crates/gpu-owner/tests/observation.rs
@@ -0,0 +1,382 @@
+// SPEC: _spec/gpu-owner.md, _spec/gpu-owner.puml
+#![forbid(unsafe_code)]
+
+#[allow(dead_code)]
+mod support;
+
+use chess_coach_gpu_owner::{OwnerError, input::OwnerInput, observe::Observer};
+use std::{
+    collections::BTreeMap,
+    fs,
+    os::unix::fs::{MetadataExt, symlink},
+    path::{Path, PathBuf},
+};
+use support::Fixture;
+
+const PID: u32 = u32::MAX - 1;
+const CONTROLS: [&str; 7] = [
+    "cpu.max",
+    "memory.max",
+    "memory.swap.max",
+    "pids.max",
+    "cpuset.cpus.effective",
+    "cgroup.procs",
+    "cgroup.threads",
+];
+
+fn fixture() -> (Fixture, OwnerInput, Observer) {
+    let fixture = Fixture::new("normal");
+    let input: OwnerInput = serde_json::from_value(fixture.manifest.clone()).unwrap();
+    let observer = Observer::new(&input).unwrap();
+    (fixture, input, observer)
+}
+
+fn cgroup(path: &Path, procs: &str) {
+    fs::create_dir(path).unwrap();
+    for (name, value) in [
+        ("cpu.max", "400000 100000\n"),
+        ("memory.max", "8589934592\n"),
+        ("memory.swap.max", "0\n"),
+        ("pids.max", "512\n"),
+        ("cpuset.cpus.effective", "1,2,3,4\n"),
+        ("cgroup.procs", procs),
+        ("cgroup.threads", procs),
+    ] {
+        fs::write(path.join(name), value).unwrap();
+    }
+}
+
+fn leaf(input: &OwnerInput, relative: &str) -> PathBuf {
+    let mut path = PathBuf::from(&input.observation.approved_job_parent_absolute_path);
+    let parts: Vec<_> = relative.split('/').collect();
+    for (index, part) in parts.iter().enumerate() {
+        path.push(part);
+        let procs = if index + 1 == parts.len() {
+            format!("{PID}\n")
+        } else {
+            String::new()
+        };
+        cgroup(&path, &procs);
+    }
+    let proc = Path::new(&input.observation.proc_root).join(PID.to_string());
+    fs::create_dir_all(&proc).unwrap();
+    let hierarchy = path
+        .to_str()
+        .unwrap()
+        .strip_prefix(&input.observation.cgroup_root)
+        .unwrap();
+    fs::write(proc.join("cgroup"), format!("0::{hierarchy}\n")).unwrap();
+    path
+}
+
+fn remove_cgroup(path: &Path) {
+    for control in CONTROLS {
+        fs::remove_file(path.join(control)).unwrap();
+    }
+    fs::remove_dir(path).unwrap();
+}
+
+fn identity(path: &Path) -> (u64, u64) {
+    let metadata = fs::metadata(path).unwrap();
+    (metadata.dev(), metadata.ino())
+}
+
+fn directory_fds(root: &Path) -> BTreeMap<u32, (u64, u64)> {
+    fs::read_dir("/proc/self/fd")
+        .unwrap()
+        .filter_map(|entry| {
+            let entry = entry.unwrap();
+            let target = fs::read_link(entry.path()).ok()?;
+            let metadata = fs::metadata(entry.path()).ok()?;
+            if target.starts_with(root) && metadata.is_dir() {
+                Some((
+                    entry.file_name().to_str().unwrap().parse().unwrap(),
+                    (metadata.dev(), metadata.ino()),
+                ))
+            } else {
+                None
+            }
+        })
+        .collect()
+}
+
+#[test]
+fn unbound_observer_does_not_claim_disappearance() {
+    let (_fixture, _input, observer) = fixture();
+    assert_eq!(observer.bound_path(), None);
+    assert!(!observer.gone().unwrap());
+}
+
+#[test]
+fn an_empty_retained_nested_leaf_is_not_gone() {
+    let (_fixture, input, mut observer) = fixture();
+    let path = leaf(&input, "a/b/leaf");
+    observer.bind(PID, &input).unwrap();
+    fs::write(path.join("cgroup.procs"), "").unwrap();
+    fs::write(path.join("cgroup.threads"), "").unwrap();
+    observer.stable().unwrap();
+    assert!(!observer.gone().unwrap());
+}
+
+#[test]
+fn renamed_ancestor_with_empty_replacement_faults_while_owned_leaf_survives() {
+    let (fixture, input, mut observer) = fixture();
+    let path = leaf(&input, "a/leaf");
+    observer.bind(PID, &input).unwrap();
+    let ancestor = path.parent().unwrap();
+    let relocated = fixture.root.join("relocated");
+    fs::rename(ancestor, &relocated).unwrap();
+    fs::create_dir(ancestor).unwrap();
+    assert!(relocated.join("leaf").is_dir());
+    assert!(observer.stable().is_err());
+    assert!(observer.gone().is_err());
+}
+
+#[test]
+fn replacement_of_an_inner_ancestor_faults() {
+    let (fixture, input, mut observer) = fixture();
+    let path = leaf(&input, "a/b/leaf");
+    observer.bind(PID, &input).unwrap();
+    let ancestor = path.parent().unwrap();
+    let relocated = fixture.root.join("relocated-b");
+    fs::rename(ancestor, &relocated).unwrap();
+    fs::create_dir(ancestor).unwrap();
+    assert!(relocated.join("leaf").is_dir());
+    assert!(observer.gone().is_err());
+}
+
+#[test]
+fn replacement_of_an_outer_ancestor_faults() {
+    let (fixture, input, mut observer) = fixture();
+    let path = leaf(&input, "a/b/leaf");
+    observer.bind(PID, &input).unwrap();
+    let ancestor = path.parent().unwrap().parent().unwrap();
+    let relocated = fixture.root.join("relocated-a");
+    fs::rename(ancestor, &relocated).unwrap();
+    fs::create_dir(ancestor).unwrap();
+    assert!(relocated.join("b/leaf").is_dir());
+    assert!(observer.gone().is_err());
+}
+
+#[test]
+fn missing_intermediate_ancestor_faults_instead_of_reporting_gone() {
+    let (fixture, input, mut observer) = fixture();
+    let path = leaf(&input, "a/leaf");
+    observer.bind(PID, &input).unwrap();
+    let relocated = fixture.root.join("relocated");
+    fs::rename(path.parent().unwrap(), &relocated).unwrap();
+    assert!(relocated.join("leaf").is_dir());
+    assert!(observer.gone().is_err());
+}
+
+#[test]
+fn honest_nested_leaf_removal_reports_gone_and_keeps_the_leaf_inode_pinned() {
+    let (fixture, input, mut observer) = fixture();
+    let path = leaf(&input, "a/b/leaf");
+    let expected = identity(&path);
+    observer.bind(PID, &input).unwrap();
+    assert!(
+        directory_fds(&fixture.root)
+            .values()
+            .any(|id| *id == expected)
+    );
+    remove_cgroup(&path);
+    observer.stable().unwrap();
+    assert!(observer.gone().unwrap());
+    assert!(
+        directory_fds(&fixture.root)
+            .values()
+            .any(|id| *id == expected)
+    );
+    assert_eq!(observer.bound_path(), path.to_str());
+}
+
+#[test]
+fn honest_direct_child_removal_reports_gone() {
+    let (_fixture, input, mut observer) = fixture();
+    let path = leaf(&input, "leaf");
+    observer.bind(PID, &input).unwrap();
+    assert!(!observer.gone().unwrap());
+    remove_cgroup(&path);
+    observer.stable().unwrap();
+    assert!(observer.gone().unwrap());
+}
+
+fn retained_renamed_leaf_faults(relative: &str) {
+    let (_fixture, input, mut observer) = fixture();
+    let path = leaf(&input, relative);
+    observer.bind(PID, &input).unwrap();
+    let retained = path.with_file_name("retained-leaf");
+    fs::rename(&path, &retained).unwrap();
+    assert!(!path.exists());
+    assert!(retained.is_dir());
+    observer.stable().unwrap();
+    assert_eq!(observer.gone().unwrap_err(), OwnerError("C8_DISAPPEARANCE"));
+}
+
+#[test]
+fn renaming_a_direct_child_leaf_does_not_prove_namespace_removal() {
+    retained_renamed_leaf_faults("leaf");
+}
+
+#[test]
+fn renaming_a_nested_leaf_does_not_prove_namespace_removal() {
+    retained_renamed_leaf_faults("a/b/leaf");
+}
+
+#[test]
+fn intermediate_symlink_substitution_faults() {
+    let (fixture, input, mut observer) = fixture();
+    let path = leaf(&input, "a/leaf");
+    observer.bind(PID, &input).unwrap();
+    let ancestor = path.parent().unwrap();
+    let relocated = fixture.root.join("relocated");
+    fs::rename(ancestor, &relocated).unwrap();
+    symlink(&relocated, ancestor).unwrap();
+    assert!(relocated.join("leaf").is_dir());
+    assert!(observer.stable().is_err());
+    assert!(observer.gone().is_err());
+}
+
+#[test]
+fn root_and_approved_parent_replacements_never_report_gone() {
+    for relative in [
+        "proc",
+        "cgroup",
+        "cgroup/aggregate",
+        "cgroup/aggregate/jobs",
+    ] {
+        let (fixture, input, mut observer) = fixture();
+        let path = leaf(&input, "a/leaf");
+        observer.bind(PID, &input).unwrap();
+        let target = fixture.root.join(relative);
+        let relocated = fixture.root.join("relocated");
+        fs::rename(&target, &relocated).unwrap();
+        fs::create_dir(&target).unwrap();
+        let retained = match path.strip_prefix(&target) {
+            Ok(relative) => relocated.join(relative),
+            Err(_) => path,
+        };
+        assert!(retained.is_dir());
+        assert!(observer.stable().is_err());
+        assert!(observer.gone().is_err());
+    }
+}
+
+#[test]
+fn repeated_binding_retains_the_same_custody_without_accumulating_fds() {
+    let (fixture, input, mut observer) = fixture();
+    let path = leaf(&input, "a/b/leaf");
+    let before = directory_fds(&fixture.root);
+    observer.bind(PID, &input).unwrap();
+    let bound = directory_fds(&fixture.root);
+    assert_eq!(bound.len(), before.len() + 3);
+    for expected in [
+        identity(&path),
+        identity(path.parent().unwrap()),
+        identity(path.parent().unwrap().parent().unwrap()),
+    ] {
+        assert_eq!(bound.values().filter(|id| **id == expected).count(), 1);
+    }
+    for _ in 0..32 {
+        observer.bind(PID, &input).unwrap();
+        assert_eq!(directory_fds(&fixture.root), bound);
+    }
+    assert_eq!(observer.bound_path(), path.to_str());
+    assert!(!observer.gone().unwrap());
+}
+
+#[test]
+fn replacing_the_leaf_rejects_rebinding_and_preserves_established_custody() {
+    let (fixture, input, mut observer) = fixture();
+    let path = leaf(&input, "a/leaf");
+    observer.bind(PID, &input).unwrap();
+    let before = directory_fds(&fixture.root);
+    let relocated = fixture.root.join("retained-leaf");
+    fs::rename(&path, &relocated).unwrap();
+    cgroup(&path, &format!("{PID}\n"));
+    assert_eq!(
+        observer.bind(PID, &input).unwrap_err(),
+        OwnerError("C8_REBOUND")
+    );
+    assert_eq!(directory_fds(&fixture.root), before);
+    assert_eq!(observer.bound_path(), path.to_str());
+    assert!(relocated.is_dir());
+    assert_eq!(observer.gone().unwrap_err(), OwnerError("C8_REPLACED"));
+}
+
+#[test]
+fn changing_the_bound_path_rejects_rebinding() {
+    let (fixture, input, mut observer) = fixture();
+    let original = leaf(&input, "a/leaf");
+    observer.bind(PID, &input).unwrap();
+    let before = directory_fds(&fixture.root);
+    let replacement = leaf(&input, "b/leaf");
+    assert_eq!(
+        observer.bind(PID, &input).unwrap_err(),
+        OwnerError("C8_REBOUND")
+    );
+    assert_eq!(directory_fds(&fixture.root), before);
+    assert_eq!(observer.bound_path(), original.to_str());
+    assert!(replacement.is_dir());
+    assert!(!observer.gone().unwrap());
+}
+
+#[test]
+fn failed_validation_does_not_establish_custody_or_leak_fds() {
+    let (fixture, input, mut observer) = fixture();
+    let path = leaf(&input, "a/b/leaf");
+    fs::write(path.join("pids.max"), "513\n").unwrap();
+    let before = directory_fds(&fixture.root);
+    assert_eq!(observer.bind(PID, &input).unwrap_err(), OwnerError("C8_C2"));
+    assert_eq!(observer.bound_path(), None);
+    assert_eq!(directory_fds(&fixture.root), before);
+    assert!(!observer.gone().unwrap());
+    fs::write(path.join("pids.max"), "512\n").unwrap();
+    observer.bind(PID, &input).unwrap();
+    assert_eq!(observer.bound_path(), path.to_str());
+}
+
+#[test]
+fn failed_revalidation_does_not_replace_established_custody() {
+    let (fixture, input, mut observer) = fixture();
+    let path = leaf(&input, "a/b/leaf");
+    observer.bind(PID, &input).unwrap();
+    let before = directory_fds(&fixture.root);
+    fs::write(path.join("pids.max"), "513\n").unwrap();
+    assert_eq!(observer.bind(PID, &input).unwrap_err(), OwnerError("C8_C2"));
+    assert_eq!(directory_fds(&fixture.root), before);
+    assert_eq!(observer.bound_path(), path.to_str());
+    fs::write(path.join("pids.max"), "512\n").unwrap();
+    observer.bind(PID, &input).unwrap();
+    assert_eq!(directory_fds(&fixture.root), before);
+}
+
+#[test]
+fn replacing_an_ancestor_cannot_rebind_even_when_the_leaf_identity_matches() {
+    let (fixture, input, mut observer) = fixture();
+    let path = leaf(&input, "a/leaf");
+    let expected = identity(&path);
+    observer.bind(PID, &input).unwrap();
+    let ancestor = path.parent().unwrap();
+    let relocated = fixture.root.join("relocated");
+    fs::rename(ancestor, &relocated).unwrap();
+    cgroup(ancestor, "");
+    fs::rename(relocated.join("leaf"), &path).unwrap();
+    assert_eq!(identity(&path), expected);
+    assert!(observer.bind(PID, &input).is_err());
+    assert_eq!(observer.bound_path(), path.to_str());
+    assert!(observer.gone().is_err());
+}
+
+#[test]
+fn leaf_symlink_substitution_faults_instead_of_reporting_gone() {
+    let (fixture, input, mut observer) = fixture();
+    let path = leaf(&input, "a/leaf");
+    observer.bind(PID, &input).unwrap();
+    let relocated = fixture.root.join("retained-leaf");
+    fs::rename(&path, &relocated).unwrap();
+    symlink(&relocated, &path).unwrap();
+    assert!(relocated.is_dir());
+    assert!(observer.gone().is_err());
+}
diff --git a/crates/gpu-owner/tests/support/assert-completed.ts b/crates/gpu-owner/tests/support/assert-completed.ts
new file mode 100644
index 000000000..5aac85fff
--- /dev/null
+++ b/crates/gpu-owner/tests/support/assert-completed.ts
@@ -0,0 +1,18 @@
+// SPEC: _spec/gpu-owner.md, _spec/gpu-owner.puml
+import { Database } from "bun:sqlite";
+import { readFileSync, readdirSync } from "node:fs";
+import { join } from "node:path";
+
+const [registrationPath] = Bun.argv.slice(2);
+const registered = JSON.parse(readFileSync(registrationPath!, "utf8"));
+const db = new Database(join(registered.layout.stateRoot, "private.sqlite"), { readonly: true });
+let result;
+try {
+  result = { attempts: db.query("SELECT id,ordinal,status FROM attempts").all(), masters: db.query("SELECT master,pending,status FROM masters").all(),
+    control: db.query("SELECT aborted FROM control").get() };
+} finally { db.close(); }
+const attempt = join(registered.layout.stateRoot, "packet-00", `attempt-${registered.attemptId}`);
+const journalName = readdirSync(attempt).find(name => name.endsWith("verified-journal.bin"));
+const events = readFileSync(join(attempt, journalName!), "utf8").trimEnd().split("\n").map(line => JSON.parse(line).event);
+console.log(JSON.stringify({ ...result, matchExit: events.find(event => event.kind === "match-exit")?.value,
+  learnersClosed: events.find(event => event.kind === "learners-closed")?.value }));
diff --git a/crates/gpu-owner/tests/support/fake-docker.ts b/crates/gpu-owner/tests/support/fake-docker.ts
new file mode 100644
index 000000000..da5f4c309
--- /dev/null
+++ b/crates/gpu-owner/tests/support/fake-docker.ts
@@ -0,0 +1,167 @@
+#!/usr/local/bin/bun --no-env-file
+// SPEC: _spec/gpu-owner.md, _spec/gpu-owner.puml
+import { appendFileSync, existsSync, mkdirSync, readFileSync, readdirSync, renameSync, rmdirSync, unlinkSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+
+const cfg = __TRUSTED_FIXTURE_CONFIGURATION__;
+const log = (event: string, value: unknown = null) => appendFileSync(cfg.events, JSON.stringify({ event, value, pid: process.pid }) + "\n", { mode: 0o600 });
+const put = (path: string, value: string) => writeFileSync(path, value, { mode: 0o600 });
+const delay = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));
+const requireEqual = (actual: unknown, expected: unknown, label: string) => {
+  if (JSON.stringify(actual) !== JSON.stringify(expected)) throw new Error(`fixture ${label}: ${JSON.stringify(actual)}`);
+};
+const attachPid = () => existsSync(cfg.attachPid) ? Number(readFileSync(cfg.attachPid, "utf8")) : 0;
+const running = () => attachPid() !== 0 && !existsSync(cfg.finished);
+function replaceState() {
+  renameSync(cfg.stateSource, cfg.preservedState);
+  mkdirSync(cfg.stateSource, { mode: 0o700 });
+  put(cfg.stateReplaced, "replaced\n");
+}
+function leaf(pid: number) {
+  mkdirSync(cfg.leaf, { mode: 0o700 });
+  for (const [name, value] of Object.entries({ "cpu.max": "400000 100000\n", "memory.max": "8589934592\n", "memory.swap.max": "0\n",
+    "pids.max": "512\n", "cpuset.cpus.effective": "1,2,3,4\n", "cgroup.procs": `${pid}\n`, "cgroup.threads": `${pid}\n` })) put(join(cfg.leaf, name), value);
+  mkdirSync(join(cfg.procRoot, String(pid)), { mode: 0o700 });
+  put(join(cfg.procRoot, String(pid), "cgroup"), "0::/aggregate/jobs/owned\n");
+}
+function inspect() {
+  const count = existsSync(cfg.inspectCount) ? Number(readFileSync(cfg.inspectCount, "utf8")) + 1 : 1;
+  put(cfg.inspectCount, String(count));
+  const isRunning = running(), pid = isRunning ? attachPid() : 0;
+  if (cfg.mode === "state-replaced-running" && isRunning && !existsSync(cfg.stateReplaced)) replaceState();
+  let image = cfg.imageId, token = cfg.token;
+  const storageFailed = existsSync(cfg.evidenceFault);
+  if (cfg.mode === "wrong-image" || (cfg.mode === "storage-wrong-image" && storageFailed)) image = `sha256:${"b".repeat(64)}`;
+  if (cfg.mode === "wrong-label" || (cfg.mode === "storage-wrong-label" && storageFailed)) token = "f".repeat(32);
+  const request = { Driver: "nvidia", Count: 0, DeviceIDs: [cfg.uuid], Capabilities: [["gpu"]], Options: {} };
+  const host: Record<string, unknown> = { CpuPeriod: 100000, CpuQuota: 400000, CpusetCpus: "1,2,3,4", Memory: 8589934592, MemorySwap: 8589934592,
+    PidsLimit: 512, NetworkMode: "none", IpcMode: "private", CgroupnsMode: "private", Runtime: "nvidia", CgroupParent: "synthetic.slice",
+    Privileged: false, PublishAllPorts: false, AutoRemove: false, ReadonlyRootfs: true, CapDrop: ["ALL"], SecurityOpt: ["no-new-privileges"],
+    RestartPolicy: { Name: "no", MaximumRetryCount: 0 }, LogConfig: { Type: "none", Config: {} }, DeviceRequests: [request],
+    Devices: [], DeviceCgroupRules: [], CapAdd: [], GroupAdd: [], VolumesFrom: [], Links: [], ExtraHosts: [], Dns: [], DnsOptions: [], DnsSearch: [],
+    PidMode: "", UTSMode: "", UsernsMode: "", ContainerIDFile: "", VolumeDriver: "", PortBindings: {}, Binds: [],
+    Tmpfs: { "/tmp": "rw,nosuid,nodev,noexec,size=2147483648,nr_inodes=16384" },
+    Ulimits: [{ Name: "nofile", Soft: 256, Hard: 256 }, { Name: "fsize", Soft: 67108864, Hard: 67108864 }],
+    Mounts: [{ Type: "bind", Source: cfg.stateSource, Target: "/state", ReadOnly: false, BindOptions: { Propagation: "rprivate" } }] };
+  if (cfg.mode === "extra-gpu") (host.DeviceRequests as unknown[]).push({ ...request, DeviceIDs: ["GPU-22222222-2222-2222-2222-222222222222"] });
+  const mounts = [{ Type: "bind", Source: cfg.stateSource, Destination: "/state", RW: true, Propagation: "rprivate" }];
+  if (cfg.mode === "extra-mount") mounts.push({ Type: "bind", Source: cfg.root, Destination: "/run/foreign", RW: true, Propagation: "rprivate" });
+  const value = { Id: cfg.id, Image: image, Name: `/${cfg.containerName}`, State: { Pid: pid, Running: isRunning }, HostConfig: host,
+    Config: { Labels: { "chess-coach.gpu-owner.ownership": token }, User: "1000:1000", OpenStdin: true, Tty: false,
+      Entrypoint: ["/sbin/chess-init"], Cmd: ["-g", "--", "/usr/local/bin/bun", "--no-env-file", "--no-install", "/app/packages/runtime/src/gpu-job.ts", cfg.registration.sessionId],
+      Env: [`NVIDIA_VISIBLE_DEVICES=${cfg.uuid}`, "NVIDIA_DRIVER_CAPABILITIES=compute"], Volumes: {} }, Mounts: mounts };
+  if (cfg.mode.startsWith("storage-") && isRunning && !storageFailed) {
+    renameSync(cfg.packetRoot, cfg.preservedPacket);
+    writeFileSync(cfg.packetRoot, "EVIDENCE_PATH_REPLACED\n", { flag: "wx", mode: 0o600 });
+    put(cfg.evidenceFault, "failed\n");
+    log("evidence-replaced");
+  }
+  log("inspect", { count, image, token, running: isRunning, initPid: pid });
+  return value;
+}
+async function start() {
+  if (!existsSync(cfg.created) || existsSync(cfg.attachPid)) throw new Error("fixture start authority");
+  leaf(process.pid);
+  put(cfg.attachPid, String(process.pid));
+  log("attach-start");
+  if (cfg.mode === "cleanup-attach-overflow") {
+    await Bun.write(Bun.stdout, JSON.stringify({ version: "chess-coach.gpu-job.v1", sessionId: cfg.registration.sessionId, kind: "boot" }) + "\n");
+    const end = Date.now() + 8000;
+    while (!existsSync(cfg.cleanupInspection)) {
+      if (Date.now() >= end) throw new Error("fixture missing cleanup inspection");
+      await delay(2);
+    }
+    await Bun.write(Bun.stderr, "x".repeat(70000));
+    await new Promise(() => { setInterval(() => {}, 1000); });
+    return;
+  }
+  if (cfg.mode === "premature-startup") {
+    const common = { version: "chess-coach.gpu-job.v1", sessionId: cfg.registration.sessionId };
+    await Bun.write(Bun.stdout, JSON.stringify({ ...common, kind: "boot" }) + "\n");
+    const end = Date.now() + 8000;
+    while (!existsSync(join(cfg.packetRoot, "job-start.json"))) {
+      if (Date.now() >= end) throw new Error("fixture missing job-start evidence");
+      await delay(2);
+    }
+    await Bun.write(Bun.stdout, JSON.stringify({ ...common, kind: "startup", attemptId: cfg.registration.attemptId,
+      inputSha256: cfg.inputSha256, descriptorSha256: cfg.registration.expectedDescriptorSha256, initialModelId: cfg.registration.initialModelId }) + "\n");
+    put(cfg.prematureSent, "sent\n");
+    log("premature-startup-sent");
+    await new Promise(() => { setInterval(() => {}, 1000); });
+    return;
+  }
+  const child = Bun.spawn(["/usr/local/bin/bun", "--no-env-file", "--no-install", cfg.registration.driverPath, cfg.registration.sessionId], {
+    cwd: cfg.registration.layout.factory.cwd, stdin: "inherit", stdout: "pipe", stderr: "pipe",
+    env: { LANG: "C", LC_ALL: "C", TZ: "UTC", BUN_RUNTIME_TRANSPILER_CACHE_PATH: "0" } });
+  put(cfg.driverPid, String(child.pid));
+  log("driver-start", { pid: child.pid });
+  const relay = async (stream: ReadableStream<Uint8Array>, path: string, destination: typeof Bun.stdout) => {
+    for await (const bytes of stream) { appendFileSync(path, bytes, { mode: 0o600 }); await Bun.write(destination, bytes); }
+  };
+  const [, , exitCode] = await Promise.all([relay(child.stdout, cfg.driverStdout, Bun.stdout), relay(child.stderr, cfg.driverStderr, Bun.stderr), child.exited]);
+  put(cfg.finished, JSON.stringify({ exitCode, pid: child.pid, stdoutEof: true, stderrEof: true, reaped: true }) + "\n");
+  log("driver-reaped", { exitCode, pid: child.pid });
+  if (cfg.mode === "trailing-stdout") await Bun.write(Bun.stdout, "trailing-after-proposal\n");
+  process.exitCode = cfg.mode === "nonzero-after-proposal" ? 23 : exitCode;
+}
+async function remove() {
+  const pid = attachPid();
+  const end = Date.now() + 1000;
+  while (pid !== 0 && !existsSync(cfg.finished)) {
+    try {
+      const stat = readFileSync(`/proc/${pid}/stat`, "utf8");
+      if (stat.slice(stat.lastIndexOf(")") + 2).startsWith("Z ")) break;
+      process.kill(pid, 0);
+    } catch (error) { if ((error as NodeJS.ErrnoException).code === "ESRCH" || (error as NodeJS.ErrnoException).code === "ENOENT") break; throw error; }
+    if (Date.now() >= end) throw new Error("fixture remove before owned attach stop");
+    await delay(2);
+  }
+  if (pid !== 0 && existsSync(cfg.leaf)) {
+    put(join(cfg.leaf, "cgroup.procs"), "");
+    put(join(cfg.leaf, "cgroup.threads"), "");
+    if (cfg.mode !== "retained-cgroup") {
+      for (const name of ["cpu.max", "memory.max", "memory.swap.max", "pids.max", "cpuset.cpus.effective", "cgroup.procs", "cgroup.threads"]) unlinkSync(join(cfg.leaf, name));
+      rmdirSync(cfg.leaf);
+    }
+    const proc = join(cfg.procRoot, String(pid));
+    unlinkSync(join(proc, "cgroup")); rmdirSync(proc);
+  }
+  put(cfg.removed, "removed\n");
+  log("remove", { id: cfg.id, retained: cfg.mode === "retained-cgroup" });
+  await Bun.write(Bun.stdout, cfg.id + "\n");
+}
+try {
+  const args = Bun.argv.slice(2);
+  requireEqual(args.slice(0, 4), ["--config", cfg.anonymousConfig, "--host", `unix://${cfg.endpoint}`], "prefix");
+  requireEqual(Object.keys(process.env).sort(), ["LANG", "LC_ALL", "TZ"], "clearenv");
+  const [operation, ...rest] = args.slice(4);
+  log("invoke", { operation, args: rest });
+  if (operation === "create") {
+    const expected = ["--pull=never", "--interactive", "--network=none", "--read-only", "--user=1000:1000", "--cpu-period=100000", "--cpu-quota=400000",
+      "--cpuset-cpus=1,2,3,4", "--memory=8589934592", "--memory-swap=8589934592", "--pids-limit=512", "--cap-drop=ALL", "--security-opt=no-new-privileges",
+      "--restart=no", "--ipc=private", "--cgroupns=private", "--log-driver=none", "--ulimit=nofile=256:256", "--ulimit=fsize=67108864:67108864",
+      "--tmpfs=/tmp:rw,nosuid,nodev,noexec,size=2147483648,nr_inodes=16384", "--runtime=nvidia", `--name=${cfg.containerName}`,
+      `--label=chess-coach.gpu-owner.ownership=${cfg.token}`, "--cgroup-parent=synthetic.slice", `--gpus=driver=nvidia,device=${cfg.uuid}`,
+      `--env=NVIDIA_VISIBLE_DEVICES=${cfg.uuid}`, "--env=NVIDIA_DRIVER_CAPABILITIES=compute",
+      `--mount=type=bind,source=${cfg.stateSource},target=/state,bind-propagation=rprivate`, "--entrypoint=/sbin/chess-init", cfg.imageId,
+      "-g", "--", "/usr/local/bin/bun", "--no-env-file", "--no-install", "/app/packages/runtime/src/gpu-job.ts", cfg.registration.sessionId];
+    requireEqual(rest, expected, "create C2/C13");
+    if (!existsSync(cfg.packetRoot) || !readdirSync(cfg.packetRoot).some(name => /started/i.test(name))) throw new Error("fixture STARTED evidence missing before create");
+    writeFileSync(cfg.created, cfg.id + "\n", { flag: "wx", mode: 0o600 });
+    log("create", { id: cfg.id });
+    if (cfg.mode === "state-replaced-after-create") replaceState();
+    await Bun.write(Bun.stdout, cfg.id + "\n");
+  } else if (operation === "start") {
+    requireEqual(rest, ["--attach", "--interactive", cfg.id], "start"); await start();
+  } else if (operation === "inspect") {
+    if (rest[2] !== cfg.id && !(rest[2] === cfg.containerName && existsSync(cfg.created))) throw new Error("fixture inspect authority");
+    requireEqual(rest, ["--type=container", "--format={{json .}}", rest[2]], "inspect");
+    if (["cold-after-queue", "cleanup-attach-overflow"].includes(cfg.mode) && existsSync(join(cfg.packetRoot, "job-start.json"))) {
+      put(cfg.cleanupInspection, "seen\n");
+      await delay(200);
+    }
+    await Bun.write(Bun.stdout, JSON.stringify(inspect()) + "\n");
+  } else if (operation === "rm") {
+    requireEqual(rest, ["--force", cfg.id], "remove"); await remove();
+  } else throw new Error("fixture forbidden manager operation");
+} catch (error) { log("fixture-error", String(error)); await Bun.write(Bun.stderr, String(error) + "\n"); process.exitCode = 91; }
diff --git a/crates/gpu-owner/tests/support/fake-telemetry.ts b/crates/gpu-owner/tests/support/fake-telemetry.ts
new file mode 100644
index 000000000..aaf093ced
--- /dev/null
+++ b/crates/gpu-owner/tests/support/fake-telemetry.ts
@@ -0,0 +1,19 @@
+#!/usr/local/bin/bun --no-env-file
+// SPEC: _spec/gpu-owner.md, _spec/gpu-owner.puml
+import { appendFileSync, existsSync, mkdirSync, renameSync, writeFileSync } from "node:fs";
+
+const cfg = __TRUSTED_FIXTURE_CONFIGURATION__;
+try {
+  const expected = [`--id=${cfg.uuid}`, "--query-gpu=uuid,driver_version,memory.total,memory.used,memory.free", "--format=csv,noheader,nounits"];
+  if (JSON.stringify(Bun.argv.slice(2)) !== JSON.stringify(expected)) throw new Error("fixture telemetry query");
+  if (JSON.stringify(Object.keys(process.env).sort()) !== JSON.stringify(["LANG", "LC_ALL", "TZ"])) throw new Error("fixture telemetry clearenv");
+  appendFileSync(cfg.telemetryEvents, JSON.stringify({ pid: process.pid, args: Bun.argv.slice(2) }) + "\n", { mode: 0o600 });
+  if (cfg.mode === "state-replaced-before-create" && !existsSync(cfg.stateReplaced)) {
+    renameSync(cfg.stateSource, cfg.preservedState);
+    mkdirSync(cfg.stateSource, { mode: 0o700 });
+    writeFileSync(cfg.stateReplaced, "replaced\n", { mode: 0o600 });
+  }
+  if (cfg.mode === "stalled-query") await new Promise(() => { setInterval(() => {}, 1000); });
+  const line = cfg.mode === "malformed-query" ? "malformed\n" : `${cfg.uuid}, 999.0, 1024, 1, ${cfg.mode === "low-query" ? 599 : 900}\n`;
+  await Bun.write(Bun.stdout, line);
+} catch (error) { await Bun.write(Bun.stderr, String(error) + "\n"); process.exitCode = 92; }
diff --git a/crates/gpu-owner/tests/support/mod.rs b/crates/gpu-owner/tests/support/mod.rs
new file mode 100644
index 000000000..4e2d46a2c
--- /dev/null
+++ b/crates/gpu-owner/tests/support/mod.rs
@@ -0,0 +1,507 @@
+// SPEC: _spec/gpu-owner.md, _spec/gpu-owner.puml
+use chess_coach_gpu_owner::{
+    RawLaunchRequest, Report,
+    input::OwnerInput,
+    linux::{Boottime, Clock, LinuxWaiter, Waiter, Watch},
+};
+use rustix::event::PollFlags;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::{
+    cell::Cell,
+    fs::{self, DirBuilder, OpenOptions},
+    io::Write,
+    os::unix::{fs::DirBuilderExt, fs::PermissionsExt, net::UnixListener},
+    path::{Path, PathBuf},
+    process::Command,
+};
+use tempfile::TempDir;
+
+pub const UUID: &str = "GPU-11111111-1111-1111-1111-111111111111";
+const BUN: &str = "/usr/local/bin/bun";
+const DOCKER_SCRIPT: &str = include_str!("fake-docker.ts");
+const TELEMETRY_SCRIPT: &str = include_str!("fake-telemetry.ts");
+
+pub fn sha256(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+fn private_directory(path: &Path) {
+    DirBuilder::new()
+        .recursive(true)
+        .mode(0o700)
+        .create(path)
+        .unwrap();
+    fs::set_permissions(path, fs::Permissions::from_mode(0o700)).unwrap();
+}
+
+fn write_new(path: &Path, bytes: &[u8], mode: u32) {
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(path)
+        .unwrap();
+    file.write_all(bytes).unwrap();
+    file.set_permissions(fs::Permissions::from_mode(mode))
+        .unwrap();
+}
+
+fn file_expectation(path: &Path, bytes: &[u8]) -> Value {
+    json!({"path": path, "byteLength": bytes.len(), "sha256": sha256(bytes)})
+}
+
+fn cgroup(path: &Path, quota: u64, memory: u64, cpus: &str, procs: &str) {
+    private_directory(path);
+    for (name, value) in [
+        ("cpu.max", format!("{quota} 100000\n")),
+        ("memory.max", format!("{memory}\n")),
+        ("memory.swap.max", "0\n".into()),
+        ("pids.max", "512\n".into()),
+        ("cpuset.cpus.effective", format!("{cpus}\n")),
+        ("cgroup.procs", procs.into()),
+        ("cgroup.threads", procs.into()),
+    ] {
+        write_new(&path.join(name), value.as_bytes(), 0o600);
+    }
+}
+
+struct PrivateRoot(Option<TempDir>);
+
+impl Drop for PrivateRoot {
+    fn drop(&mut self) {
+        if std::thread::panicking()
+            && let Some(temp) = self.0.take()
+        {
+            eprintln!("preserved lifecycle fixture: {}", temp.keep().display());
+        }
+    }
+}
+
+pub struct Fixture {
+    _temp: PrivateRoot,
+    _endpoint: UnixListener,
+    pub root: PathBuf,
+    pub registration: Value,
+    pub manifest: Value,
+    pub config: Value,
+}
+
+impl Fixture {
+    pub fn new(mode: &str) -> Self {
+        let repo = Path::new(env!("CARGO_MANIFEST_DIR"))
+            .parent()
+            .unwrap()
+            .parent()
+            .unwrap()
+            .canonicalize()
+            .unwrap();
+        let scratch = repo.join("_work/gpu-owner-recovery/scratch");
+        private_directory(&scratch);
+        let temp = PrivateRoot(Some(
+            tempfile::Builder::new()
+                .prefix("lc-")
+                .tempdir_in(scratch)
+                .unwrap(),
+        ));
+        let root = temp.0.as_ref().unwrap().path().to_owned();
+        fs::set_permissions(&root, fs::Permissions::from_mode(0o700)).unwrap();
+        let bridge = root.join("bridge");
+        private_directory(&bridge);
+        let registration_output = bun_command(&root)
+            .arg(repo.join("packages/runtime/tests/fixtures/gpu-owner/register.ts"))
+            .arg(&bridge)
+            .output()
+            .unwrap();
+        write_new(
+            &root.join("registration.stdout"),
+            &registration_output.stdout,
+            0o600,
+        );
+        write_new(
+            &root.join("registration.stderr"),
+            &registration_output.stderr,
+            0o600,
+        );
+        assert!(
+            registration_output.status.success(),
+            "registration failed at {}: {}",
+            root.display(),
+            String::from_utf8_lossy(&registration_output.stderr)
+        );
+        let registration: Value = serde_json::from_slice(&registration_output.stdout).unwrap();
+        let proc_root = root.join("proc");
+        let cgroup_root = root.join("cgroup");
+        let aggregate = cgroup_root.join("aggregate");
+        let outside = aggregate.join("control");
+        let jobs = aggregate.join("jobs");
+        private_directory(&proc_root.join(std::process::id().to_string()));
+        write_new(
+            &proc_root
+                .join(std::process::id().to_string())
+                .join("cgroup"),
+            b"0::/aggregate/control\n",
+            0o600,
+        );
+        cgroup(&aggregate, 500_000, 12_884_901_888, "0,1,2,3,4", "");
+        cgroup(
+            &outside,
+            100_000,
+            1_073_741_824,
+            "0",
+            &format!("{}\n", std::process::id()),
+        );
+        cgroup(&jobs, 400_000, 8_589_934_592, "1,2,3,4", "");
+        let anonymous_config = root.join("anonymous-config");
+        let state_source = root.join("state-source");
+        private_directory(&anonymous_config);
+        private_directory(&state_source);
+        let endpoint = root.join("s");
+        let listener = UnixListener::bind(&endpoint).unwrap();
+        let unique = sha256(root.as_os_str().as_encoded_bytes());
+        let token = &unique[..32];
+        let image_id = format!("sha256:{}", "a".repeat(64));
+        let mut input_json = registration["inputJson"].as_str().unwrap().to_owned();
+        if mode == "premature-startup" {
+            assert!(input_json.len() < 65_536);
+            input_json.extend(std::iter::repeat_n(' ', 65_536 - input_json.len()));
+        }
+        let input_sha256 = sha256(input_json.as_bytes());
+        let packet_root = root.join("outside-packet");
+        let container_name = format!("chess-coach-synthetic-{}", &unique[..16]);
+        let config = json!({
+            "root": root, "mode": mode, "registration": registration, "imageId": image_id,
+            "uuid": UUID, "token": token, "id": unique, "containerName": container_name,
+            "inputSha256": input_sha256, "anonymousConfig": anonymous_config, "endpoint": endpoint,
+            "stateSource": state_source, "procRoot": proc_root, "leaf": jobs.join("owned"),
+            "preservedState": root.join("preserved-state"), "stateReplaced": root.join("state-replaced"),
+            "cleanupInspection": root.join("cleanup-inspection"),
+            "packetRoot": packet_root, "preservedPacket": root.join("preserved-packet"),
+            "events": root.join("manager.jsonl"), "telemetryEvents": root.join("telemetry.jsonl"),
+            "created": root.join("created"), "attachPid": root.join("attach-pid"),
+            "driverPid": root.join("driver-pid"), "driverStdout": root.join("driver.stdout"),
+            "driverStderr": root.join("driver.stderr"), "finished": root.join("driver-finished.json"),
+            "inspectCount": root.join("inspect-count"), "removed": root.join("removed"),
+            "prematureSent": root.join("premature-sent"), "evidenceFault": root.join("evidence-fault")
+        });
+        let docker_bytes = DOCKER_SCRIPT.replace(
+            "__TRUSTED_FIXTURE_CONFIGURATION__",
+            &serde_json::to_string(&config).unwrap(),
+        );
+        let telemetry_bytes = TELEMETRY_SCRIPT.replace(
+            "__TRUSTED_FIXTURE_CONFIGURATION__",
+            &serde_json::to_string(&config).unwrap(),
+        );
+        let docker_path = root.join("docker.ts");
+        let telemetry_path = root.join("query.ts");
+        write_new(&docker_path, docker_bytes.as_bytes(), 0o700);
+        write_new(&telemetry_path, telemetry_bytes.as_bytes(), 0o700);
+        let envelope = json!({"cpus": [0], "cpuQuota": 100000, "memoryMaxBytes": "1073741824",
+            "aggregateParent": aggregate, "aggregateCpus": [0,1,2,3,4], "aggregateCpuQuota": 500000,
+            "aggregateMemoryMaxBytes": "12884901888"});
+        let admission = json!({"version": "chess-coach.outside-admission.v1", "expectedSelfEnvelope": envelope});
+        let runtime = json!({"version": "chess-coach.gpu-runtime-closure.v1", "imageId": image_id,
+            "selectedUuid": UUID, "profileMode": "legacy-nvidia-device-request.v1", "inputSha256": input_sha256});
+        let telemetry = json!({"version": "chess-coach.telemetry-closure.v1",
+            "executable": {"byteLength": telemetry_bytes.len(), "sha256": sha256(telemetry_bytes.as_bytes())},
+            "expectedDriver": "999.0", "selectedUuid": UUID});
+        let synthetic_library = b"SYNTHETIC_CPU_ONLY_NOT_CUDA";
+        let injection = json!({"version": "chess-coach.gpu-injection.v1", "mode": "legacy", "selectedUuid": UUID,
+            "devices": ["/dev/nvidia0", "/dev/nvidiactl"], "libraries": [{"containerPath": "/usr/lib/libcuda.so.1",
+                "bytes": {"byteLength": synthetic_library.len(), "sha256": sha256(synthetic_library)}}], "inspectMounts": []});
+        let provenance = |name: &str, value: &Value| {
+            let path = root.join(name);
+            let bytes = serde_json::to_vec(value).unwrap();
+            write_new(&path, &bytes, 0o400);
+            file_expectation(&path, &bytes)
+        };
+        let manifest = json!({
+            "version": "chess-coach.gpu-owner.v1",
+            "ownership": {"sessionId": registration["sessionId"], "attemptId": registration["attemptId"],
+                "containerName": container_name, "ownershipToken": token},
+            "outsideControl": {"admissionReceipt": provenance("admission.json", &admission), "expectedSelfEnvelope": envelope},
+            "docker": {"executable": file_expectation(&docker_path, docker_bytes.as_bytes()),
+                "anonymousConfigDirectory": anonymous_config, "endpointUnixSocket": endpoint, "cgroupParentArgument": "synthetic.slice"},
+            "observation": {"procRoot": proc_root, "cgroupRoot": cgroup_root, "approvedJobParentAbsolutePath": jobs,
+                "expectedOutsideControlCgroupAbsolutePath": outside},
+            "job": {"imageId": image_id, "runtimeClosure": provenance("job-runtime.json", &runtime),
+                "gpuProfile": {"mode": "legacy-nvidia-device-request.v1", "cpus": [1,2,3,4],
+                    "injectionInventory": provenance("injection.json", &injection)},
+                "stateHostSource": state_source, "jobInputJson": input_json,
+                "jobInputRef": {"byteLength": input_json.len(), "sha256": input_sha256},
+                "expectedDescriptorSha256": registration["expectedDescriptorSha256"], "initialModelId": registration["initialModelId"]},
+            "cooperative": {"selectedUuid": UUID, "startupMinFreeBytes": "629145600", "runningStopBelowFreeBytes": "209715200",
+                "samplePeriodNs": "2000000000", "maxSampleAgeNs": "3000000000"},
+            "telemetry": {"kind": "registered-nvidia-smi-query.v1", "executable": file_expectation(&telemetry_path, telemetry_bytes.as_bytes()),
+                "runtimeClosure": provenance("telemetry-runtime.json", &telemetry), "expectedDriver": "999.0",
+                "queryBudgetNs": "500000000", "refreshIntervalNs": "500000000", "schedulingReserveNs": "100000000"},
+            "evidence": {"exclusivePacketRoot": packet_root}
+        });
+        let bytes = serde_json::to_vec(&manifest).unwrap();
+        let _ = OwnerInput::parse(&bytes, &sha256(&bytes)).unwrap();
+        Self {
+            _temp: temp,
+            _endpoint: listener,
+            root,
+            registration,
+            manifest,
+            config,
+        }
+    }
+
+    pub fn path(&self, key: &str) -> PathBuf {
+        PathBuf::from(self.config[key].as_str().unwrap())
+    }
+
+    pub fn request(&self) -> RawLaunchRequest {
+        let bytes = serde_json::to_vec(&self.manifest).unwrap();
+        RawLaunchRequest {
+            input_manifest: String::from_utf8(bytes.clone()).unwrap(),
+            expected_manifest_sha256: sha256(&bytes),
+        }
+    }
+
+    pub fn events(&self) -> Vec<Value> {
+        let path = self.path("events");
+        if !path.exists() {
+            return vec![];
+        }
+        fs::read_to_string(path)
+            .unwrap()
+            .lines()
+            .map(|line| serde_json::from_str(line).unwrap())
+            .collect()
+    }
+
+    pub fn frames(&self) -> Vec<Value> {
+        fs::read_to_string(self.path("driverStdout"))
+            .unwrap()
+            .lines()
+            .map(|line| serde_json::from_str(line).unwrap())
+            .collect()
+    }
+
+    pub fn assert_no_fixture_error(&self) {
+        assert!(
+            self.events().iter().all(|e| e["event"] != "fixture-error"),
+            "fixture errors at {}: {:?}",
+            self.root.display(),
+            self.events()
+        );
+    }
+
+    pub fn assert_helper_pids_gone(&self) {
+        for event in self
+            .events()
+            .iter()
+            .filter(|event| event["event"] == "invoke")
+        {
+            assert_pid_gone(event["pid"].as_u64().unwrap() as u32);
+        }
+        let telemetry = self.path("telemetryEvents");
+        if telemetry.exists() {
+            for line in fs::read_to_string(telemetry).unwrap().lines() {
+                let event: Value = serde_json::from_str(line).unwrap();
+                assert_pid_gone(event["pid"].as_u64().unwrap() as u32);
+            }
+        }
+    }
+
+    pub fn assert_no_work(&self) {
+        assert!(!Path::new(self.registration["layout"]["stateRoot"].as_str().unwrap()).exists());
+        assert!(!self.root.join("bridge/learner-a.started.json").exists());
+        assert!(!self.root.join("bridge/learner-b.started.json").exists());
+        assert!(!self.root.join("bridge/match.started.json").exists());
+    }
+
+    pub fn assert_completed(&self) {
+        self.assert_no_fixture_error();
+        let inspector = self.root.join("assert-completed.ts");
+        write_new(&inspector, include_bytes!("assert-completed.ts"), 0o600);
+        let output = bun_command(&self.root)
+            .arg(inspector)
+            .arg(self.registration["layoutPath"].as_str().unwrap())
+            .output()
+            .unwrap();
+        write_new(&self.root.join("sqlite.stdout"), &output.stdout, 0o600);
+        write_new(&self.root.join("sqlite.stderr"), &output.stderr, 0o600);
+        assert!(
+            output.status.success(),
+            "SQLite inspection: {}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        let state: Value = serde_json::from_slice(&output.stdout).unwrap();
+        assert_eq!(
+            state["attempts"],
+            json!([{"id": self.registration["attemptId"], "ordinal": 0, "status": "COMPLETED"}])
+        );
+        assert_eq!(
+            state["masters"],
+            json!([{"master": 101, "pending": null, "status": "active"}])
+        );
+        assert_eq!(state["control"], json!({"aborted": 0}));
+        assert_eq!(
+            state["matchExit"],
+            json!({"stdinClosed": true, "stdoutEof": true, "stderrEof": true, "reaped": true, "exitCode": 0, "forced": false})
+        );
+        assert_eq!(state["learnersClosed"]["kind"], "diagnostic");
+        for name in ["learner-a", "learner-b", "match"] {
+            let receipt = read_json(&self.root.join(format!("bridge/{name}.receipt.json")));
+            assert_eq!(receipt["stdinEof"], true);
+            assert_pid_gone(receipt["pid"].as_u64().unwrap() as u32);
+            if name == "match" {
+                assert_eq!(receipt["scores"], 0);
+                assert_eq!(receipt["scorerClosed"], 1);
+                assert_eq!(receipt["scorerStopped"], 0);
+            } else {
+                assert_eq!(receipt["events"], json!(["begin", "finish", "close"]));
+                let attempt = Path::new(
+                    self.registration["layout"]["factory"]["scratchRoot"]
+                        .as_str()
+                        .unwrap(),
+                )
+                .join(format!(
+                    "attempt-{}",
+                    self.registration["attemptId"].as_str().unwrap()
+                ));
+                assert_eq!(
+                    receipt["configPath"],
+                    attempt.join("config.json").to_str().unwrap()
+                );
+                assert_eq!(
+                    receipt["recordPath"],
+                    attempt.join("model.bpk").to_str().unwrap()
+                );
+            }
+        }
+        assert_eq!(
+            fs::read_dir(
+                self.registration["layout"]["factory"]["scratchRoot"]
+                    .as_str()
+                    .unwrap()
+            )
+            .unwrap()
+            .count(),
+            0
+        );
+        let finished = read_json(&self.path("finished"));
+        assert_eq!(finished["exitCode"], 0);
+        assert_eq!(finished["stdoutEof"], true);
+        assert_eq!(finished["stderrEof"], true);
+        assert_eq!(finished["reaped"], true);
+        assert_pid_gone(finished["pid"].as_u64().unwrap() as u32);
+    }
+
+    pub fn record_report(&self, report: &Report) {
+        write_new(
+            &self.root.join("report.json"),
+            &serde_json::to_vec(report).unwrap(),
+            0o600,
+        );
+    }
+}
+
+fn bun_command(root: &Path) -> Command {
+    let mut command = Command::new(BUN);
+    command
+        .args(["--no-env-file", "--no-install"])
+        .current_dir(root)
+        .env_clear()
+        .env("LANG", "C")
+        .env("LC_ALL", "C")
+        .env("TZ", "UTC")
+        .env("TMPDIR", root)
+        .env("BUN_RUNTIME_TRANSPILER_CACHE_PATH", "0");
+    command
+}
+
+pub fn read_json(path: &Path) -> Value {
+    serde_json::from_slice(&fs::read(path).unwrap()).unwrap()
+}
+
+pub fn assert_pid_gone(pid: u32) {
+    assert!(
+        !Path::new(&format!("/proc/{pid}")).exists(),
+        "owned fixture PID {pid} still exists"
+    );
+}
+
+pub struct OffsetClock {
+    offset: Cell<i64>,
+}
+
+impl OffsetClock {
+    pub fn new() -> Self {
+        Self {
+            offset: Cell::new(0),
+        }
+    }
+}
+
+impl Clock for OffsetClock {
+    fn now_ns(&self) -> chess_coach_gpu_owner::Result<i64> {
+        Ok(Boottime.now_ns()? + self.offset.get())
+    }
+}
+
+pub struct GuardedWaiter<'a> {
+    pub clock: &'a OffsetClock,
+    pub removed: PathBuf,
+    pub premature: Option<PathBuf>,
+    pub advanced_cleanup: bool,
+    pub advanced_startup_guard: bool,
+    first_wait: Option<i64>,
+    real: LinuxWaiter,
+}
+
+impl<'a> GuardedWaiter<'a> {
+    pub fn new(clock: &'a OffsetClock, fixture: &Fixture, premature: bool) -> Self {
+        Self {
+            clock,
+            removed: fixture.path("removed"),
+            premature: premature.then(|| fixture.path("prematureSent")),
+            advanced_cleanup: false,
+            advanced_startup_guard: false,
+            first_wait: None,
+            real: LinuxWaiter,
+        }
+    }
+}
+
+impl Waiter for GuardedWaiter<'_> {
+    fn wait_until(
+        &mut self,
+        deadline: i64,
+        watches: &[Watch<'_>],
+    ) -> chess_coach_gpu_owner::Result<Vec<PollFlags>> {
+        let real_now = Boottime.now_ns()?;
+        let first_wait = *self.first_wait.get_or_insert(real_now);
+        if self.removed.exists() && watches.is_empty() {
+            self.clock
+                .offset
+                .set(self.clock.offset.get() + first_wait + 300_000_000_000 - self.clock.now_ns()?);
+            self.advanced_cleanup = true;
+            return Err(chess_coach_gpu_owner::OwnerError("DEADLINE"));
+        }
+        if self.premature.as_ref().is_some_and(|path| path.exists())
+            && !self.removed.exists()
+            && real_now - first_wait >= 1_000_000_000
+        {
+            self.clock
+                .offset
+                .set(self.clock.offset.get() + first_wait + 297_000_000_000 - self.clock.now_ns()?);
+            self.advanced_startup_guard = true;
+            return Err(chess_coach_gpu_owner::OwnerError("DEADLINE"));
+        }
+        let translated = deadline - self.clock.offset.get();
+        if self.premature.as_ref().is_some_and(|path| path.exists())
+            && translated - real_now > 1_000_000_000
+        {
+            let flags = self.real.wait_until(real_now + 1_000_000_000, watches);
+            if flags.is_err() && Boottime.now_ns()? < translated {
+                return Ok(vec![PollFlags::empty(); watches.len()]);
+            }
+            return flags;
+        }
+        self.real.wait_until(translated, watches)
+    }
+}
diff --git a/crates/gpu-owner/tests/wire.rs b/crates/gpu-owner/tests/wire.rs
new file mode 100644
index 000000000..382fab6a3
--- /dev/null
+++ b/crates/gpu-owner/tests/wire.rs
@@ -0,0 +1,710 @@
+// SPEC: _spec/gpu-owner.md
+use chess_coach_gpu_owner::{
+    input::OwnerInput,
+    json,
+    wire::{self, AttemptInput, Receiver},
+};
+use serde_json::{Value, json};
+
+struct Fixture {
+    input: OwnerInput,
+    embedded: AttemptInput,
+    proposal: Value,
+    descriptor: String,
+}
+fn root(label: &str) -> u32 {
+    u32::from_str_radix(
+        &json::sha256(format!("[\"starchess-training-rng-v1\",101,\"{label}\"]").as_bytes())[..8],
+        16,
+    )
+    .unwrap()
+}
+fn stream(label: &str, draws: u64) -> Value {
+    let root = root(label);
+    let state = ((u128::from(root) + u128::from(draws) * 0x6d2b79f5) & 0xffff_ffff) as u32;
+    json!({"status":if label=="environment-settlement"{"unused"}else{"active"},"root":root,"state":state,"drawCount":draws})
+}
+fn permutation() -> Vec<u32> {
+    let mut state = root("selection");
+    let mut p: Vec<u32> = (0..18).collect();
+    for i in (1..18).rev() {
+        state = state.wrapping_add(0x6d2b79f5);
+        let mut t = state;
+        t = (t ^ (t >> 15)).wrapping_mul(t | 1);
+        t ^= t.wrapping_add((t ^ (t >> 7)).wrapping_mul(t | 61));
+        let n = t ^ (t >> 14);
+        let j = ((u64::from(n) * (i as u64 + 1)) >> 32) as usize;
+        p.swap(i, j);
+    }
+    p
+}
+fn fixture() -> Fixture {
+    let model = json::sha256(b"fixture-model");
+    let reference = json!({"byteLength":1,"sha256":"0".repeat(64)});
+    let mut bindings = json!({});
+    for name in [
+        "source",
+        "tests",
+        "closure",
+        "dependencyLock",
+        "image",
+        "runtimeConfiguration",
+        "coreRules",
+        "strategicSource",
+        "corpusManifest",
+        "corpusSource",
+        "recipe",
+        "featureLayout",
+        "fixtureManifest",
+        "hostConfiguration",
+    ] {
+        bindings[name] = reference.clone();
+    }
+    let p = permutation();
+    let descriptor = json!({"version":"chess-coach.attempt.v1","attemptId":"attempt","master":101,"startedOrdinal":0,"modelId":model,"frozenBaseline":0,"schedule":{"kind":"corpus","corpusIndex":p[0],"candidateSide":"b"}});
+    let descriptor = serde_json::to_string(&descriptor).unwrap();
+    let descriptor_sha = json::sha256(descriptor.as_bytes());
+    let proposal = json!({"version":"chess-coach.gpu-attempt-proposal.v1","descriptor":serde_json::from_str::<Value>(&descriptor).unwrap(),"initialModelId":model,
+        "state":{"version":"chess-coach.training-state.v1","master":101,"initializationSeed":101,"modelId":model,
+            "counters":{"started":1,"verifiedCompleted":1,"eligibleCompleted":0,"updates":0,"nonzeroPGUpdates":0,"baselineCount":0,"baselineSum":0},
+            "rng":{"selection":stream("selection",17),"environment-settlement":stream("environment-settlement",0),"policy-sampling":stream("policy-sampling",0),"opponent":stream("opponent",0),
+                "generator":{"status":"unused","root":null,"state":null,"drawCount":0}},
+            "control":{"corpusPermutation":p,"corpusCursor":1,"corpusEpoch":0,"scheduleCursor":1,"liveOrdinal":0,"dueBucket":0,"fulfilledBucket":0},
+            "journalRef":{"byteLength":1,"sha256":"0".repeat(64),"lastRecordOrdinal":1},"historyRefs":[reference],"bindings":bindings}});
+    let embedded = json!({"version":"chess-coach.gpu-attempt-input.v1","bindings":bindings,"modelConfig":{"version":"chess-coach.model-config.v1","architecture":"mlp-relu-32","featureVersion":"chess-coach.features.v1","inputFeatures":2271,"hiddenUnits":32,"recordSha256":model},
+        "recordRef":{"byteLength":1,"sha256":model},"initialStateSha256":"0".repeat(64),"expectedDescriptorSha256":descriptor_sha,"initialModelId":model});
+    let input_json = serde_json::to_string(&embedded).unwrap();
+    let file = json!({"path":"/fixture/file","byteLength":0,"sha256":"0".repeat(64)});
+    let input:OwnerInput=serde_json::from_str(&serde_json::to_string(&json!({"version":"chess-coach.gpu-owner.v1","ownership":{"sessionId":"session","attemptId":"attempt","containerName":"container","ownershipToken":"0".repeat(32)},
+        "outsideControl":{"admissionReceipt":file,"expectedSelfEnvelope":{"cpus":[0],"cpuQuota":100000,"memoryMaxBytes":"1","aggregateParent":"/fixture/cg/aggregate","aggregateCpus":[0,1,2,3,4],"aggregateCpuQuota":500000,"aggregateMemoryMaxBytes":"24000000000"}},
+        "docker":{"executable":file,"anonymousConfigDirectory":"/fixture/config","endpointUnixSocket":"/fixture/socket","cgroupParentArgument":"fixture.slice"},
+        "observation":{"procRoot":"/fixture/proc","cgroupRoot":"/fixture/cg","approvedJobParentAbsolutePath":"/fixture/cg/aggregate/jobs","expectedOutsideControlCgroupAbsolutePath":"/fixture/cg/aggregate/control"},
+        "job":{"imageId":format!("sha256:{}","0".repeat(64)),"runtimeClosure":file,"gpuProfile":{"mode":"legacy-nvidia-device-request.v1","cpus":[1,2,3,4],"injectionInventory":file},"stateHostSource":"/fixture/state","jobInputJson":input_json,
+            "jobInputRef":{"byteLength":input_json.len(),"sha256":json::sha256(input_json.as_bytes())},"expectedDescriptorSha256":descriptor_sha,"initialModelId":model},
+        "cooperative":{"selectedUuid":"GPU-12345678-1234-1234-1234-123456789abc","startupMinFreeBytes":"1000","runningStopBelowFreeBytes":"500","samplePeriodNs":"1000","maxSampleAgeNs":"2000"},
+        "telemetry":{"kind":"registered-nvidia-smi-query.v1","executable":file,"runtimeClosure":file,"expectedDriver":"fixture","queryBudgetNs":"100","refreshIntervalNs":"100","schedulingReserveNs":"100"},"evidence":{"exclusivePacketRoot":"/fixture/evidence"}})).unwrap()).unwrap();
+    let embedded = AttemptInput::parse(&input).unwrap();
+    Fixture {
+        input,
+        embedded,
+        proposal,
+        descriptor,
+    }
+}
+fn check(f: &Fixture, text: &str) -> chess_coach_gpu_owner::Result<()> {
+    wire::validate_proposal(
+        text,
+        &json::sha256(text.as_bytes()),
+        &f.input.job.expected_descriptor_sha256,
+        &f.input,
+        &f.embedded,
+    )
+}
+fn frame(value: Value) -> Vec<u8> {
+    let mut bytes = serde_json::to_vec(&value).unwrap();
+    bytes.push(b'\n');
+    bytes
+}
+fn boot() -> Vec<u8> {
+    frame(json!({"version":wire::VERSION,"sessionId":"session","kind":"boot"}))
+}
+fn startup(f: &Fixture) -> Vec<u8> {
+    frame(
+        json!({"version":wire::VERSION,"sessionId":"session","kind":"startup","attemptId":"attempt","inputSha256":f.input.job.job_input_ref.sha256,"descriptorSha256":f.input.job.expected_descriptor_sha256,"initialModelId":f.input.job.initial_model_id}),
+    )
+}
+
+#[test]
+fn exact_original_descriptor_token_excludes_only_outer_whitespace() {
+    let f = fixture();
+    let text = serde_json::to_string(&f.proposal).unwrap();
+    check(&f, &text).unwrap();
+    check(&f, &format!(" \n{text}\t")).unwrap();
+    check(
+        &f,
+        &text.replace("\"descriptor\":", "\"\\u0064escriptor\" : \n"),
+    )
+    .unwrap();
+    let pretty = serde_json::to_string_pretty(&f.proposal["descriptor"]).unwrap();
+    let changed = text.replacen(&f.descriptor, &pretty, 1);
+    assert!(check(&f, &changed).is_err());
+    let mut input = f.input.clone();
+    input.job.expected_descriptor_sha256 = json::sha256(pretty.as_bytes());
+    wire::validate_proposal(
+        &changed,
+        &json::sha256(changed.as_bytes()),
+        &input.job.expected_descriptor_sha256,
+        &input,
+        &f.embedded,
+    )
+    .unwrap();
+    let escaped = f.descriptor.replace("\"master\"", "\"\\u006daster\"");
+    assert!(check(&f, &text.replacen(&f.descriptor, &escaped, 1)).is_err());
+}
+
+#[test]
+fn duplicate_decoded_keys_reject_before_raw_token_acceptance() {
+    let f = fixture();
+    let text = serde_json::to_string(&f.proposal).unwrap();
+    let duplicate = text.replace(
+        "\"descriptor\":",
+        &format!("\"\\u0064escriptor\":{},\"descriptor\":", f.descriptor),
+    );
+    assert!(check(&f, &duplicate).is_err());
+    let duplicate = text.replace("\"master\":101", "\"master\":101,\"\\u006daster\":101");
+    assert!(check(&f, &duplicate).is_err());
+    assert!(
+        wire::validate_proposal(
+            &text,
+            &"0".repeat(64),
+            &f.input.job.expected_descriptor_sha256,
+            &f.input,
+            &f.embedded
+        )
+        .is_err()
+    );
+}
+
+#[test]
+fn rejects_complete_state_and_first_attempt_contradictions() {
+    let f = fixture();
+    check(&f, &serde_json::to_string(&f.proposal).unwrap()).unwrap();
+    let mutations = vec![
+        ("/version", json!("wrong")),
+        ("/initialModelId", json!("1".repeat(64))),
+        ("/descriptor/version", json!("wrong")),
+        ("/descriptor/attemptId", json!("other")),
+        ("/descriptor/master", json!(102)),
+        ("/descriptor/startedOrdinal", json!(1)),
+        ("/descriptor/modelId", json!("1".repeat(64))),
+        ("/descriptor/frozenBaseline", json!(2)),
+        ("/descriptor/schedule/kind", json!("live")),
+        ("/descriptor/schedule/candidateSide", json!("w")),
+        ("/descriptor/schedule/corpusIndex", json!(99)),
+        ("/state/version", json!("wrong")),
+        ("/state/master", json!(102)),
+        ("/state/initializationSeed", json!(102)),
+        ("/state/modelId", json!("bad")),
+        ("/state/counters/started", json!(0)),
+        ("/state/counters/started", json!(1001)),
+        ("/state/counters/verifiedCompleted", json!(0)),
+        ("/state/counters/verifiedCompleted", json!(2)),
+        ("/state/counters/eligibleCompleted", json!(1)),
+        ("/state/counters/updates", json!(1)),
+        ("/state/counters/nonzeroPGUpdates", json!(1)),
+        ("/state/counters/baselineCount", json!(1)),
+        ("/state/counters/baselineSum", json!(1)),
+        ("/state/bindings/source/byteLength", json!(-1)),
+        ("/state/control/corpusCursor", json!(19)),
+        ("/state/control/corpusEpoch", json!(1000)),
+        ("/state/control/scheduleCursor", json!(0)),
+        ("/state/control/liveOrdinal", json!(1)),
+        ("/state/control/dueBucket", json!(1)),
+        ("/state/control/fulfilledBucket", json!(1)),
+        ("/state/control/corpusPermutation", json!(vec![0; 18])),
+        ("/state/control/corpusPermutation", json!([0, 1])),
+        ("/state/rng/selection/status", json!("unused")),
+        ("/state/rng/selection/root", json!(0)),
+        ("/state/rng/selection/state", json!(0)),
+        ("/state/rng/selection/drawCount", json!(16)),
+        ("/state/rng/environment-settlement/status", json!("active")),
+        ("/state/rng/environment-settlement/root", json!(0)),
+        ("/state/rng/environment-settlement/state", json!(0)),
+        ("/state/rng/environment-settlement/drawCount", json!(1)),
+        ("/state/rng/policy-sampling/status", json!("unused")),
+        ("/state/rng/policy-sampling/root", json!(0)),
+        ("/state/rng/policy-sampling/state", json!(0)),
+        ("/state/rng/policy-sampling/drawCount", json!(1)),
+        ("/state/rng/opponent/status", json!("unused")),
+        ("/state/rng/opponent/root", json!(0)),
+        ("/state/rng/opponent/state", json!(0)),
+        ("/state/rng/opponent/drawCount", json!(1)),
+        ("/state/rng/generator/status", json!("active")),
+        ("/state/rng/generator/root", json!(0)),
+        ("/state/rng/generator/state", json!(0)),
+        ("/state/rng/generator/drawCount", json!(1)),
+        ("/state/journalRef", json!(false)),
+        ("/state/journalRef/byteLength", json!(-1)),
+        ("/state/journalRef/lastRecordOrdinal", json!(-1)),
+        ("/state/journalRef/sha256", json!("bad")),
+        ("/state/historyRefs", json!([])),
+        ("/state/historyRefs/0/byteLength", json!(-1)),
+        ("/state/historyRefs/0/sha256", json!("bad")),
+        ("/state/bindings/source/sha256", json!("1".repeat(64))),
+    ];
+    assert_eq!(mutations.len(), 61);
+    for (index, (pointer, value)) in mutations.into_iter().enumerate() {
+        let mut candidate = f.proposal.clone();
+        *candidate.pointer_mut(pointer).unwrap() = value;
+        let text = serde_json::to_string(&candidate).unwrap();
+        let mut input = f.input.clone();
+        input.job.expected_descriptor_sha256 = json::sha256(
+            serde_json::to_string(&candidate["descriptor"])
+                .unwrap()
+                .as_bytes(),
+        );
+        assert!(
+            wire::validate_proposal(
+                &text,
+                &json::sha256(text.as_bytes()),
+                &input.job.expected_descriptor_sha256,
+                &input,
+                &f.embedded
+            )
+            .is_err(),
+            "mutation {index}: {pointer}"
+        );
+    }
+}
