{
  "name": "chess-coach",
  "private": true,
  "scripts": {
    "dev": "nx run-many -t dev,storybook --projects=ui,starchess --parallel=4",
    "e2e:web-no-llm": "npm test --prefix apps/e2e",
    "e2e:desktop": "echo 'TODO: desktop e2e tests'",
    "e2e:docker": "docker compose run --rm e2e",
    "e2e:docker:build": "docker compose build e2e",
    "e2e:nerd-mode": "CI=1 E2E_TARGET=web-no-llm npm test --prefix apps/e2e -- --project=chromium tests/nerd-mode.spec.ts",
    "deploy:web-no-llm": "npm run deploy --prefix apps/ui",
    "deploy:desktop": "echo 'TODO: desktop deployment'",
    "build:starchess": "pnpm --filter @chess-coach/starchess build",
    "test:starchess": "pnpm --filter @chess-coach/starchess test",
    "preview:starchess": "pnpm --filter @chess-coach/starchess preview",
    "deploy:starchess:dry-run": "pnpm --filter @chess-coach/starchess deploy:dry-run",
    "e2e:starchess": "E2E_TARGET=starchess npm test --prefix apps/e2e -- --project=chromium"
  },
  "devDependencies": {
    "nx": "^21.6.11"
  }
}
