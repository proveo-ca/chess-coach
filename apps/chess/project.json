{
  "name": "chess",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/chess/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev:web-no-llm:vite",
        "cwd": "apps/chess"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run storybook -- --ci",
        "cwd": "apps/chess"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker compose run --build --rm e2e-chess",
        "cwd": "."
      }
    }
  },
  "tags": ["type:app", "scope:chess"]
}
