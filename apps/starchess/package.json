{
  "name": "@chess-coach/starchess",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint": "oxlint -c oxlint.config.ts",
    "storybook": "storybook dev -p 6007 --ci",
