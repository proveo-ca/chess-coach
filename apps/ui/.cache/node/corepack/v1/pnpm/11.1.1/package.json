{
  "name": "pnpm",
  "version": "11.1.1",
  "description": "Fast, disk space efficient package manager",
  "keywords": [
    "dependencies",
    "dependency manager",
    "efficient",
    "fast",
    "hardlinks",
    "install",
    "installer",
    "link",
    "lockfile",
    "modules",
    "monorepo",
    "multi-package",
    "npm",
    "package manager",
    "package.json",
    "packages",
    "pnpm",
    "pnpm11",
    "prune",
    "rapid",
    "remove",
    "shrinkwrap",
    "symlinks",
    "uninstall",
    "workspace"
  ],
  "homepage": "https://pnpm.io",
  "bugs": {
    "url": "https://github.com/pnpm/pnpm/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pnpm/pnpm.git",
    "directory": "pnpm"
  },
  "funding": "https://opencollective.com/pnpm",
  "bin": {
    "pn": "bin/pnpm.mjs",
    "pnpm": "bin/pnpm.mjs",
    "pnpx": "bin/pnpx.mjs",
    "pnx": "bin/pnpx.mjs"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "bin"
  ],
  "type": "module",
  "main": "bin/pnpm.mjs",
  "unpkg": "dist/pnpm.mjs",
  "exports": {
    ".": "./package.json"
  },
  "publishConfig": {
    "executableFiles": [
      "./dist/node-gyp-bin/node-gyp",
      "./dist/node-gyp-bin/node-gyp.cmd",
      "./dist/node_modules/node-gyp/bin/node-gyp.js"
    ],
    "tag": "next-11"
  },
  "scripts": {
    "bundle": "pnx node@runtime:24.6.0 bundle.ts",
    "start": "tsgo --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "pretest:e2e": "rimraf node_modules/.bin/pnpm",
    "test": "pn compile && pn .test",
    "compile": "tsgo --build && pn lint --fix && rimraf dist bin/nodes && pn bundle && shx cp -r node-gyp-bin dist/node-gyp-bin && shx cp -r node_modules/@pnpm/tabtab/lib/templates dist/templates && shx cp -r node_modules/ps-list/vendor dist/vendor && shx cp pnpmrc dist/pnpmrc",
    ".test": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules --disable-warning=ExperimentalWarning --disable-warning=DEP0169\" jest"
  },
  "jest": {
    "preset": "@pnpm/jest-config/with-registry"
  },
  "preferGlobal": true,
  "engines": {
    "node": ">=22.13"
  }
}
